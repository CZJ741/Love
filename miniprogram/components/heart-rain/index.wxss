.hr-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 999;
  overflow: hidden;
}
.hr-heart {
  position: absolute;
  top: -80rpx;
  animation: hrFall linear forwards;
  opacity: 0;
}
@keyframes hrFall {
  0% {
    transform: translateY(0) rotate(0deg) scale(0.8);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  100% {
    transform: translateY(110vh) rotate(40deg) scale(1.15);
    opacity: 0.9;
  }
}

/* 惩罚闪电掉落与急坠特效 */
.hr-bolt {
  animation-name: boltFall;
  animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  filter: drop-shadow(0 0 8rpx rgba(255, 193, 7, 0.6));
}
@keyframes boltFall {
  0% {
    transform: translateY(0) rotate(-15deg) scale(0.7);
    opacity: 0;
  }
  15% {
    opacity: 1;
    transform: translateY(15vh) rotate(10deg) scale(1.1);
  }
  85% {
    opacity: 0.95;
  }
  100% {
    transform: translateY(115vh) rotate(-20deg) scale(0.9);
    opacity: 0;
  }
}
