<view wx:if="{{hearts.length}}" class="hr-mask {{type === 'punish' ? 'hr-punish' : ''}}">
  <view
    wx:for="{{hearts}}"
    wx:key="id"
    class="hr-heart {{type === 'punish' ? 'hr-bolt' : ''}}"
    style="left:{{item.left}};font-size:{{item.size}};animation-delay:{{item.delay}};animation-duration:{{item.dur}};"
  >{{item.emoji}}</view>
</view>
