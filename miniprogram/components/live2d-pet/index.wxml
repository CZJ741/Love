<!-- 支持四大形态：蛋(egg) → 幼崽(baby) → 成长期(youth) → 完全体(adult) -->
<view class="pet-wrapper {{compactMode ? 'compact' : ''}}" catchtap="onPetTap">
  <!-- 顶部对话气泡（仅点击宠物时短暂出现） -->
  <view wx:if="{{bubbleText}}" class="pet-bubble {{bubbleAnim ? 'bubble-pop' : ''}}">
    <text class="bubble-content">{{bubbleText}}</text>
    <view class="bubble-arrow"></view>
  </view>

  <!-- ================= 阶段一：萌宠蛋 (egg) ================= -->
  <view wx:if="{{pet.stage === 'egg'}}" class="live2d-egg action-{{actionState}} idle-{{idleIndex}} {{isTapped ? 'egg-wobble' : ''}}">
    <!-- 蛋壳微光光晕 -->
    <view class="egg-halo"></view>
    <view class="egg-shadow"></view>
    <!-- 蛋本体 -->
    <view class="egg-shell">
      <view class="egg-spot spot-1"></view>
      <view class="egg-spot spot-2"></view>
      <view class="egg-heart-pattern">💖</view>
      <!-- 裂纹暗示破壳成长 -->
      <view wx:if="{{pet.exp >= pet.maxExp * 0.7}}" class="egg-crack crack-1"></view>
      <view wx:if="{{pet.exp >= pet.maxExp * 0.9}}" class="egg-crack crack-2"></view>
    </view>
  </view>

  <!-- ================= 阶段二至四：幼崽(baby)、成长期(youth)、完全体(adult) ================= -->
  <view wx:else class="live2d-dog stage-{{pet.stage || 'baby'}} action-{{actionState}} {{(actionState === 'normal' || actionState === 'expectant') && pet.health >= 60 && !isTapped ? 'idle-' + idleIndex : ''}} {{pet.health < 60 ? 'is-sick' : ''}} {{isBlinking ? 'blinking' : ''}} {{isTapped ? 'petted' : ''}}">
    <!-- 情绪与微动效粒子 -->
    <view wx:if="{{showHeartFx}}" class="fx-heart fx-1">💖</view>
    <view wx:if="{{showHeartFx}}" class="fx-heart fx-2">✨</view>
    <view wx:if="{{showBubbleFx}}" class="fx-bubble-wrap">
      <view class="bubble-p b-1">🫧</view>
      <view class="bubble-p b-2">🫧</view>
    </view>
    <view wx:if="{{showFoodFx}}" class="fx-food-crumb">🍪</view>
    <view wx:if="{{pet.health < 60}}" class="fx-sick-headband">🩹</view>
    <view wx:if="{{showSweatFx || pet.health < 60}}" class="fx-sweat">💧</view>
    <view wx:if="{{showZzzFx}}" class="fx-zzz">zZ</view>

    <!-- 睡眠时可爱小盖被 -->
    <view wx:if="{{actionState === 'sleepy' || showZzzFx}}" class="dog-quilt">
      <text class="quilt-pattern">⭐</text>
    </view>

    <!-- 身体阴影 -->
    <view class="dog-shadow"></view>

    <!-- 尾巴骨骼 -->
    <view class="dog-tail-wrap">
      <view class="dog-tail"></view>
    </view>

    <!-- 身体层 -->
    <view class="dog-body">
      <view class="dog-belly"></view>
      <view class="dog-chest"></view>
    </view>

    <!-- 前爪爪 -->
    <view class="dog-haunch haunch-left"><view class="toe toe-one"></view><view class="toe toe-two"></view><view class="toe toe-three"></view><view class="paw-pad"></view></view>
    <view class="dog-haunch haunch-right"><view class="toe toe-one"></view><view class="toe toe-two"></view><view class="toe toe-three"></view><view class="paw-pad"></view></view>
    <view class="dog-paws">
      <view class="paw paw-left"></view>
      <view class="paw paw-right"></view>
    </view>

    <!-- 头部层 -->
    <view class="dog-head-wrap">
      <view class="dog-ear ear-left"><view class="ear-inner"></view><view class="ear-fold"></view></view>
      <view class="dog-ear ear-right"><view class="ear-inner"></view><view class="ear-fold"></view></view>

      <view class="fur-edge fur-edge-left"></view>
      <view class="fur-edge fur-edge-left-low"></view>
      <view class="fur-edge fur-edge-right"></view>
      <view class="fur-edge fur-edge-right-low"></view>
      <view class="head-tuft"></view>
      <view class="dog-head">
        <view class="face-blaze"></view>
        <view class="face-cheek cheek-left"></view>
        <view class="face-cheek cheek-right"></view>
        <view class="face-brow brow-left"></view>
        <view class="face-brow brow-right"></view>

        <!-- 眼神系统 -->
        <view class="dog-eyes">
          <view class="eye eye-left"></view>
          <view class="eye eye-right"></view>
          <view class="eye-happy-crescent crescent-left"></view>
          <view class="eye-happy-crescent crescent-right"></view>
        </view>

        <!-- 脸颊腮红 -->
        <view class="dog-blush blush-left"></view>
        <view class="dog-blush blush-right"></view>

        <!-- 鼻子 -->
        <view class="dog-nose"></view>

        <!-- 嘴巴与舌头 -->
        <view class="dog-mouth">
          <view class="mouth-lip"></view>
          <view class="dog-tongue"></view>
        </view>
      </view>
    </view>
  </view>
</view>
