/* Live2D 唯美可爱小狗双人桌宠样式系统 */
.pet-wrapper {
  position: relative;
  width: 100%;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  pointer-events: auto;
  z-index: 10;
}
.pet-wrapper.compact {
  height: 130rpx;
}

/* 顶部对话气泡：严禁遮挡宠物头部，放置在小狗侧上方并自然外扬 */
.pet-bubble {
  position: absolute;
  bottom: 140rpx; /* 抬升至小狗头顶安全高度之外，彻底杜绝遮挡头部与眼睛 */
  right: 10rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid #FFCDD2;
  border-radius: 20rpx 20rpx 4rpx 20rpx; /* 灵动对话气泡角 */
  padding: 10rpx 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(244, 143, 177, 0.28);
  backdrop-filter: blur(8px);
  z-index: 50;
  max-width: 360rpx;
  text-align: center;
  pointer-events: none;
  white-space: nowrap;
}
.pet-wrapper.compact .pet-bubble {
  bottom: 130rpx;
  right: 0rpx;
}
.bubble-content {
  font-size: 21rpx;
  font-weight: 700;
  color: #D81B60;
  line-height: 1.3;
}
.bubble-arrow {
  position: absolute;
  bottom: -10rpx;
  right: 30rpx; /* 气泡箭头自然指向小狗头侧 */
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #FFCDD2;
}
.bubble-pop {
  animation: bubblePopAnim 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}
@keyframes bubblePopAnim {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 顶部微型状态药丸 */
.pet-stats-pill {
  position: absolute;
  top: 10rpx;
  left: 20rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1.5rpx solid #FFE0B2;
  border-radius: 24rpx;
  padding: 6rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(191, 166, 154, 0.15);
  backdrop-filter: blur(4px);
  z-index: 15;
}
.pet-level-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #E65100;
}
.pet-stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.psi-icon {
  font-size: 18rpx;
  line-height: 1;
}
.psi-bar {
  width: 44rpx;
  height: 8rpx;
  background: #EEEEEE;
  border-radius: 4rpx;
  overflow: hidden;
}
.psi-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}
.psi-fill.hunger {
  background: linear-gradient(90deg, #FFB74D, #FFA726);
}
.psi-fill.mood {
  background: linear-gradient(90deg, #F48FB1, #E91E63);
}
.psi-fill.health {
  background: linear-gradient(90deg, #81C784, #4CAF50);
}
.pet-stage-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #D81B60;
  background: #FFF0F3;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

/* ================= 阶段一：萌宠蛋 (Live2D Egg) ================= */
.live2d-egg {
  position: relative;
  width: 120rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  cursor: pointer;
  transform-origin: bottom center;
}
.egg-halo {
  position: absolute;
  top: 10rpx;
  width: 100rpx;
  height: 120rpx;
  border-radius: 50% 50% 45% 45%;
  background: radial-gradient(circle, rgba(255, 224, 178, 0.6) 0%, rgba(255, 255, 255, 0) 70%);
  filter: blur(4rpx);
  animation: eggGlow 2.5s infinite alternate;
}
@keyframes eggGlow {
  0% { transform: scale(0.95); opacity: 0.4; }
  100% { transform: scale(1.1); opacity: 0.9; }
}
.egg-shadow {
  position: absolute;
  bottom: -4rpx;
  width: 80rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(141, 110, 99, 0.18);
  filter: blur(2rpx);
}
.egg-shell {
  position: relative;
  width: 88rpx;
  height: 112rpx;
  background: radial-gradient(circle at 35% 30%, #FFFFFF 0%, #FFF3E0 50%, #FFE0B2 100%);
  border-radius: 50% 50% 45% 45%;
  border: 3rpx solid #FFB74D;
  box-shadow: 0 4rpx 14rpx rgba(255, 167, 38, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  animation: eggBreathe 3s ease-in-out infinite alternate;
}
@keyframes eggBreathe {
  0% { transform: translateY(0) scale(1, 1); }
  100% { transform: translateY(-4rpx) scale(0.98, 1.02); }
}
.egg-wobble {
  animation: eggWobbleAnim 0.4s ease-in-out;
}
@keyframes eggWobbleAnim {
  0% { transform: rotate(0); }
  25% { transform: rotate(-12deg); }
  50% { transform: rotate(12deg); }
  75% { transform: rotate(-6deg); }
  100% { transform: rotate(0); }
}
.egg-spot {
  position: absolute;
  border-radius: 50%;
  background: #FFCC80;
  opacity: 0.6;
}
.spot-1 { width: 22rpx; height: 16rpx; top: 24rpx; left: 14rpx; }
.spot-2 { width: 16rpx; height: 22rpx; bottom: 20rpx; right: 14rpx; }
.egg-heart-pattern {
  font-size: 26rpx;
  opacity: 0.85;
}
.egg-crack {
  position: absolute;
  width: 2rpx;
  background: #E65100;
}
.crack-1 { height: 24rpx; top: 18rpx; right: 28rpx; transform: rotate(25deg); }
.crack-2 { height: 32rpx; bottom: 22rpx; left: 24rpx; transform: rotate(-35deg); }

/* ================= 阶段二至四差异化外观特征 ================= */
/* 幼崽期：更小更萌，带可爱小围嘴 */
.stage-baby {
  transform: scale(0.85);
}
.baby-bib {
  position: absolute;
  top: 4rpx;
  width: 44rpx;
  height: 24rpx;
  background: #FFEB3B;
  border: 2rpx solid #FBC02D;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 成长期：标准体型，带红项圈与金铃铛 */
.stage-youth {
  transform: scale(1);
}

/* 完全体：威风霸气又甜美，带闪亮小披风 */
.stage-adult {
  transform: scale(1.15);
}
.adult-cape {
  position: absolute;
  top: -2rpx;
  width: 100%;
  height: 14rpx;
  background: linear-gradient(90deg, #AB47BC, #7E57C2);
  border-radius: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.adult-star {
  font-size: 16rpx;
  line-height: 1;
}

/* 病态/虚弱状态表现（健康度 < 60 时触发） */
.is-sick {
  filter: grayscale(35%) brightness(0.92);
}
.is-sick .dog-head-wrap {
  animation: sickTremble 0.6s infinite alternate !important;
}
@keyframes sickTremble {
  0% { transform: translateY(4rpx) rotate(-2deg); }
  100% { transform: translateY(6rpx) rotate(2deg); }
}
.fx-sick-headband {
  position: absolute;
  top: -12rpx;
  left: 20rpx;
  font-size: 26rpx;
  z-index: 35;
}

/* ================= Live2D 小狗骨骼核心渲染 ================= */
.live2d-dog {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  cursor: pointer;
  transform-origin: bottom center;
}

/* 特效动画 */
.fx-heart {
  position: absolute;
  font-size: 32rpx;
  pointer-events: none;
  z-index: 30;
  animation: floatHeart 1.2s ease-out forwards;
}
.fx-1 { top: -20rpx; left: 10rpx; }
.fx-2 { top: -35rpx; right: 10rpx; animation-delay: 0.2s; }
@keyframes floatHeart {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  50% { transform: translateY(-20rpx) scale(1.2); opacity: 1; }
  100% { transform: translateY(-40rpx) scale(0.8); opacity: 0; }
}

.fx-sweat {
  position: absolute;
  top: 10rpx;
  right: -10rpx;
  font-size: 26rpx;
  z-index: 30;
  animation: sweatAnim 1.5s infinite;
}
@keyframes sweatAnim {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6rpx); }
}

.fx-zzz {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #7E57C2;
  z-index: 30;
  animation: zzzAnim 2s infinite ease-out;
}
@keyframes zzzAnim {
  0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
  50% { transform: translate(12rpx, -16rpx) scale(1); opacity: 1; }
  100% { transform: translate(24rpx, -32rpx) scale(1.2); opacity: 0; }
}

/* 身体阴影 */
.dog-shadow {
  position: absolute;
  bottom: -4rpx;
  width: 90rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(141, 110, 99, 0.18);
  filter: blur(2rpx);
}

/* 尾巴骨骼与左右摇摆 */
.dog-tail-wrap {
  position: absolute;
  bottom: 22rpx;
  left: 20rpx;
  transform-origin: right bottom;
  z-index: 1;
}
.dog-tail {
  width: 22rpx;
  height: 40rpx;
  background: #E8B98A;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  transform: rotate(-35deg);
  box-shadow: inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.05);
}

/* 身体 */
.dog-body {
  position: relative;
  width: 80rpx;
  height: 60rpx;
  background: #FFF9F3;
  border-radius: 36rpx 36rpx 28rpx 28rpx;
  border: 3rpx solid #D69C65;
  box-shadow: inset 0 -6rpx 12rpx rgba(214, 156, 101, 0.2);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.dog-belly {
  width: 50rpx;
  height: 40rpx;
  background: #FFFFFF;
  border-radius: 50%;
  position: absolute;
  bottom: -4rpx;
}
/* 项圈与铃铛 */
.dog-collar {
  position: absolute;
  top: 0;
  width: 100%;
  height: 10rpx;
  background: #FF5252;
  border-radius: 4rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.dog-bell {
  width: 14rpx;
  height: 14rpx;
  background: #FFD54F;
  border: 1.5rpx solid #FFA000;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(255, 160, 0, 0.4);
}

/* 前爪 */
.dog-paws {
  position: absolute;
  bottom: 0;
  width: 76rpx;
  display: flex;
  justify-content: space-between;
  z-index: 4;
}
.paw {
  width: 24rpx;
  height: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #D69C65;
  border-radius: 12rpx 12rpx 8rpx 8rpx;
}

/* 头部层（Live2D 骨骼主要表现层） */
.dog-head-wrap {
  position: absolute;
  top: 0;
  width: 110rpx;
  height: 95rpx;
  display: flex;
  justify-content: center;
  z-index: 5;
  transform-origin: bottom center;
}

/* 耳朵 */
.dog-ear {
  position: absolute;
  top: -4rpx;
  width: 32rpx;
  height: 52rpx;
  background: #D69C65;
  border-radius: 16rpx 16rpx 20rpx 20rpx;
  z-index: 1;
  transition: transform 0.2s ease;
}
.ear-left {
  left: 2rpx;
  transform-origin: top right;
  transform: rotate(-15deg);
}
.ear-right {
  right: 2rpx;
  transform-origin: top left;
  transform: rotate(15deg);
}

/* 脑袋本体 */
.dog-head {
  position: relative;
  width: 100rpx;
  height: 86rpx;
  background: #FFF9F3;
  border: 3rpx solid #D69C65;
  border-radius: 50rpx 50rpx 44rpx 44rpx;
  box-shadow: inset 0 -4rpx 10rpx rgba(214, 156, 101, 0.15);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

/* 头顶焦糖斑纹特征 */
.dog-patch {
  position: absolute;
  top: -2rpx;
  right: 12rpx;
  width: 38rpx;
  height: 38rpx;
  background: #E8B98A;
  border-radius: 50%;
  z-index: 1;
}

/* 眉毛 */
.dog-eyebrows {
  position: absolute;
  top: 20rpx;
  width: 70rpx;
  display: flex;
  justify-content: space-between;
  z-index: 3;
}
.eyebrow {
  width: 12rpx;
  height: 4rpx;
  background: #9E7449;
  border-radius: 2rpx;
  transition: all 0.2s ease;
}

/* 眼睛与眼神系统 */
.dog-eyes {
  position: absolute;
  top: 30rpx;
  width: 66rpx;
  display: flex;
  justify-content: space-between;
  z-index: 3;
}
.eye {
  position: relative;
  width: 16rpx;
  height: 18rpx;
  background: #3E2723;
  border-radius: 50%;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  transition: all 0.15s ease;
}
.eye-shine {
  width: 6rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 50%;
  margin-top: 2rpx;
  margin-right: 2rpx;
}
/* 开心眯眼月牙笑容（隐藏/显示切换） */
.eye-happy-crescent {
  display: none;
  width: 18rpx;
  height: 10rpx;
  border: 4rpx solid #3E2723;
  border-color: transparent transparent #3E2723 transparent;
  border-radius: 0 0 50% 50%;
}

/* 腮红 */
.dog-blush {
  position: absolute;
  top: 44rpx;
  width: 18rpx;
  height: 10rpx;
  background: #FF8A80;
  border-radius: 50%;
  opacity: 0.6;
  z-index: 3;
}
.blush-left { left: 8rpx; }
.blush-right { right: 8rpx; }

/* 鼻子 */
.dog-nose {
  position: absolute;
  top: 42rpx;
  width: 14rpx;
  height: 10rpx;
  background: #3E2723;
  border-radius: 6rpx 6rpx 8rpx 8rpx;
  z-index: 4;
}

/* 嘴巴与舌头 */
.dog-mouth {
  position: absolute;
  top: 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 4;
}
.mouth-lip {
  width: 22rpx;
  height: 8rpx;
  border: 3rpx solid #8D6E63;
  border-color: transparent transparent #8D6E63 transparent;
  border-radius: 0 0 50% 50%;
}
.dog-tongue {
  width: 12rpx;
  height: 14rpx;
  background: #FF5252;
  border-radius: 0 0 8rpx 8rpx;
  margin-top: -3rpx;
  display: none;
  animation: tonguePant 0.4s infinite alternate;
}
@keyframes tonguePant {
  0% { transform: scaleY(0.9); }
  100% { transform: scaleY(1.15); }
}

/* ================= 4套自然循环待机骨骼动作 ================= */
/* 循环动作0：平缓温馨呼吸 */
.live2d-dog.idle-0 .dog-head-wrap {
  animation: breatheMotion 2.4s ease-in-out infinite alternate;
}
.live2d-dog.idle-0 .dog-tail {
  animation: wagSoft 1.8s ease-in-out infinite alternate;
}
@keyframes breatheMotion {
  0% { transform: translateY(0) rotate(0deg); }
  100% { transform: translateY(-4rpx) rotate(1deg); }
}
@keyframes wagSoft {
  0% { transform: rotate(-25deg); }
  100% { transform: rotate(-45deg); }
}

/* 循环动作1：欢快摇尾晃脑 */
.live2d-dog.idle-1 .dog-head-wrap {
  animation: headBob 1.6s ease-in-out infinite alternate;
}
.live2d-dog.idle-1 .dog-tail {
  animation: wagFast 0.5s ease-in-out infinite alternate;
}
@keyframes headBob {
  0% { transform: translateY(0) rotate(-3deg); }
  100% { transform: translateY(-6rpx) rotate(3deg); }
}
@keyframes wagFast {
  0% { transform: rotate(-15deg); }
  100% { transform: rotate(-55deg); }
}

/* 循环动作2：好奇歪头杀 */
.live2d-dog.idle-2 .dog-head-wrap {
  animation: headTilt 2.8s ease-in-out infinite alternate;
}
.live2d-dog.idle-2 .ear-left {
  animation: earTwitch 2.8s ease-in-out infinite alternate;
}
@keyframes headTilt {
  0% { transform: rotate(-8deg); }
  50% { transform: rotate(0deg); }
  100% { transform: rotate(8deg); }
}
@keyframes earTwitch {
  0%, 80% { transform: rotate(-15deg); }
  90% { transform: rotate(-5deg); }
  100% { transform: rotate(-20deg); }
}

/* 循环动作3：坐立小踏步 */
.live2d-dog.idle-3 .dog-body {
  animation: bodyStep 1.4s ease-in-out infinite alternate;
}
.live2d-dog.idle-3 .paw-left {
  animation: pawStepL 0.7s infinite alternate;
}
.live2d-dog.idle-3 .paw-right {
  animation: pawStepR 0.7s infinite alternate 0.35s;
}
@keyframes bodyStep {
  0% { transform: translateY(0); }
  100% { transform: translateY(-3rpx); }
}
@keyframes pawStepL {
  0% { transform: translateY(0); }
  100% { transform: translateY(-4rpx); }
}
@keyframes pawStepR {
  0% { transform: translateY(0); }
  100% { transform: translateY(-4rpx); }
}

/* 眨眼表现 */
.live2d-dog.blinking .eye {
  transform: scaleY(0.1);
}

/* 点击反馈即时弹跳 */
.live2d-dog.petted {
  animation: petBounce 0.4s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}
@keyframes petBounce {
  0% { transform: scale(1); }
  40% { transform: scale(1.18) translateY(-14rpx); }
  100% { transform: scale(1); }
}

/* ================= 6大基础表情与情绪状态系统 ================= */

/* 1. 开心满足 (happy) - 喂食、被夸、高心情 */
.action-happy .eye { display: none; }
.action-happy .eye-happy-crescent { display: block; }
.action-happy .dog-tongue { display: block; }
.action-happy .dog-tail { animation: wagFast 0.35s infinite alternate !important; }
.action-happy .ear-left { transform: rotate(-25deg); }
.action-happy .ear-right { transform: rotate(25deg); }

/* 2. 委屈难过 (sad) - 饥饿、被冷落 */
.action-sad .dog-head-wrap { transform: translateY(6rpx) rotate(-3deg); }
.action-sad .eyebrow { transform: rotate(-25deg); }
.action-sad .eyebrow.eb-right { transform: rotate(25deg); }
.action-sad .ear-left { transform: rotate(5deg); }
.action-sad .ear-right { transform: rotate(-5deg); }
.action-sad .dog-tail { transform: rotate(-10deg) !important; animation: none !important; }
.action-sad .mouth-lip { border-color: #8D6E63 transparent transparent transparent; border-radius: 50% 50% 0 0; }

/* 3. 惊喜兴奋 (surprise) - 收到礼物、暴击互动 */
.action-surprise .eye { width: 22rpx; height: 22rpx; }
.action-surprise .ear-left { transform: rotate(-35deg) translateY(-6rpx); }
.action-surprise .ear-right { transform: rotate(35deg) translateY(-6rpx); }
.action-surprise .dog-tail { animation: wagFast 0.25s infinite alternate !important; }
.action-surprise .dog-mouth { transform: scale(1.2); }

/* 4. 平静待机 (normal) - 默认日常状态 */
.action-normal .dog-head-wrap { transform: rotate(0); }

/* 5. 撒娇期待 (expectant) - 等待摸摸互动 */
.action-expectant .dog-head-wrap { transform: rotate(-10deg); }
.action-expectant .dog-tongue { display: block; }
.action-expectant .eye-shine { width: 8rpx; height: 8rpx; }
.action-expectant .dog-tail { animation: wagFast 0.4s infinite alternate !important; }

/* 6. 困倦疲惫 (sleepy) - 深夜或体力低 */
.action-sleepy .eye { transform: scaleY(0.15); }
.action-sleepy .dog-head-wrap { transform: translateY(8rpx) rotate(4deg); }
.action-sleepy .ear-left { transform: rotate(0deg); }
.action-sleepy .ear-right { transform: rotate(0deg); }
.action-sleepy .dog-tail { animation: wagSoft 3s infinite alternate !important; }
