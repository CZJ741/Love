/* Live2D 唯美可爱小狗双人桌宠样式系统 */
.pet-wrapper {
  position: relative;
  width: 100%;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  pointer-events: auto;
  z-index: 10;
}
.pet-wrapper.compact {
  height: 130rpx;
}

/* 顶部对话气泡：严禁遮挡宠物头部，放置在小狗侧上方并自然外扬 */
.pet-bubble {
  position: absolute;
  bottom: 140rpx; /* 抬升至小狗头顶安全高度之外，彻底杜绝遮挡头部与眼睛 */
  right: 10rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid #FFCDD2;
  border-radius: 20rpx 20rpx 4rpx 20rpx; /* 灵动对话气泡角 */
  padding: 10rpx 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(244, 143, 177, 0.28);
  backdrop-filter: blur(8px);
  z-index: 50;
  max-width: 360rpx;
  text-align: center;
  pointer-events: none;
  white-space: nowrap;
}
.pet-wrapper.compact .pet-bubble {
  bottom: 130rpx;
  right: 0rpx;
}
.bubble-content {
  font-size: 21rpx;
  font-weight: 700;
  color: #D81B60;
  line-height: 1.3;
}
.bubble-arrow {
  position: absolute;
  bottom: -10rpx;
  right: 30rpx; /* 气泡箭头自然指向小狗头侧 */
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #FFCDD2;
}
.bubble-pop {
  animation: bubblePopAnim 0.3s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}
@keyframes bubblePopAnim {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 顶部微型状态药丸 */
.pet-stats-pill {
  position: absolute;
  top: 10rpx;
  left: 20rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1.5rpx solid #FFE0B2;
  border-radius: 24rpx;
  padding: 6rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(191, 166, 154, 0.15);
  backdrop-filter: blur(4px);
  z-index: 15;
}
.pet-level-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #E65100;
}
.pet-stat-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.psi-icon {
  font-size: 18rpx;
  line-height: 1;
}
.psi-bar {
  width: 44rpx;
  height: 8rpx;
  background: #EEEEEE;
  border-radius: 4rpx;
  overflow: hidden;
}
.psi-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}
.psi-fill.hunger {
  background: linear-gradient(90deg, #FFB74D, #FFA726);
}
.psi-fill.mood {
  background: linear-gradient(90deg, #F48FB1, #E91E63);
}
.psi-fill.health {
  background: linear-gradient(90deg, #81C784, #4CAF50);
}
.pet-stage-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #D81B60;
  background: #FFF0F3;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

/* ================= 阶段一：萌宠蛋 (Live2D Egg) ================= */
.live2d-egg {
  position: relative;
  width: 120rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  cursor: pointer;
  transform-origin: bottom center;
}
.egg-halo {
  position: absolute;
  top: 10rpx;
  width: 100rpx;
  height: 120rpx;
  border-radius: 50% 50% 45% 45%;
  background: radial-gradient(circle, rgba(255, 224, 178, 0.6) 0%, rgba(255, 255, 255, 0) 70%);
  filter: blur(4rpx);
  animation: eggGlow 2.5s infinite alternate;
}
@keyframes eggGlow {
  0% { transform: scale(0.95); opacity: 0.4; }
  100% { transform: scale(1.1); opacity: 0.9; }
}
.egg-shadow {
  position: absolute;
  bottom: -4rpx;
  width: 80rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(141, 110, 99, 0.18);
  filter: blur(2rpx);
}
.egg-shell {
  position: relative;
  width: 88rpx;
  height: 112rpx;
  background: radial-gradient(circle at 35% 30%, #FFFFFF 0%, #FFF3E0 50%, #FFE0B2 100%);
  border-radius: 50% 50% 45% 45%;
  border: 3rpx solid #FFB74D;
  box-shadow: 0 4rpx 14rpx rgba(255, 167, 38, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  animation: eggBreathe 3s ease-in-out infinite alternate;
}
@keyframes eggBreathe {
  0% { transform: translateY(0) scale(1, 1); }
  100% { transform: translateY(-4rpx) scale(0.98, 1.02); }
}
.egg-wobble {
  animation: eggWobbleAnim 0.4s ease-in-out;
}
@keyframes eggWobbleAnim {
  0% { transform: rotate(0); }
  25% { transform: rotate(-12deg); }
  50% { transform: rotate(12deg); }
  75% { transform: rotate(-6deg); }
  100% { transform: rotate(0); }
}
.egg-spot {
  position: absolute;
  border-radius: 50%;
  background: #FFCC80;
  opacity: 0.6;
}
.spot-1 { width: 22rpx; height: 16rpx; top: 24rpx; left: 14rpx; }
.spot-2 { width: 16rpx; height: 22rpx; bottom: 20rpx; right: 14rpx; }
.egg-heart-pattern {
  font-size: 26rpx;
  opacity: 0.85;
}
.egg-crack {
  position: absolute;
  width: 2rpx;
  background: #E65100;
}
.crack-1 { height: 24rpx; top: 18rpx; right: 28rpx; transform: rotate(25deg); }
.crack-2 { height: 32rpx; bottom: 22rpx; left: 24rpx; transform: rotate(-35deg); }

/* ================= 阶段二至四差异化外观特征深度优化 ================= */
/* 幼崽期 (baby)：奶萌娇小，大眼睛萌芽胎毛与可爱小奶嘴围兜 */
.stage-baby {
  transform: scale(0.8);
}
.baby-sprout {
  position: absolute;
  top: -18rpx;
  font-size: 24rpx;
  z-index: 10;
  animation: sproutSway 2s ease-in-out infinite alternate;
}
@keyframes sproutSway {
  0% { transform: rotate(-10deg); }
  100% { transform: rotate(10deg); }
}
.baby-bib {
  position: absolute;
  top: 4rpx;
  width: 48rpx;
  height: 28rpx;
  background: #FFF9C4;
  border: 2rpx solid #FBC02D;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(251, 192, 45, 0.25);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 8;
}
.bib-deco {
  font-size: 16rpx;
  line-height: 1;
}

/* 成长期 (youth)：少年元气柯基柴犬，阳光红蓝项圈与可爱斜挎小书包 */
.stage-youth {
  transform: scale(1);
}
.youth-adorn {
  width: 100%;
  height: 100%;
  position: relative;
}
.youth-bag {
  position: absolute;
  right: 2rpx;
  bottom: 8rpx;
  z-index: 8;
}
.bag-icon {
  font-size: 20rpx;
}

/* 完全体 (adult)：尊贵荣耀又治愈，微风轻拂小羽翼与金黄王冠 */
.stage-adult {
  transform: scale(1.18);
}
.adult-crown {
  position: absolute;
  top: -24rpx;
  font-size: 28rpx;
  z-index: 12;
  filter: drop-shadow(0 2rpx 6rpx rgba(255, 179, 0, 0.4));
  animation: crownFloat 2s ease-in-out infinite alternate;
}
@keyframes crownFloat {
  0% { transform: translateY(0); }
  100% { transform: translateY(-4rpx); }
}
.adult-adorn {
  width: 100%;
  height: 100%;
  position: relative;
}
.adult-cape {
  position: absolute;
  top: -2rpx;
  width: 100%;
  height: 14rpx;
  background: linear-gradient(90deg, #BA68C8, #7E57C2);
  border-radius: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(126, 87, 194, 0.35);
  z-index: 8;
}
.adult-star {
  font-size: 16rpx;
  line-height: 1;
}
.adult-wing {
  position: absolute;
  top: 6rpx;
  width: 22rpx;
  height: 30rpx;
  background: radial-gradient(circle, #FFFFFF 60%, #E1F5FE 100%);
  border: 1.5rpx solid #B3E5FC;
  border-radius: 50% 50% 20% 20%;
  box-shadow: 0 2rpx 6rpx rgba(179, 229, 252, 0.6);
  z-index: 1;
}
.wing-left {
  left: -12rpx;
  transform: rotate(-30deg);
  animation: wingFlapLeft 1.2s ease-in-out infinite alternate;
}
.wing-right {
  right: -12rpx;
  transform: rotate(30deg);
  animation: wingFlapRight 1.2s ease-in-out infinite alternate;
}
@keyframes wingFlapLeft {
  0% { transform: rotate(-25deg); }
  100% { transform: rotate(-40deg) translateY(-2rpx); }
}
@keyframes wingFlapRight {
  0% { transform: rotate(25deg); }
  100% { transform: rotate(40deg) translateY(-2rpx); }
}

/* 病态/虚弱状态表现（健康度 < 60 时触发） */
.is-sick {
  filter: grayscale(35%) brightness(0.92);
}
.is-sick .dog-head-wrap {
  animation: sickTremble 0.6s infinite alternate !important;
}
@keyframes sickTremble {
  0% { transform: translateY(4rpx) rotate(-2deg); }
  100% { transform: translateY(6rpx) rotate(2deg); }
}
.fx-sick-headband {
  position: absolute;
  top: -12rpx;
  left: 20rpx;
  font-size: 26rpx;
  z-index: 35;
}

/* ================= Live2D 小狗骨骼核心渲染 ================= */
.live2d-dog {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  cursor: pointer;
  transform-origin: bottom center;
}

/* 特效动画 */
.fx-heart {
  position: absolute;
  font-size: 32rpx;
  pointer-events: none;
  z-index: 30;
  animation: floatHeart 1.2s ease-out forwards;
}
.fx-1 { top: -20rpx; left: 10rpx; }
.fx-2 { top: -35rpx; right: 10rpx; animation-delay: 0.2s; }
@keyframes floatHeart {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  50% { transform: translateY(-20rpx) scale(1.2); opacity: 1; }
  100% { transform: translateY(-40rpx) scale(0.8); opacity: 0; }
}

/* 泡泡微动效 (洗澡) */
.fx-bubble-wrap {
  position: absolute;
  top: -10rpx;
  left: 0;
  right: 0;
  pointer-events: none;
  z-index: 30;
}
.bubble-p {
  position: absolute;
  font-size: 28rpx;
  animation: floatBubble 1.4s ease-out infinite;
}
.b-1 { left: 10rpx; top: -10rpx; }
.b-2 { right: 10rpx; top: -25rpx; animation-delay: 0.4s; }
@keyframes floatBubble {
  0% { transform: translateY(0) scale(0.6); opacity: 0; }
  50% { transform: translateY(-16rpx) scale(1.1); opacity: 0.9; }
  100% { transform: translateY(-35rpx) scale(0.8); opacity: 0; }
}

/* 食物微动效 (投喂) */
.fx-food-crumb {
  position: absolute;
  top: 10rpx;
  left: 20rpx;
  font-size: 30rpx;
  z-index: 30;
  animation: foodHop 0.8s ease-out forwards;
}
@keyframes foodHop {
  0% { transform: translateY(-20rpx) scale(1.2); opacity: 1; }
  70% { transform: translateY(10rpx) scale(1); opacity: 0.9; }
  100% { transform: translateY(15rpx) scale(0.4); opacity: 0; }
}

/* 睡觉时小被子 */
.dog-quilt {
  position: absolute;
  bottom: 0;
  left: 6rpx;
  right: 6rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FFF9C4, #FFF59D);
  border: 2rpx solid #FBC02D;
  border-radius: 16rpx 16rpx 10rpx 10rpx;
  z-index: 25;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 8rpx rgba(251, 192, 45, 0.2);
}
.quilt-pattern {
  font-size: 20rpx;
  opacity: 0.7;
}

.fx-sweat {
  position: absolute;
  top: 10rpx;
  right: -10rpx;
  font-size: 26rpx;
  z-index: 30;
  animation: sweatAnim 1.5s infinite;
}
@keyframes sweatAnim {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6rpx); }
}

.fx-zzz {
  position: absolute;
  top: -10rpx;
  right: -8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #7E57C2;
  z-index: 30;
  animation: zzzAnim 2s infinite ease-out;
}
@keyframes zzzAnim {
  0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
  50% { transform: translate(12rpx, -16rpx) scale(1); opacity: 1; }
  100% { transform: translate(24rpx, -32rpx) scale(1.2); opacity: 0; }
}

/* 身体阴影 */
.dog-shadow {
  position: absolute;
  bottom: -4rpx;
  width: 90rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(141, 110, 99, 0.18);
  filter: blur(2rpx);
}

/* 尾巴骨骼与左右摇摆 */
.dog-tail-wrap {
  position: absolute;
  bottom: 22rpx;
  left: 20rpx;
  transform-origin: right bottom;
  z-index: 1;
}
.dog-tail {
  width: 22rpx;
  height: 40rpx;
  background: #E8B98A;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  transform: rotate(-35deg);
  box-shadow: inset -2rpx -2rpx 0 rgba(0, 0, 0, 0.05);
}

/* 身体 */
.dog-body {
  position: relative;
  width: 80rpx;
  height: 60rpx;
  background: #FFF9F3;
  border-radius: 36rpx 36rpx 28rpx 28rpx;
  border: 3rpx solid #D69C65;
  box-shadow: inset 0 -6rpx 12rpx rgba(214, 156, 101, 0.2);
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.dog-belly {
  width: 50rpx;
  height: 40rpx;
  background: #FFFFFF;
  border-radius: 50%;
  position: absolute;
  bottom: -4rpx;
}
/* 项圈与铃铛 */
.dog-collar {
  position: absolute;
  top: 0;
  width: 100%;
  height: 10rpx;
  background: #FF5252;
  border-radius: 4rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.dog-bell {
  width: 14rpx;
  height: 14rpx;
  background: #FFD54F;
  border: 1.5rpx solid #FFA000;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(255, 160, 0, 0.4);
}

/* 前爪 */
.dog-paws {
  position: absolute;
  bottom: 0;
  width: 76rpx;
  display: flex;
  justify-content: space-between;
  z-index: 4;
}
.paw {
  width: 24rpx;
  height: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #D69C65;
  border-radius: 12rpx 12rpx 8rpx 8rpx;
}

/* 头部层（Live2D 骨骼主要表现层） */
.dog-head-wrap {
  position: absolute;
  top: 0;
  width: 110rpx;
  height: 95rpx;
  display: flex;
  justify-content: center;
  z-index: 5;
  transform-origin: bottom center;
}

/* 耳朵 */
.dog-ear {
  position: absolute;
  top: -4rpx;
  width: 32rpx;
  height: 52rpx;
  background: #D69C65;
  border-radius: 16rpx 16rpx 20rpx 20rpx;
  z-index: 1;
  transition: transform 0.2s ease;
}
.ear-left {
  left: 2rpx;
  transform-origin: top right;
  transform: rotate(-15deg);
}
.ear-right {
  right: 2rpx;
  transform-origin: top left;
  transform: rotate(15deg);
}

/* 脑袋本体 */
.dog-head {
  position: relative;
  width: 100rpx;
  height: 86rpx;
  background: #FFF9F3;
  border: 3rpx solid #D69C65;
  border-radius: 50rpx 50rpx 44rpx 44rpx;
  box-shadow: inset 0 -4rpx 10rpx rgba(214, 156, 101, 0.15);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

/* 头顶焦糖斑纹特征 */
.dog-patch {
  position: absolute;
  top: -2rpx;
  right: 12rpx;
  width: 38rpx;
  height: 38rpx;
  background: #E8B98A;
  border-radius: 50%;
  z-index: 1;
}

/* 眉毛 */
.dog-eyebrows {
  position: absolute;
  top: 20rpx;
  width: 70rpx;
  display: flex;
  justify-content: space-between;
  z-index: 3;
}
.eyebrow {
  width: 12rpx;
  height: 4rpx;
  background: #9E7449;
  border-radius: 2rpx;
  transition: all 0.2s ease;
}

/* ================= 阶段差异化微表情与细节 ================= */
/* 幼崽期：眼睛更大更水汪汪，腮红更粉扑扑 */
.stage-baby .eye {
  width: 18rpx;
  height: 20rpx;
}
.stage-baby .eye-shine {
  width: 8rpx;
  height: 8rpx;
}
.stage-baby .dog-blush {
  width: 22rpx;
  height: 12rpx;
  background: #FF5252;
  opacity: 0.7;
}

/* 成长期：阳光机灵，耳朵更挺拔，尾巴更欢快 */
.stage-youth .dog-ear {
  transform: rotate(-10deg);
}
.stage-youth .ear-right {
  transform: rotate(10deg);
}

/* 完全体：眼神深邃灵动，披风与微光羽翼，体态华丽尊贵 */
.stage-adult .dog-head {
  border-color: #C28549;
  box-shadow: 0 4rpx 14rpx rgba(186, 104, 200, 0.18), inset 0 -4rpx 10rpx rgba(214, 156, 101, 0.2);
}
.stage-adult .dog-eyes {
  top: 28rpx;
}
.stage-adult .dog-body {
  border-color: #C28549;
}

/* 眼睛与眼神系统 */
.dog-eyes {
  position: absolute;
  top: 30rpx;
  width: 66rpx;
  display: flex;
  justify-content: space-between;
  z-index: 3;
}
.eye {
  position: relative;
  width: 16rpx;
  height: 18rpx;
  background: #3E2723;
  border-radius: 50%;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  transition: all 0.15s ease;
}
.eye-shine {
  width: 6rpx;
  height: 6rpx;
  background: #FFFFFF;
  border-radius: 50%;
  margin-top: 2rpx;
  margin-right: 2rpx;
}
/* 开心眯眼月牙笑容（隐藏/显示切换） */
.eye-happy-crescent {
  display: none;
  width: 18rpx;
  height: 10rpx;
  border: 4rpx solid #3E2723;
  border-color: transparent transparent #3E2723 transparent;
  border-radius: 0 0 50% 50%;
}

/* 腮红 */
.dog-blush {
  position: absolute;
  top: 44rpx;
  width: 18rpx;
  height: 10rpx;
  background: #FF8A80;
  border-radius: 50%;
  opacity: 0.6;
  z-index: 3;
}
.blush-left { left: 8rpx; }
.blush-right { right: 8rpx; }

/* 鼻子 */
.dog-nose {
  position: absolute;
  top: 42rpx;
  width: 14rpx;
  height: 10rpx;
  background: #3E2723;
  border-radius: 6rpx 6rpx 8rpx 8rpx;
  z-index: 4;
}

/* 嘴巴与舌头 */
.dog-mouth {
  position: absolute;
  top: 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 4;
}
.mouth-lip {
  width: 22rpx;
  height: 8rpx;
  border: 3rpx solid #8D6E63;
  border-color: transparent transparent #8D6E63 transparent;
  border-radius: 0 0 50% 50%;
}
.dog-tongue {
  width: 12rpx;
  height: 14rpx;
  background: #FF5252;
  border-radius: 0 0 8rpx 8rpx;
  margin-top: -3rpx;
  display: none;
  animation: tonguePant 0.4s infinite alternate;
}
@keyframes tonguePant {
  0% { transform: scaleY(0.9); }
  100% { transform: scaleY(1.15); }
}

/* ================= 三套自然循环待机骨骼动作与表情 ================= */
/* 动作一：安静呼吸。眼神放松，身体随呼吸轻轻起伏。 */
.live2d-dog.idle-0 .dog-head-wrap {
  animation: idleBreathHead 2.8s ease-in-out infinite;
}
.live2d-dog.idle-0 .dog-body {
  animation: idleBreathBody 2.8s ease-in-out infinite;
}
.live2d-dog.idle-0 .dog-tail {
  animation: idleBreathTail 2.4s ease-in-out infinite alternate;
}
.live2d-dog.idle-0 .dog-eyes {
  opacity: 0.82;
}
.live2d-dog.idle-0 .mouth-lip {
  width: 14rpx;
  height: 5rpx;
  background: transparent;
  border: 0;
  border-bottom: 2rpx solid #695057;
  border-radius: 0 0 50% 50%;
}
.live2d-dog.idle-0 .dog-tongue {
  display: none;
}
@keyframes idleBreathHead {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-3rpx) rotate(1deg); }
}
@keyframes idleBreathBody {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-2rpx) scale(1.015, 0.99); }
}
@keyframes idleBreathTail {
  0% { transform: rotate(-28deg); }
  100% { transform: rotate(-40deg); }
}

/* 动作二：好奇歪头。眼睛放大、眉毛抬起，单耳随着倾听轻抖。 */
.live2d-dog.idle-1 .dog-head-wrap {
  animation: idleCuriousTilt 3.2s ease-in-out infinite;
}
.live2d-dog.idle-1 .dog-eyes {
  animation: idleCuriousEyes 3.2s ease-in-out infinite;
}
.live2d-dog.idle-1 .eye {
  transform: scale(1.12);
}
.live2d-dog.idle-1 .face-brow {
  transform: translateY(-2rpx) rotate(0deg);
}
.live2d-dog.idle-1 .mouth-lip {
  width: 7rpx;
  height: 8rpx;
  border: 0;
  border-radius: 50%;
  background: #695057;
}
.live2d-dog.idle-1 .dog-tongue {
  display: none;
}
.live2d-dog.idle-1 .ear-left {
  animation: idleCuriousEar 3.2s ease-in-out infinite;
}
.live2d-dog.idle-1 .dog-tail {
  animation: idleCuriousTail 3.2s ease-in-out infinite;
}
@keyframes idleCuriousTilt {
  0%, 20%, 100% { transform: rotate(0deg); }
  42%, 63% { transform: rotate(-9deg); }
  82% { transform: rotate(2deg); }
}
@keyframes idleCuriousEyes {
  0%, 20%, 100% { transform: translateX(0); }
  42%, 63% { transform: translateX(-2rpx); }
  82% { transform: translateX(1rpx); }
}
@keyframes idleCuriousEar {
  0%, 32%, 100% { transform: rotate(-17deg); }
  45% { transform: rotate(-5deg); }
  55% { transform: rotate(-21deg); }
}
@keyframes idleCuriousTail {
  0%, 30%, 100% { transform: rotate(-28deg); }
  48% { transform: rotate(-18deg); }
  65% { transform: rotate(-30deg); }
}

/* 动作三：开心摇尾。月牙眼、微笑与左右摆尾形成一组完整表情。 */
.live2d-dog.idle-2 .dog-head-wrap {
  animation: idleHappyBob 1.8s ease-in-out infinite;
}
.live2d-dog.idle-2 .dog-tail {
  animation: idleHappyTail 0.48s ease-in-out infinite alternate;
}
.live2d-dog.idle-2 .ear-left {
  animation: idleHappyEarLeft 1.8s ease-in-out infinite;
}
.live2d-dog.idle-2 .ear-right {
  animation: idleHappyEarRight 1.8s ease-in-out infinite;
}
.live2d-dog.idle-2 .eye {
  display: none;
}
.live2d-dog.idle-2 .eye-happy-crescent {
  display: block;
  animation: idleHappyEyes 1.8s ease-in-out infinite alternate;
}
.live2d-dog.idle-2 .dog-tongue {
  display: block;
}
@keyframes idleHappyBob {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-5rpx) rotate(2deg); }
}
@keyframes idleHappyTail {
  0% { transform: rotate(-14deg); }
  100% { transform: rotate(-52deg); }
}
@keyframes idleHappyEarLeft {
  0%, 100% { transform: rotate(-24deg); }
  50% { transform: rotate(-14deg); }
}
@keyframes idleHappyEarRight {
  0%, 100% { transform: rotate(24deg); }
  50% { transform: rotate(14deg); }
}
@keyframes idleHappyEyes {
  0% { transform: scale(0.9); }
  100% { transform: scale(1.08); }
}


/* 眨眼表现 */
.live2d-dog.blinking .eye {
  transform: scaleY(0.1);
}

/* 点击反馈即时弹跳 */
.live2d-dog.petted {
  animation: petBounce 0.4s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}
@keyframes petBounce {
  0% { transform: scale(1); }
  40% { transform: scale(1.18) translateY(-14rpx); }
  100% { transform: scale(1); }
}

/* ================= 6大基础表情与情绪状态系统 ================= */

/* 1. 开心满足 (happy) - 喂食、被夸、高心情 */
.action-happy .eye { display: none; }
.action-happy .eye-happy-crescent { display: block; }
.action-happy .dog-tongue { display: block; }
.action-happy .dog-tail { animation: wagFast 0.35s infinite alternate !important; }
.action-happy .ear-left { transform: rotate(-25deg); }
.action-happy .ear-right { transform: rotate(25deg); }

/* 2. 委屈难过 (sad) - 饥饿、被冷落 */
.action-sad .dog-head-wrap { transform: translateY(6rpx) rotate(-3deg); }
.action-sad .eyebrow { transform: rotate(-25deg); }
.action-sad .eyebrow.eb-right { transform: rotate(25deg); }
.action-sad .ear-left { transform: rotate(5deg); }
.action-sad .ear-right { transform: rotate(-5deg); }
.action-sad .dog-tail { transform: rotate(-10deg) !important; animation: none !important; }
.action-sad .mouth-lip { border-color: #8D6E63 transparent transparent transparent; border-radius: 50% 50% 0 0; }

/* 3. 惊喜兴奋 (surprise) - 收到礼物、暴击互动 */
.action-surprise .eye { width: 22rpx; height: 22rpx; }
.action-surprise .ear-left { transform: rotate(-35deg) translateY(-6rpx); }
.action-surprise .ear-right { transform: rotate(35deg) translateY(-6rpx); }
.action-surprise .dog-tail { animation: wagFast 0.25s infinite alternate !important; }
.action-surprise .dog-mouth { transform: scale(1.2); }

/* 4. 平静待机 (normal) - 默认日常状态 */
.action-normal .dog-head-wrap { transform: rotate(0); }

/* 5. 撒娇期待 (expectant) - 等待摸摸互动 */
.action-expectant .dog-head-wrap { transform: rotate(-10deg); }
.action-expectant .dog-tongue { display: block; }
.action-expectant .eye-shine { width: 8rpx; height: 8rpx; }
.action-expectant .dog-tail { animation: wagFast 0.4s infinite alternate !important; }

/* 6. 困倦疲惫 (sleepy) - 深夜或体力低 */
.action-sleepy .eye { transform: scaleY(0.15); }
.action-sleepy .dog-head-wrap { transform: translateY(8rpx) rotate(4deg); }
.action-sleepy .ear-left { transform: rotate(0deg); }
.action-sleepy .ear-right { transform: rotate(0deg); }
.action-sleepy .dog-tail { animation: wagSoft 3s infinite alternate !important; }
/* Reference redesign: a grey-and-white, folded-ear chibi puppy. */
.live2d-dog { width: 168rpx; height: 150rpx; flex-shrink: 0; }
.live2d-egg { flex-shrink: 0; }
.live2d-dog.stage-baby { transform: scale(0.94); }
.live2d-dog.stage-youth { transform: scale(1); }
.live2d-dog.stage-adult { transform: scale(1.06); }
.dog-head-wrap { top: 17rpx; width: 162rpx; height: 100rpx; }
.live2d-dog .dog-head {
  width: 144rpx; height: 100rpx; box-sizing: border-box;
  border: 0; border-radius: 43% 43% 46% 46%;
  /* Blend all white markings on one surface to avoid overlapping patch edges. */
  background:
    radial-gradient(ellipse 46rpx 34rpx at 46rpx 81rpx, #f8f7f3 0%, #f8f7f3 42%, rgba(248,247,243,0.78) 65%, rgba(248,247,243,0) 100%),
    radial-gradient(ellipse 46rpx 34rpx at 98rpx 81rpx, #f8f7f3 0%, #f8f7f3 42%, rgba(248,247,243,0.78) 65%, rgba(248,247,243,0) 100%),
    radial-gradient(ellipse 37rpx 83rpx at 72rpx 11rpx, #f8f7f3 0%, #f8f7f3 36%, rgba(248,247,243,0.72) 62%, rgba(248,247,243,0) 100%),
    #b7b5b5;
  box-shadow: none;
}
.face-blaze {
  position: absolute; top: -9rpx; left: 43rpx; width: 55rpx; height: 83rpx;
  background: #f8f7f3; border-radius: 45% 45% 36% 36%; transform: rotate(-3deg); z-index: 1;
}
.face-cheek { position: absolute; bottom: -6rpx; width: 88rpx; height: 52rpx; background: #f8f7f3; border-radius: 50%; z-index: 1; }
.cheek-left { left: 4rpx; transform: rotate(-10deg); }
.cheek-right { right: 4rpx; transform: rotate(10deg); }
/* The head background now owns the markings and their soft transitions. */
.face-blaze, .face-cheek { display: none; }
.face-brow { position: absolute; top: 40rpx; width: 11rpx; height: 4rpx; background: #969395; border-radius: 50%; z-index: 2; }
.brow-left { left: 43rpx; transform: rotate(-8deg); }
.brow-right { right: 43rpx; transform: rotate(8deg); }
.head-tuft { position: absolute; top: -5rpx; left: 69rpx; width: 22rpx; height: 17rpx; background: #f8f7f3; border-radius: 85% 15% 0 0; transform: rotate(-16deg); z-index: 3; }
.live2d-dog .dog-ear {
  top: -12rpx; width: 43rpx; height: 44rpx; box-sizing: border-box;
  border: 0; border-radius: 24% 60% 35% 35%;
  background: #b7b5b5; box-shadow: none; z-index: 1; overflow: hidden;
}
.live2d-dog .ear-left { left: 8rpx; transform: rotate(-17deg); }
.live2d-dog .ear-right { right: 8rpx; transform: rotate(17deg); border-radius: 60% 24% 35% 35%; }
.ear-inner { position: absolute; bottom: 1rpx; left: 10rpx; width: 20rpx; height: 27rpx; background: #e4bbb0; border: 4rpx solid #eeece7; border-radius: 45% 55% 25% 25%; box-sizing: border-box; }
.ear-fold { position: absolute; top: -3rpx; left: -2rpx; width: 45rpx; height: 19rpx; background: #5c5a60; border-radius: 30% 55% 65% 15%; transform: rotate(-10deg); }
.ear-right .ear-fold { transform: rotate(10deg); border-radius: 55% 30% 15% 65%; }
.live2d-dog .dog-eyes { top: 51rpx; width: 35rpx; height: 11rpx; align-items: center; }
.live2d-dog .eye { width: 8rpx; height: 10rpx; border: 0; border-radius: 50%; background: #343137; box-shadow: none; }
.live2d-dog .dog-blush { top: 66rpx; width: 10rpx; height: 5rpx; background: #e5b9b3; opacity: 0.6; }
.blush-left { left: 41rpx; }
.blush-right { right: 41rpx; }
.dog-nose { top: 63rpx; width: 13rpx; height: 9rpx; background: #4a464a; border-radius: 40% 40% 60% 60%; }
.dog-mouth { top: 76rpx; width: 19rpx; height: 13rpx; }
.mouth-lip { width: 18rpx; height: 7rpx; border: 0; border-radius: 25% 25% 50% 50%; background: #695057; }
.dog-tongue { display: block; width: 11rpx; height: 10rpx; margin-top: -5rpx; background: #df939a; border: 0; border-radius: 15% 15% 60% 60%; animation: none; }
.live2d-dog .dog-body { width: 68rpx; height: 60rpx; box-sizing: border-box; border: 0; background: radial-gradient(ellipse 32rpx 55rpx at 50% 30%, #e9e7e2 0%, #d2d0cd 58%, #b7b5b5 100%); border-radius: 42% 42% 30% 30%; box-shadow: none; overflow: hidden; }
.dog-belly { display: none; }
.dog-chest { position: absolute; top: -2rpx; left: 9rpx; width: 47rpx; height: 55rpx; background: radial-gradient(ellipse at 50% 28%, #f8f7f3 0%, #f8f7f3 35%, rgba(248,247,243,0.75) 63%, rgba(248,247,243,0) 100%); border-radius: 20% 20% 48% 48%; }
.dog-haunch { position: absolute; bottom: 1rpx; width: 28rpx; height: 34rpx; background: radial-gradient(ellipse at 50% 45%, #f8f7f3 18%, #eeece8 62%, #d6d3cf 100%); border: 0; border-radius: 50% 50% 42% 42%; z-index: 3; }
.haunch-left { left: 36rpx; transform: rotate(-18deg); }
.haunch-right { right: 36rpx; transform: rotate(18deg); }
.paw-pad { position: absolute; left: 7rpx; bottom: 6rpx; width: 14rpx; height: 12rpx; background: #dc9b9b; border-radius: 45% 45% 40% 40%; }
.toe { position: absolute; width: 5rpx; height: 6rpx; border-radius: 50%; background: #dc9b9b; top: 7rpx; }
.toe-one { left: 4rpx; transform: rotate(-20deg); }
.toe-two { left: 11rpx; top: 4rpx; }
.toe-three { right: 4rpx; transform: rotate(20deg); }
.dog-paws { width: 47rpx; bottom: -1rpx; z-index: 4; }
.paw { position: relative; width: 20rpx; height: 36rpx; background: linear-gradient(90deg, #e2dfd9 0%, #f8f7f3 32%, #f8f7f3 70%, #e8e5df 100%); border: 0; border-bottom: 0; border-radius: 35% 35% 25% 25%; box-shadow: none; }
.dog-tail-wrap { left: auto; right: 35rpx; bottom: 21rpx; }
.dog-tail { width: 15rpx; height: 28rpx; background: linear-gradient(100deg, #cbc8c5 0%, #e4e1dc 45%, #b7b5b5 100%); border: 0; border-radius: 60% 60% 35% 35%; box-shadow: none; }
.dog-shadow { width: 94rpx; height: 7rpx; bottom: -4rpx; background: #dcd9d2; filter: none; }
.live2d-dog .eye-happy-crescent { width: 9rpx; height: 6rpx; border-width: 2rpx; border-color: #343137 transparent transparent; border-radius: 50% 50% 0 0; }
.live2d-dog.action-surprise .eye { height: 12rpx; width: 9rpx; }
.live2d-dog.action-sad .dog-tongue, .live2d-dog.action-sleepy .dog-tongue { display: none; }
.live2d-dog.action-sad .mouth-lip { height: 4rpx; width: 12rpx; border: 0; border-top: 2rpx solid #695057; border-radius: 50% 50% 0 0; background: transparent; }
.live2d-dog.action-sleepy .mouth-lip { height: 4rpx; width: 10rpx; background: transparent; border: 0; border-bottom: 2rpx solid #695057; }
.live2d-dog.action-happy .ear-left { transform: rotate(-24deg); }
.live2d-dog.action-happy .ear-right { transform: rotate(24deg); }
.live2d-dog.action-sleepy .ear-left { transform: rotate(-10deg); }
.live2d-dog.action-sleepy .ear-right { transform: rotate(10deg); }

/* One sparse texture layer with physical-pixel strokes for phone rendering.
   Keep color transitions in the base backgrounds, separate from the fur. */
.live2d-dog .dog-head::before,
.live2d-dog .dog-body::before,
.dog-tail::before,
.dog-haunch::before,
.ear-fold::before {
  content: ''; position: absolute; inset: 0; border-radius: inherit;
  background-image: repeating-linear-gradient(105deg,
    transparent 0, transparent 7px,
    rgba(255,255,255,0.26) 7px, rgba(255,255,255,0.26) 8px,
    transparent 8px, transparent 13px);
  background-size: 16px 11px;
  pointer-events: none; z-index: 0;
}
.dog-tail { position: relative; }
.ear-fold { position: absolute; }
.dog-chest::after,
.paw::after {
  content: ''; position: absolute; inset: 2rpx; border-radius: inherit;
  background-image: repeating-linear-gradient(98deg,
    transparent 0, transparent 6px,
    rgba(145,138,130,0.18) 6px, rgba(145,138,130,0.18) 7px,
    transparent 7px, transparent 12px);
  background-size: 15px 10px;
  pointer-events: none;
}
/* Small filled tufts soften the silhouette without drawing an outline. */
.fur-edge { position: absolute; width: 13rpx; height: 8rpx; background: #b7b5b5; border-radius: 85% 15% 75% 25%; pointer-events: none; z-index: 2; }
.fur-edge-left { left: 6rpx; top: 54rpx; transform: rotate(35deg); }
.fur-edge-left-low { left: 10rpx; top: 69rpx; transform: rotate(12deg); }
.fur-edge-right { right: 6rpx; top: 54rpx; transform: rotate(145deg); }
.fur-edge-right-low { right: 10rpx; top: 69rpx; transform: rotate(168deg); }
.head-tuft::before, .head-tuft::after {
  content: ''; position: absolute; width: 12rpx; height: 14rpx;
  background: #f8f7f3; border-radius: 85% 15% 0 0;
}
.head-tuft::before { left: -7rpx; top: 5rpx; transform: rotate(-23deg); }
.head-tuft::after { right: -6rpx; top: 3rpx; transform: rotate(26deg); }

/* 统一取消吐舌头表现，保持嘴部表情简洁。 */
.live2d-dog .dog-tongue {
  display: none !important;
}
