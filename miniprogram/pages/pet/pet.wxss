/* 全屏沉浸式宠物屋大舞台与游戏画风 */
page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #FCE4EC;
}

.pet-room-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
}

/* 1. 全屏沉浸式小窝舞台场景 */
.room-scene {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #f4d9c8 0%, #f8e5d7 58%, #c99d78 58%, #b9825e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.scene-arrow {
  position: absolute;
  z-index: 9;
  top: 52%;
  transform: translateY(-50%);
  width: 72rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  color: #9e526d;
  font-size: 62rpx;
  font-weight: 700;
  background: rgba(255,255,255,.76);
  box-shadow: 0 6rpx 20rpx rgba(75,49,40,.12);
}
.scene-arrow-left { left: 14rpx; }
.scene-arrow-right { right: 14rpx; }
.scene-title { position:absolute; z-index:8; top:154rpx; left:50%; transform:translateX(-50%); padding:12rpx 26rpx; border-radius:28rpx; color:#805467; font-size:24rpx; font-weight:800; background:rgba(255,255,255,.74); }
.scene-living { background:linear-gradient(180deg,#f5ddd0 0%,#fff0e5 57%,#c58f6c 57%,#ad7656 100%); }
.scene-bedroom { background:linear-gradient(180deg,#d9d9f4 0%,#f3e7f7 57%,#a987aa 57%,#886b90 100%); }
.scene-bathroom { background:linear-gradient(180deg,#cdeef0 0%,#effafa 57%,#a8d1d4 57%,#7db4bb 100%); }
.scene-outdoor { background:linear-gradient(180deg,#a9d9ee 0%,#e4f6d1 57%,#9dc56f 57%,#729c51 100%); }
.scene-bedroom .room-back-wall { background:linear-gradient(180deg,#e5dcf2,#f7edf5 82%,#c4a9c8 82%,#ad91b5 100%); }
.scene-bathroom .room-back-wall { background:linear-gradient(180deg,#d6f0f1,#f0fbfa 82%,#b7dfe1 82%,#97cbd0 100%); }
.scene-outdoor .room-back-wall { background:linear-gradient(180deg,#9ed7ee,#d9f0d1 82%,#8ab967 82%,#719d53 100%); }
.scene-bedroom .room-floor { background:repeating-linear-gradient(90deg,transparent 0 150rpx,rgba(78,54,86,.1) 151rpx 154rpx),repeating-linear-gradient(0deg,#b79abb 0 94rpx,#a285a9 96rpx 100rpx); }
.scene-bathroom .room-floor { background:repeating-linear-gradient(90deg,transparent 0 150rpx,rgba(57,110,117,.12) 151rpx 154rpx),repeating-linear-gradient(0deg,#b4dfe0 0 94rpx,#9ccdd0 96rpx 100rpx); }
.scene-outdoor .room-floor { background:linear-gradient(180deg,#91bb68,#729d50); }
.scene-outdoor .room-window { display:none; }
.scene-bedroom .room-window { display:none; }
.scene-bathroom .room-window { display:none; }
.scene-bedroom .wall-art { top:34%; }
.scene-bathroom .wall-art { top:32%; }
.scene-backdrop { position:absolute; inset:0; z-index:1; pointer-events:none; overflow:hidden; }
.scene-backdrop .scene-decor,
.scene-backdrop .bedroom-headboard,
.scene-backdrop .bath-mirror,
.scene-backdrop .bath-tile { position:absolute; }
.scene-decor { font-size:72rpx; filter:drop-shadow(0 8rpx 8rpx rgba(70,50,40,.15)); }
.living-backdrop .couch { left:8%; bottom:36%; opacity:.18; }
.living-backdrop .plant { right:13%; bottom:38%; opacity:.2; }
.bedroom-backdrop .bedroom-headboard { left:50%; top:28%; transform:translateX(-50%); width:430rpx; height:170rpx; border-radius:120rpx 120rpx 20rpx 20rpx; background:rgba(134,105,161,.24); }
.bedroom-backdrop .moon { right:12%; top:22%; opacity:.3; }
.bathroom-backdrop .bath-mirror { right:16%; top:22%; width:150rpx; height:190rpx; border:12rpx solid rgba(84,145,153,.3); border-radius:70rpx; color:rgba(84,145,153,.35); font-size:130rpx; line-height:160rpx; text-align:center; }
.bathroom-backdrop .bath-tile { inset:15% 0 42%; opacity:.18; background:repeating-linear-gradient(90deg,transparent 0 110rpx,#4c9aa3 112rpx 114rpx),repeating-linear-gradient(0deg,transparent 0 90rpx,#4c9aa3 92rpx 94rpx); }
.outdoor-backdrop .cloud-one { left:10%; top:23%; opacity:.45; }
.outdoor-backdrop .cloud-two { left:62%; top:28%; opacity:.34; }
.outdoor-backdrop .sun { right:17%; top:18%; opacity:.55; font-size:90rpx; }
.scene-prop { position:absolute; z-index:4; font-size:112rpx; filter:drop-shadow(0 12rpx 10rpx rgba(65,53,41,.2)); }
.scene-prop.sofa { left:8%; bottom:20%; }
.scene-prop.table { right:25%; bottom:18%; font-size:80rpx; }
.scene-prop.lamp { right:17%; bottom:22%; }
.scene-prop.tub { right:7%; bottom:17%; font-size:132rpx; }
.scene-prop.mat { left:17%; bottom:14%; font-size:72rpx; }
.scene-prop.tent { left:5%; bottom:17%; }
.scene-prop.tree { right:6%; bottom:25%; font-size:150rpx; }

/* 插槽家具层叠绝对定位 */
.slot-layer {
  position: absolute;
  pointer-events: none;
  z-index: 2;
}

.room-back-wall { position:absolute; inset:0 0 32% 0; overflow:hidden; background:linear-gradient(180deg,#f6dfd0,#fbeade 82%,#e4bda0 82%,#d7aa8c 100%); }
.wall-panel { position:absolute; top:0; bottom:0; width:1px; background:rgba(188,135,103,.11); }
.panel-left { left:16%; } .panel-right { right:16%; }
.baseboard { position:absolute; bottom:0; left:0; width:100%; height:14rpx; background:#c88f6d; box-shadow:0 5rpx 8rpx rgba(91,54,34,.12); }
.room-window { position:absolute; width:300rpx; height:310rpx; top:16%; right:10%; padding:12rpx; box-sizing:border-box; background:#fff5e9; border:8rpx solid #bd8060; border-radius:12rpx; box-shadow:0 10rpx 24rpx rgba(107,63,41,.18); }
.window-glass { position:relative; width:100%; height:100%; overflow:hidden; background:linear-gradient(160deg,#a8d9e7,#d7f0e7 70%,#a6c887); }
.window-sun { position:absolute; width:52rpx; height:52rpx; border-radius:50%; top:18%; right:18%; background:#ffe18a; box-shadow:0 0 28rpx #ffe18a; }
.window-cloud { position:absolute; width:78rpx; height:20rpx; left:18%; top:42%; border-radius:30rpx; background:rgba(255,255,255,.78); }
.window-mullion-v,.window-mullion-h { position:absolute; background:#fff5e9; box-shadow:0 0 2rpx #9a684e; }
.window-mullion-v { width:10rpx; height:100%; left:calc(50% - 5rpx); } .window-mullion-h { height:10rpx; width:100%; top:calc(50% - 5rpx); }
.window-sill { position:absolute; bottom:-18rpx; left:-20rpx; width:calc(100% + 40rpx); height:22rpx; border-radius:8rpx; background:#d39b70; box-shadow:0 8rpx 12rpx rgba(88,52,33,.18); }
.wall-art { position:absolute; top:30%; left:22%; width:200rpx; height:150rpx; display:flex; align-items:center; justify-content:center; }
.string-lights { padding:10rpx 14rpx; color:#ffc64d; font-size:32rpx; text-shadow:0 0 18rpx #ffc64d; white-space:nowrap; }
.photo-frame { width:118rpx; height:132rpx; padding:12rpx; background:#d5a15d; border:8rpx solid #9a6247; border-radius:8rpx; box-shadow:0 8rpx 14rpx rgba(81,47,30,.2); }
.photo-art { width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:#df7c91; font-size:44rpx; background:linear-gradient(145deg,#c5e4d7,#fff0dc 60%,#f5c9c3); } .photo-art text { font-size:30rpx; }
.wall-clock { width:110rpx; height:120rpx; border-radius:48% 48% 42% 42%; padding:12rpx; box-sizing:border-box; background:#9a6046; box-shadow:0 8rpx 16rpx rgba(81,47,30,.22); }
.clock-face { position:relative; width:100%; height:100%; border-radius:50%; border:5rpx solid #f4d99a; background:#fff4d5; } .clock-face:before { content:'12'; position:absolute; top:2rpx; left:50%; transform:translateX(-50%); color:#7c5038; font-size:18rpx; }
.clock-hand { position:absolute; width:4rpx; height:32rpx; top:20%; left:50%; background:#69412f; transform:rotate(35deg); transform-origin:bottom; }
.window-item { position:absolute; z-index:2; top:38%; right:8%; width:170rpx; height:190rpx; display:flex; align-items:flex-end; justify-content:center; }
.plant { position:relative; width:120rpx; height:170rpx; } .sunflower-head { position:absolute; top:0; left:32rpx; z-index:1; color:#f4a934; font-size:66rpx; text-shadow:0 2rpx #a96b28; }
.plant-stem { position:absolute; left:57rpx; top:54rpx; width:8rpx; height:68rpx; border-radius:8rpx; background:#568351; } .plant-leaves { position:absolute; top:66rpx; left:5rpx; color:#63985e; font-size:54rpx; transform:rotate(-28deg); }
.plant-pot { position:absolute; bottom:0; left:20rpx; width:82rpx; height:52rpx; border-radius:8rpx 8rpx 24rpx 24rpx; background:linear-gradient(90deg,#cb755c,#e39a75); border-top:10rpx solid #f0b08a; box-shadow:0 8rpx 10rpx rgba(78,47,29,.18); }
.mint-leaves { position:absolute; top:10rpx; left:24rpx; color:#4e985f; font-size:76rpx; } .mint .plant-stem { top:68rpx; } .wind-chime { text-align:center; color:#d77e98; filter:drop-shadow(0 5rpx 5rpx rgba(95,54,52,.2)); }
.chime-top { font-size:48rpx; } .chime-strings { color:#ad8390; font-size:36rpx; line-height:48rpx; } .chime-bells { color:#e8b06f; font-size:36rpx; }
.room-floor { position:absolute; bottom:0; left:0; width:100%; height:42%; background:repeating-linear-gradient(90deg,transparent 0 150rpx,rgba(106,66,41,.12) 151rpx 154rpx),repeating-linear-gradient(0deg,#c7956e 0 94rpx,#b98560 96rpx 100rpx); box-shadow:inset 0 12rpx 25rpx rgba(111,69,43,.2); }
.floor-rug { position:absolute; z-index:2; left:50%; bottom:14%; transform:translateX(-50%); width:480rpx; height:180rpx; border-radius:48%; background:#ef9fb3; border:10rpx solid #d97896; box-shadow:0 14rpx 18rpx rgba(83,49,35,.2),inset 0 0 0 8rpx rgba(255,255,255,.35); }
.floor-rug.furn_rug_bear { background:#c9956c; border-color:#9b6d4f; } .floor-rug.furn_rug_star { background:#566a9d; border-color:#384a79; }
.rug-pattern { position:absolute; inset:28rpx 80rpx; border:4rpx dashed rgba(255,255,255,.58); border-radius:inherit; } .rug-pattern:after { content:'♡'; position:absolute; inset:16rpx 0 0; text-align:center; color:rgba(255,255,255,.72); font-size:46rpx; }
.room-bed { position:absolute; z-index:4; left:5%; bottom:19%; width:300rpx; height:210rpx; filter:drop-shadow(0 12rpx 12rpx rgba(72,45,33,.22)); }
.bed-headboard { position:absolute; left:12rpx; top:4rpx; width:260rpx; height:112rpx; border-radius:72rpx 72rpx 18rpx 18rpx; background:#d98ca4; border:10rpx solid #a95f7c; }
.bed-mattress { position:absolute; left:0; top:66rpx; width:286rpx; height:112rpx; border-radius:48rpx 48rpx 24rpx 24rpx; background:#fff2e6; border:8rpx solid #e3ad9c; }
.bed-pillow { position:absolute; z-index:2; left:34rpx; top:72rpx; width:82rpx; height:54rpx; border-radius:24rpx; text-align:center; line-height:54rpx; color:#df8da2; background:#fff; font-size:32rpx; box-shadow:0 4rpx 8rpx rgba(128,78,65,.15); }
.bed-blanket { position:absolute; z-index:3; top:116rpx; left:12rpx; width:260rpx; height:74rpx; border-radius:20rpx 20rpx 34rpx 34rpx; background:#f2adc0; border:5rpx solid #df8ca5; }
.bed-legs { position:absolute; z-index:-1; left:20rpx; bottom:0; width:250rpx; height:36rpx; background:#9a644c; border-radius:0 0 14rpx 14rpx; }
.room-bed.furn_bed_cloud .bed-headboard { background:#b4d6e8; border-color:#83afc8; } .room-bed.furn_bed_cloud .bed-blanket { background:#b8def0; border-color:#94c6dd; }
.room-bed.furn_bed_castle .bed-headboard { background:#d3a1d8; border-color:#9666a6; } .room-bed.furn_bed_castle .bed-blanket { background:#e8c4ea; border-color:#c88bd2; }
.room-bed.furn_bed_moon .bed-headboard { background:#6575aa; border-color:#465482; } .room-bed.furn_bed_moon .bed-blanket { background:#8d9bd0; border-color:#6c7cba; }
.bed-castle-detail,.bed-moon-detail { position:absolute; z-index:4; right:32rpx; top:6rpx; color:#ffe39b; font-size:50rpx; } .bed-moon-detail { right:42rpx; top:20rpx; font-size:68rpx; }
.room-facility { position:absolute; z-index:4; right:7%; bottom:18%; width:190rpx; height:200rpx; display:flex; align-items:flex-end; justify-content:center; filter:drop-shadow(0 10rpx 10rpx rgba(72,45,33,.22)); }
.feeder { width:150rpx; height:110rpx; } .feeder-bowl { position:absolute; bottom:30rpx; left:10rpx; width:130rpx; height:52rpx; border-radius:12rpx 12rpx 58rpx 58rpx; background:linear-gradient(#f8d5c7 0 28%,#c97e67 30%); border:7rpx solid #a96150; }
.food-pile { position:absolute; top:-24rpx; left:35rpx; width:55rpx; height:28rpx; border-radius:50%; background:#b7864d; box-shadow:12rpx -8rpx #d5aa68,-10rpx -6rpx #d5aa68; } .feeder-base { position:absolute; bottom:10rpx; left:28rpx; width:98rpx; height:28rpx; border-radius:50%; background:#a96150; }
.fountain { width:140rpx; height:170rpx; position:relative; } .fountain-bowl { position:absolute; bottom:14rpx; left:4rpx; width:132rpx; height:52rpx; border-radius:10rpx 10rpx 60rpx 60rpx; background:linear-gradient(#9be3e7 0 35%,#80c4d0 36%); border:8rpx solid #74aab8; }
.fountain-base { position:absolute; bottom:0; left:25rpx; width:90rpx; height:24rpx; border-radius:50%; background:#628fa0; } .water-stream { position:absolute; z-index:1; bottom:58rpx; left:60rpx; width:20rpx; height:76rpx; border-radius:50%; background:linear-gradient(90deg,#9be6ee,#e6ffff,#75cbd9); box-shadow:0 0 12rpx #a8f2f4; }
.robot { position:relative; width:130rpx; height:170rpx; } .robot-head { position:absolute; top:12rpx; left:18rpx; width:94rpx; height:72rpx; border-radius:30rpx; border:7rpx solid #7ba8b4; background:#e6f5f4; display:flex; align-items:center; justify-content:space-evenly; }
.robot-eye { width:14rpx; height:18rpx; border-radius:50%; background:#5b88a0; } .robot-antenna { position:absolute; top:0; left:62rpx; width:6rpx; height:18rpx; background:#7ba8b4; }
.robot-antenna:after { content:''; position:absolute; top:-8rpx; left:-7rpx; width:20rpx; height:20rpx; border-radius:50%; background:#f1a5ad; } .robot-body { position:absolute; bottom:4rpx; left:8rpx; width:114rpx; height:74rpx; border-radius:28rpx 28rpx 18rpx 18rpx; background:linear-gradient(135deg,#b9dce1,#83b5c0); border:6rpx solid #6e9da9; }

/* 墙饰插槽 (中上方) */
.slot-wall {
  top: 15%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 48rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(255, 128, 171, 0.4));
}

/* 窗台植物插槽 (右上方) */
.slot-window {
  top: 22%;
  right: 8%;
  font-size: 52rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.1));
}

/* 地毯插槽 (底座正中央) */
.slot-rug {
  bottom: 22%;
  left: 50%;
  transform: translateX(-50%);
  width: 440rpx;
  height: 140rpx;
  background: radial-gradient(ellipse at center, rgba(255, 128, 171, 0.35) 0%, rgba(255, 128, 171, 0) 70%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  z-index: 1;
}

/* 睡窝插槽 (左下角) */
.slot-bed {
  bottom: 24%;
  left: 8%;
  font-size: 56rpx;
  filter: drop-shadow(0 6rpx 12rpx rgba(0, 0, 0, 0.12));
  z-index: 2;
}

/* 生活保障机插槽 (右下角) */
.slot-facility {
  bottom: 24%;
  right: 8%;
  font-size: 56rpx;
  filter: drop-shadow(0 6rpx 12rpx rgba(0, 0, 0, 0.12));
  z-index: 2;
}

/* 核心主角 Live2D 宠物舞台 */
.center-pet-wrap {
  position: absolute;
  top: 61%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 900rpx;
  /* place the pet on the floor rug and give the Live2D stage room to breathe */
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.center-pet-wrap live2d-pet {
  width: 100%;
  height: 100%;
}

/* 2. 悬浮品目边缘交互层 (HUD) */
.floating-hud {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 10;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 顶部自适应状态行 */
.top-nav-row {
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 28rpx;
}
.back-pill {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.08);
}
.pill-icon {
  font-size: 40rpx;
  color: #D81B60;
  font-weight: 800;
  margin-top: -4rpx;
}
.name-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8rpx);
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.08);
}
.pet-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #D81B60;
}
.edit-icon {
  font-size: 20rpx;
}
.coin-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, rgba(255, 248, 225, 0.95), rgba(255, 224, 130, 0.95));
  backdrop-filter: blur(8rpx);
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 179, 0, 0.25);
  border: 1.5rpx solid #FFE082;
}
.coin-icon {
  font-size: 26rpx;
}
.coin-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #E65100;
  font-family: monospace;
}

/* 伴侣动态小浮条 */
.partner-dynamic-toast {
  position: absolute;
  top: 140rpx;
  left: 50%;
  transform: translateX(-50%) translateY(-20rpx);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid #F8BBD0;
  box-shadow: 0 6rpx 20rpx rgba(244, 143, 177, 0.28);
  border-radius: 36rpx;
  padding: 10rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  opacity: 0;
  transition: all 0.3s ease;
  pointer-events: none;
}
.partner-dynamic-toast.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}
.pdt-heart {
  font-size: 24rpx;
}
.pdt-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #D81B60;
}

/* 左侧品目边缘：极简属性小胶囊 */
.hud-left {
  position: absolute;
  left: 20rpx;
  top: 260rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  pointer-events: auto;
}
.stat-bubble {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(8rpx);
  border-radius: 28rpx;
  padding: 6rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.stat-bubble.warn {
  border: 2rpx solid #E57373;
  background: rgba(255, 235, 238, 0.9);
}
.sb-icon {
  font-size: 22rpx;
}
.sb-val {
  font-size: 20rpx;
  font-weight: 700;
  color: #5D4E3F;
  font-family: monospace;
}

/* 右侧品目边缘：常驻功能浮标 */
.hud-right {
  position: absolute;
  right: 20rpx;
  top: 250rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  pointer-events: auto;
}
.hud-btn-circle {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}
.hud-btn-circle:active {
  transform: scale(0.9);
}
.game-btn {
  background: linear-gradient(135deg, #FFF9C4 0%, #FFF176 100%);
  border-color: #FFEE58;
}
.hbc-icon {
  font-size: 34rpx;
  line-height: 1;
}
.hbc-label {
  font-size: 16rpx;
  font-weight: 800;
  color: #5D4E3F;
  margin-top: 4rpx;
}

/* 底部蜕变就绪浮动按钮 */
.evolve-dock-bar {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  pointer-events: auto;
}
.btn-dock-evolve {
  background: linear-gradient(135deg, #FF4081 0%, #E91E63 100%) !important;
  color: #FFFFFF !important;
  font-size: 26rpx !important;
  font-weight: 800 !important;
  border-radius: 40rpx !important;
  padding: 14rpx 48rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(233, 30, 99, 0.4) !important;
}
.btn-dock-evolve.confirm {
  background: linear-gradient(135deg, #FFA726 0%, #FB8C00 100%) !important;
  box-shadow: 0 6rpx 20rpx rgba(251, 140, 0, 0.4) !important;
}

/* 3. 模态弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.modal-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5EFEB;
}
.mh-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #4A3B2F;
}
.mh-coins {
  font-size: 26rpx;
  font-weight: 800;
  color: #FB8C00;
  margin-left: auto;
  margin-right: 28rpx;
}
.mh-close {
  font-size: 32rpx;
  color: #BCAAA4;
  padding: 8rpx;
}

/* 抽屉分页与网格 */
.sheet-tabs {
  display: flex;
  background: #FFF5F7;
  padding: 10rpx;
  margin: 16rpx 28rpx;
  border-radius: 20rpx;
}
.st-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #8D6E63;
  border-radius: 16rpx;
}
.st-item.active {
  background: #FFFFFF;
  color: #E91E63;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}
.scene-filter { display:flex; gap:10rpx; padding:0 28rpx 14rpx; overflow-x:auto; white-space:nowrap; }
.scene-filter-chip { display:inline-flex; padding:10rpx 20rpx; border-radius:24rpx; background:#fff5f7; color:#8d6e63; font-size:22rpx; font-weight:700; }
.scene-filter-chip.active { background:#e88aa4; color:#fff; }
.decor-scene-filter { padding:0 0 16rpx; }

.sheet-scroll {
  max-height: 60vh;
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
}

.shop-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  padding-bottom: 20rpx;
}
.shop-card-box {
  background: #FFF9FA;
  border: 1.5rpx solid #FFE4E9;
  border-radius: 22rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.shop-card-box.equipped {
  border-color: #4CAF50;
  background: #E8F5E9;
}
.shop-card-box.unavailable { opacity:.62; }
.shop-card-box.unavailable .btn-buy { background:#bdbdbd !important; box-shadow:none !important; }
.sc-emoji {
  font-size: 46rpx;
  margin-bottom: 10rpx;
}
.sc-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #4A3B2F;
  margin-bottom: 6rpx;
}
.sc-desc {
  font-size: 18rpx;
  color: #9E8574;
  margin-bottom: 14rpx;
  min-height: 44rpx;
  line-height: 1.3;
}
.btn-buy {
  background: linear-gradient(135deg, #FFA726 0%, #FB8C00 100%) !important;
  color: #FFFFFF !important;
  font-size: 22rpx !important;
  font-weight: 800 !important;
  border-radius: 28rpx !important;
  padding: 8rpx 28rpx !important;
  display: inline-flex !important;
  align-items: center !important;
}
.btn-coin {
  font-size: 20rpx;
  margin-right: 4rpx;
}

/* 储物箱网格 */
.bag-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.bag-item-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF9FA;
  border: 1.5rpx solid #FFE4E9;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}
.bic-badge {
  background: #E91E63;
  color: #FFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}
.bic-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}
.bic-emoji {
  font-size: 38rpx;
}
.bic-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #4A3B2F;
}
.btn-use {
  background: #FF80AB !important;
  color: #FFFFFF !important;
  font-size: 22rpx !important;
  font-weight: 700 !important;
  border-radius: 24rpx !important;
  padding: 8rpx 24rpx !important;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #BCAAA4;
  font-size: 24rpx;
}

/* 装饰卸下栏 */
.decor-actions-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}
.btn-unequip {
  background: #E0E0E0 !important;
  color: #616161 !important;
  font-size: 20rpx !important;
  border-radius: 20rpx !important;
  padding: 6rpx 20rpx !important;
}

/* 足迹手账 */
.footprints-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.fp-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.fp-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #FFA726;
}
.fp-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
}
.fp-text {
  font-size: 22rpx;
  color: #5D4E3F;
}
.fp-time {
  font-size: 18rpx;
  color: #BCAAA4;
}

/* 小游戏全屏体验区 */
.game-card {
  height: 80vh;
  display: flex;
  flex-direction: column;
}
.game-view-area {
  position: relative;
  flex: 1;
  background: linear-gradient(180deg, #E1F5FE 0%, #FFF9C4 100%);
  overflow: hidden;
  box-sizing: border-box;
}
.game-top-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #0277BD;
}
.falling-item {
  position: absolute;
  transform: translate(-50%, -50%);
  font-size: 44rpx;
  transition: top 0.1s linear;
}
.catcher-pet {
  position: absolute;
  top: 82%;
  transform: translate(-50%, -50%);
  font-size: 64rpx;
  transition: left 0.05s ease-out;
}
.game-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 40rpx;
  box-sizing: border-box;
  text-align: center;
}
.go-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #4A3B2F;
}
.go-sub {
  font-size: 24rpx;
  color: #8D6E63;
}
.go-warn {
  font-size: 22rpx;
  color: #D32F2F;
  font-weight: 700;
}
.btn-start-game {
  background: linear-gradient(135deg, #FFB300 0%, #FB8C00 100%) !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  border-radius: 40rpx !important;
  padding: 14rpx 60rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(251, 140, 0, 0.35) !important;
  margin-top: 16rpx;
}

/* 开发者测试面板抽屉样式 */
.dev-modal-sheet {
  max-height: 70vh;
}
.dev-section-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #5D4E3F;
  margin: 20rpx 0 12rpx;
}
.dev-btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.dev-btn {
  margin: 0 !important;
  font-size: 22rpx !important;
  padding: 10rpx 20rpx !important;
  background: #F5EDE6 !important;
  color: #5D4E3F !important;
  border-radius: 16rpx !important;
}
.dev-btn.ok {
  background: #E8F5E9 !important;
  color: #2E7D32 !important;
}
.dev-btn.warn {
  background: #FFEBEE !important;
  color: #D32F2F !important;
}
