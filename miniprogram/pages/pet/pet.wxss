/* 专属萌宠页面样式 */
.pet-page {
  padding: 24rpx 20rpx 60rpx;
  background-color: #FFEBED;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(191, 166, 154, 0.12);
  border: 2rpx solid rgba(255, 235, 237, 0.8);
  box-sizing: border-box;
}

/* 顶部大舞台卡片 */
.pet-stage-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx 28rpx;
  background: radial-gradient(circle at center, #FFF9FA 0%, #FFFFFF 100%);
  border: 2rpx solid #FFDCE5;
}
.pet-stage-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* 顶部精美对白条：独立位于小狗上方，带微渐变与轻投影 */
.stage-speech-bubble {
  width: 90%;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF5F7 100%);
  border: 2rpx solid #FFD0DB;
  border-radius: 22rpx;
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(244, 143, 177, 0.16);
  margin-bottom: 14rpx;
  box-sizing: border-box;
}
.ssb-icon-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #E91E63;
  background: #FFF0F3;
  border: 1rpx solid #FFCDD2;
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.ssb-text {
  font-size: 22rpx;
  color: #6D4C41;
  font-weight: 600;
  line-height: 1.4;
  flex: 1;
}

.pet-name-box {
  display: flex;
  align-items: center;
  background: #FFF0F3;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1.5rpx solid #FFCDD2;
}
.pnb-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #D81B60;
}
.pnb-edit {
  font-size: 20rpx;
  margin-left: 8rpx;
}
.pet-level-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #E65100;
  background: #FFF3E0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1.5rpx solid #FFE0B2;
}
.stage-pet-center {
  width: 100%;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10rpx 0 16rpx;
}
.stage-tip {
  font-size: 20rpx;
  color: #B39B8A;
  text-align: center;
}

/* 状态与数值卡片 */
.stats-card {
  padding: 24rpx;
}
.card-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.ctr-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #5A4636;
}
.ctr-exp {
  font-size: 20rpx;
  color: #9E7D6B;
}
.ctr-sub {
  font-size: 20rpx;
  color: #B39B8A;
}

.stat-bars {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.stat-bar-row {
  display: flex;
  align-items: center;
}
.sbr-label {
  width: 130rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #6D4C41;
  display: flex;
  align-items: center;
}
.sbr-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}
.sbr-bar-track {
  flex: 1;
  height: 16rpx;
  background: #F0E6DF;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}
.sbr-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}
.sbr-bar-fill.hunger {
  background: linear-gradient(90deg, #FFB74D, #FFA726);
}
.sbr-bar-fill.mood {
  background: linear-gradient(90deg, #F48FB1, #E91E63);
}
.sbr-bar-fill.energy {
  background: linear-gradient(90deg, #81D4FA, #29B6F6);
}
.sbr-val {
  font-size: 22rpx;
  color: #8C7565;
  width: 80rpx;
  text-align: right;
  font-family: monospace;
}
.pet-diary-row {
  border-top: 1rpx dashed #FFCDD2;
  padding-top: 14rpx;
  display: flex;
  align-items: center;
}
.pdr-tag {
  font-size: 18rpx;
  font-weight: 700;
  background: #FFF0F3;
  color: #E91E63;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  white-space: nowrap;
}
.pdr-text {
  font-size: 22rpx;
  color: #5A4636;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 养成操作盘 */
.actions-card {
  padding: 24rpx;
}
.actions-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.act-btn {
  background: #FFF9FA;
  border: 2rpx solid #FFE0B2;
  border-radius: 24rpx;
  padding: 20rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s ease, background 0.15s ease;
}
.act-btn:active {
  transform: scale(0.95);
  background: #FFF0F3;
}
.act-icon-box {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 10rpx;
}
.box-feed { background: #FFE0B2; }
.box-pet { background: #FFCDD2; }
.box-play { background: #C8E6C9; }
.box-gift { background: #E1BEE7; }
.box-sleep { background: #BBDEFB; }
.box-rename { background: #CFD8DC; }
.act-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #5A4636;
}
.act-desc {
  font-size: 18rpx;
  color: #B39B8A;
  margin-top: 4rpx;
  white-space: nowrap;
}

/* 指南卡片 */
.tips-card {
  padding: 24rpx;
}
.tips-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #5A4636;
  margin-bottom: 10rpx;
}
.tips-content {
  font-size: 20rpx;
  color: #8C7565;
  line-height: 1.6;
}
