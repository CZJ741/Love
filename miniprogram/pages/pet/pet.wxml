<view class="pet-room-page">
  <!-- 1. 全屏沉浸式宠物屋背景与家具展示 -->
  <view class="room-scene scene-{{currentScene}}">
    <view class="scene-arrow scene-arrow-left" bindtap="previousScene">‹</view>
    <view class="scene-title">{{currentSceneName}}</view>
    <view class="scene-arrow scene-arrow-right" bindtap="nextScene">›</view>
    <view wx:if="{{currentScene === 'living'}}" class="scene-backdrop living-backdrop"><view class="scene-decor couch">🛋️</view><view class="scene-decor plant">🪴</view></view>
    <view wx:if="{{currentScene === 'bedroom'}}" class="scene-backdrop bedroom-backdrop"><view class="bedroom-headboard"></view><view class="scene-decor moon">🌙</view></view>
    <view wx:if="{{currentScene === 'bathroom'}}" class="scene-backdrop bathroom-backdrop"><view class="bath-mirror">◯</view><view class="bath-tile"></view></view>
    <view wx:if="{{currentScene === 'outdoor'}}" class="scene-backdrop outdoor-backdrop"><view class="scene-decor cloud-one">☁️</view><view class="scene-decor cloud-two">☁️</view><view class="scene-decor sun">☀️</view></view>
    <view class="room-back-wall">
      <view class="wall-panel panel-left"></view><view class="wall-panel panel-right"></view><view class="baseboard"></view>
      <view class="room-window"><view class="window-glass"><view class="window-sun"></view><view class="window-cloud"></view><view class="window-mullion-v"></view><view class="window-mullion-h"></view></view><view class="window-sill"></view></view>
      <view class="wall-art" wx:if="{{pet.slots.wall && visibleSlots.wall}}">
        <view wx:if="{{pet.slots.wall === 'furn_wall_lights'}}" class="string-lights">✨ ✨ ✨ ✨</view>
        <view wx:elif="{{pet.slots.wall === 'furn_wall_frame'}}" class="photo-frame"><view class="photo-art">💞</view></view>
        <view wx:elif="{{pet.slots.wall === 'furn_wall_clock'}}" class="wall-clock"><view class="clock-face"><view class="clock-hand"></view></view></view>
      </view>
      <view class="window-item" wx:if="{{pet.slots.window && visibleSlots.window}}">
        <view wx:if="{{pet.slots.window === 'furn_win_sunflower'}}" class="plant"><view class="sunflower-head">🌻</view><view class="plant-stem"></view><view class="plant-leaves">🌿</view><view class="plant-pot"></view></view>
        <view wx:elif="{{pet.slots.window === 'furn_win_cherry'}}" class="wind-chime"><view class="chime-top">🎐</view><view class="chime-strings">│ │ │</view><view class="chime-bells">🔔 🔔 🔔</view></view>
        <view wx:elif="{{pet.slots.window === 'furn_win_catgrass'}}" class="plant mint"><view class="mint-leaves">🌱</view><view class="plant-stem"></view><view class="plant-pot"></view></view>
      </view>
    </view>
    <view class="room-floor"></view>
    <view class="floor-rug {{pet.slots.rug}}" wx:if="{{pet.slots.rug && visibleSlots.rug}}"><view class="rug-pattern"></view></view>
    <view class="room-bed {{pet.slots.bed}}" wx:if="{{pet.slots.bed && visibleSlots.bed}}"><view class="bed-headboard"></view><view class="bed-pillow">🤍</view><view class="bed-mattress"></view><view class="bed-blanket"></view><view class="bed-legs"></view><view wx:if="{{pet.slots.bed === 'furn_bed_castle'}}" class="bed-castle-detail">🏰</view><view wx:if="{{pet.slots.bed === 'furn_bed_moon'}}" class="bed-moon-detail">🌙</view></view>
    <view class="room-facility {{pet.slots.facility}}" wx:if="{{pet.slots.facility && visibleSlots.facility}}">
      <view wx:if="{{pet.slots.facility === 'furn_fac_feeder'}}" class="feeder"><view class="feeder-bowl"><view class="food-pile"></view></view><view class="feeder-base"></view></view>
      <view wx:elif="{{pet.slots.facility === 'furn_fac_fountain'}}" class="fountain"><view class="water-stream"></view><view class="fountain-bowl"></view><view class="fountain-base"></view></view>
      <view wx:elif="{{pet.slots.facility === 'furn_fac_robot'}}" class="robot"><view class="robot-antenna"></view><view class="robot-head"><view class="robot-eye"></view><view class="robot-eye"></view></view><view class="robot-body"></view></view>
    </view>
    <view wx:if="{{currentScene === 'living' && pet.slots.scene_living_sofa}}" class="scene-prop sofa">🛋️</view>
    <view wx:if="{{currentScene === 'living' && pet.slots.scene_living_table}}" class="scene-prop table">🪵</view>
    <view wx:if="{{currentScene === 'bedroom' && pet.slots.scene_bedroom_lamp}}" class="scene-prop lamp">🪔</view>
    <view wx:if="{{currentScene === 'bathroom' && pet.slots.scene_bathroom_tub}}" class="scene-prop tub">🛁</view>
    <view wx:if="{{currentScene === 'bathroom' && pet.slots.scene_bathroom_mat}}" class="scene-prop mat">🧼</view>
    <view wx:if="{{currentScene === 'outdoor' && pet.slots.scene_outdoor_tent}}" class="scene-prop tent">⛺</view>
    <view wx:if="{{currentScene === 'outdoor' && pet.slots.scene_outdoor_tree}}" class="scene-prop tree">🌳</view>
    <!-- 核心角色：Live2D 宠物舞台 -->
    <view class="center-pet-wrap" catchtap="onTapPet">
      <live2d-pet id="live2d-stage-pet" pet="{{pet}}" bind:interact="onPetLive2DInteract" />
    </view>
  </view>

  <!-- 2. 悬浮交互界面 -->
  <view class="floating-hud">
    <!-- 顶部状态栏 -->
    <view class="top-nav-row" style="padding-top: {{statusBarHeight}}px;">
      <view class="back-pill" bindtap="navigateBack">
        <text class="pill-icon">‹</text>
      </view>
      <view class="name-pill" bindtap="promptRename" bindlongpress="toggleDevModal">
        <text class="pet-name">{{pet.name || '小糯米'}}</text>
        <text class="edit-icon">✏️</text>
      </view>
      <view class="coin-pill">
        <text class="coin-icon">🪙</text>
        <text class="coin-num">{{pet.coins || 0}}</text>
      </view>
    </view>

    <!-- 伴侣互动动态提示 -->
    <view class="partner-dynamic-toast {{showPartnerToast ? 'show' : ''}}">
      <text class="pdt-heart">💞</text>
      <text class="pdt-text">{{partnerToast}}</text>
    </view>

    <!-- 左侧宠物状态 -->
    <view class="hud-left">
      <view class="stat-bubble">
        <text class="sb-icon">🍖</text>
        <text class="sb-val">{{pet.hunger || 0}}</text>
      </view>
      <view class="stat-bubble">
        <text class="sb-icon">😊</text>
        <text class="sb-val">{{pet.mood || 0}}</text>
      </view>
      <view class="stat-bubble">
        <text class="sb-icon">🫧</text>
        <text class="sb-val">{{pet.cleanliness || 0}}</text>
      </view>
      <view class="stat-bubble">
        <text class="sb-icon">⚡</text>
        <text class="sb-val">{{pet.energy || 0}}</text>
      </view>
      <view class="stat-bubble {{pet.health < 60 ? 'warn' : ''}}">
        <text class="sb-icon">❤️</text>
        <text class="sb-val">{{pet.health || 0}}</text>
      </view>
    </view>

    <!-- 右侧常用功能 -->
    <view class="hud-right">
      <view class="hud-btn-circle game-btn" data-type="game" bindtap="openModal">
        <text class="hbc-icon">🎮</text>
        <text class="hbc-label">赚金币</text>
      </view>
      <view class="hud-btn-circle shop-btn" data-type="shop" bindtap="openModal">
        <text class="hbc-icon">🛍️</text>
        <text class="hbc-label">商店</text>
      </view>
      <view class="hud-btn-circle bag-btn" data-type="backpack" bindtap="openModal">
        <text class="hbc-icon">🎒</text>
        <text class="hbc-label">储物箱</text>
      </view>
      <view class="hud-btn-circle decor-btn" data-type="decor" bindtap="openModal">
        <text class="hbc-icon">🪑</text>
        <text class="hbc-label">换装</text>
      </view>
      <view class="hud-btn-circle log-btn" data-type="footprints" bindtap="openModal">
        <text class="hbc-icon">📔</text>
        <text class="hbc-label">足迹</text>
      </view>
    </view>

    <!-- 满足条件时显示进化提示 -->
    <view wx:if="{{canEvolve && !pet.evolveRequested}}" class="evolve-dock-bar">
      <button class="btn-dock-evolve" bindtap="requestEvolve">✨ 发起进化</button>
    </view>
    <view wx:elif="{{isWaitingPartnerConfirm}}" class="evolve-dock-bar">
      <button class="btn-dock-evolve confirm" bindtap="confirmEvolve">🎉 确认共同见证进化</button>
    </view>
  </view>

  <!-- 3. 功能弹窗 -->

  <!-- 萌宠小游戏 -->
  <view wx:if="{{activeModal === 'game'}}" class="modal-mask" catchtap="closeModal">
    <view class="modal-card game-card" catchtap="noop">
      <view class="modal-header">
        <view class="mh-title">萌宠接金币大冒险</view>
        <view class="mh-close" bindtap="closeModal">×</view>
      </view>

      <view class="game-view-area" catchtouchmove="onGameTouchMove">
        <view class="game-top-bar">
          <text class="gtb-score">得分：{{gameScore}}</text>
          <text class="gtb-coins">今日金币：{{pet.todayCoins || 0}}/{{dailyCoinLimit}}</text>
        </view>

  <!-- 掉落物 -->
        <block wx:for="{{gameItems}}" wx:key="id">
          <view class="falling-item" style="left: {{item.x}}%; top: {{item.y}}%;">
            <text class="item-emoji">{{item.emoji}}</text>
          </view>
        </block>

        <!-- 底部可移动接取托盘 -->
        <view class="catcher-pet" style="left: {{catcherX}}%;">
          <text class="catcher-avatar">🐶</text>
        </view>

        <!-- 游戏开始前或结束后的提示 -->
        <view wx:if="{{!gameRunning}}" class="game-overlay">
          <block wx:if="{{gameGameOver && earnedCoinsResult}}">
            <view class="go-title">冒险完成！</view>
            <view class="go-sub">获得金币：{{earnedCoinsResult.earnedCoins}} 🪙</view>
            <view wx:if="{{earnedCoinsResult.isExhausted}}" class="go-warn">⚠️ 体力已耗尽，产生了疲劳惩罚</view>
            <button class="btn-start-game" bindtap="startMiniGame">再玩一局</button>
          </block>
          <block wx:else>
            <view class="go-title">左右滑动接住金币与食物！</view>
            <view class="go-sub">注意躲开炸弹，每次游戏会消耗少量体力与清洁度</view>
            <button class="btn-start-game" bindtap="startMiniGame">开始游戏</button>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- 萌宠商店弹窗 -->
  <view wx:if="{{activeModal === 'shop'}}" class="modal-mask" catchtap="closeModal">
    <view class="modal-card sheet-card" catchtap="noop">
      <view class="modal-header">
        <view class="mh-title">萌宠百货</view>
        <view class="mh-coins"><text class="coin-icon">🪙</text>{{pet.coins || 0}}</view>
        <view class="mh-close" bindtap="closeModal">×</view>
      </view>

      <view class="sheet-tabs">
        <view class="st-item {{shopTab === 'consumable' ? 'active' : ''}}" data-tab="consumable" bindtap="switchShopTab">食品用品</view>
        <view class="st-item {{shopTab === 'furniture' ? 'active' : ''}}" data-tab="furniture" bindtap="switchShopTab">场景家具</view>
      </view>

      <view wx:if="{{shopTab === 'furniture'}}" class="scene-filter">
        <view wx:for="{{scenes}}" wx:key="id" class="scene-filter-chip {{furnitureSceneTab === item.id ? 'active' : ''}}" data-scene="{{item.id}}" bindtap="switchFurnitureScene">{{item.name}}</view>
      </view>

      <scroll-view scroll-y class="sheet-scroll">
        <view class="shop-grid">
          <block wx:for="{{displayShopList}}" wx:key="id">
            <view wx:if="{{shopTab === 'consumable' && item.type === 'consumable' || shopTab === 'furniture' && item.type === 'furniture' && item.scene === furnitureSceneTab}}" class="shop-card-box {{item.available === false ? 'unavailable' : ''}}">
              <view class="sc-emoji">{{item.emoji}}</view>
              <view class="sc-name">{{item.name}}</view>
              <view class="sc-desc">{{item.desc}}</view>
              <button class="btn-buy" data-id="{{item.id}}" data-available="{{item.available !== false}}" bindtap="buyShopItem">
                <text wx:if="{{item.available !== false}}"><text class="btn-coin">🪙</text>{{item.price}}</text>
                <text wx:else>即将上架</text>
              </button>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 宠物背包弹窗 -->
  <view wx:if="{{activeModal === 'backpack'}}" class="modal-mask" catchtap="closeModal">
    <view class="modal-card sheet-card" catchtap="noop">
      <view class="modal-header">
        <view class="mh-title">宠物背包</view>
        <view class="mh-close" bindtap="closeModal">×</view>
      </view>

      <scroll-view scroll-y class="sheet-scroll">
        <view class="bag-grid" wx:if="{{pet.inventory && pet.inventory.length}}">
          <block wx:for="{{pet.inventory}}" wx:key="id">
            <view wx:if="{{item.type === 'consumable'}}" class="bag-item-card">
              <view class="bic-badge">{{item.count}}</view>
              <view class="bic-info">
                <text class="bic-emoji">{{item.emoji || '🍽️'}}</text>
                <text class="bic-name">{{item.name || item.id}}</text>
              </view>
              <button class="btn-use" data-id="{{item.id}}" bindtap="useBackpackItem">取出使用</button>
            </view>
          </block>
        </view>
        <view wx:else class="empty-tip">背包空空如也，去商店逛逛吧~</view>
      </scroll-view>
    </view>
  </view>

  <!-- 宠物屋装饰弹窗 -->
  <view wx:if="{{activeModal === 'decor'}}" class="modal-mask" catchtap="closeModal">
    <view class="modal-card sheet-card" catchtap="noop">
      <view class="modal-header">
        <view class="mh-title">宠物小窝装饰</view>
        <view class="mh-close" bindtap="closeModal">×</view>
      </view>

      <view class="sheet-tabs decor-tabs">
        <view class="st-item {{decorSlotTab === 'scene' ? 'active' : ''}}" data-tab="scene" bindtap="switchDecorTab">场景</view>
        <view class="st-item {{decorSlotTab === 'rug' ? 'active' : ''}}" data-tab="rug" bindtap="switchDecorTab">地毯</view>
        <view class="st-item {{decorSlotTab === 'bed' ? 'active' : ''}}" data-tab="bed" bindtap="switchDecorTab">睡窝</view>
        <view class="st-item {{decorSlotTab === 'wall' ? 'active' : ''}}" data-tab="wall" bindtap="switchDecorTab">墙饰</view>
        <view class="st-item {{decorSlotTab === 'window' ? 'active' : ''}}" data-tab="window" bindtap="switchDecorTab">窗台</view>
        <view class="st-item {{decorSlotTab === 'facility' ? 'active' : ''}}" data-tab="facility" bindtap="switchDecorTab">设施</view>
      </view>

      <scroll-view scroll-y class="sheet-scroll">
        <view wx:if="{{decorSlotTab === 'scene'}}" class="scene-filter decor-scene-filter">
          <view wx:for="{{scenes}}" wx:key="id" class="scene-filter-chip {{currentScene === item.id ? 'active' : ''}}" data-scene="{{item.id}}" bindtap="switchScene">{{item.name}}</view>
        </view>
        <view class="decor-actions-row" wx:if="{{decorSlotTab !== 'scene'}}">
          <button class="btn-unequip" data-slot="{{decorSlotTab}}" data-id="" bindtap="equipFurniture">卸下当前装饰</button>
        </view>
        <view class="shop-grid">
          <block wx:for="{{pet.inventory}}" wx:key="id">
            <view wx:if="{{decorSlotTab !== 'scene' && item.type === 'furniture' && item.slot === decorSlotTab && item.scene === currentScene}}" class="shop-card-box {{pet.slots[decorSlotTab] === item.id ? 'equipped' : ''}}">
              <view class="sc-emoji">{{item.emoji || '🪑'}}</view>
              <view class="sc-name">{{item.name || item.id}}</view>
              <button class="btn-buy" data-slot="{{decorSlotTab}}" data-id="{{item.id}}" bindtap="equipFurniture">
                {{pet.slots[decorSlotTab] === item.id ? '已穿戴' : '穿戴'}}
              </button>
            </view>
            <view wx:if="{{decorSlotTab === 'scene' && item.type === 'furniture' && item.scene === currentScene}}" class="shop-card-box {{item.equipped ? 'equipped' : ''}}">
              <view class="sc-emoji">{{item.emoji}}</view>
              <view class="sc-name">{{item.name}}</view>
              <button class="btn-buy" data-id="{{item.id}}" data-scene="{{item.scene}}" data-slot="{{item.slot}}" bindtap="equipSceneFurniture">
                {{item.equipped ? '已摆放' : '摆放'}}
              </button>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 双人养育足迹 -->
  <view wx:if="{{activeModal === 'footprints'}}" class="modal-mask" catchtap="closeModal">
    <view class="modal-card sheet-card" catchtap="noop">
      <view class="modal-header">
        <view class="mh-title">双人养育足迹</view>
        <view class="mh-close" bindtap="closeModal">×</view>
      </view>

      <scroll-view scroll-y class="sheet-scroll">
        <view class="footprints-list" wx:if="{{pet.footprints && pet.footprints.length}}">
          <view wx:for="{{pet.footprints}}" wx:key="id" class="fp-item">
            <view class="fp-dot"></view>
            <view class="fp-content">
              <text class="fp-text">{{item.text}}</text>
              <text class="fp-time">{{item.timeStr || '刚刚'}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="empty-tip">还没有足迹记录哦</view>
      </scroll-view>
    </view>
  </view>

  <!-- 开发者测试面板：长按顶部宠物名字打开 -->
  <view wx:if="{{showDevModal}}" class="modal-mask" catchtap="toggleDevModal">
    <view class="modal-card dev-modal-sheet" catchtap="noop">
      <view class="modal-header">
        <view class="mh-title">萌宠开发者测试面板</view>
        <view class="mh-close" bindtap="toggleDevModal">×</view>
      </view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="dev-section-title">快速切换成长阶段</view>
        <view class="dev-btn-group">
          <button class="dev-btn" data-stage="egg" bindtap="devSwitchStage">🥚 阶段一 · 萌宠蛋</button>
          <button class="dev-btn" data-stage="baby" bindtap="devSwitchStage">🐾 阶段二 · 幼崽期</button>
          <button class="dev-btn" data-stage="youth" bindtap="devSwitchStage">🐕 阶段三 · 成长期</button>
          <button class="dev-btn" data-stage="adult" bindtap="devSwitchStage">👑 阶段四 · 完全体</button>
        </view>

        <view class="dev-section-title">快速注入资产与状态</view>
        <view class="dev-btn-group">
          <button class="dev-btn ok" bindtap="devAddCoins">🪙 充值 +500 金币</button>
          <button class="dev-btn ok" bindtap="devFullRecovery">💖 全部状态恢复</button>
          <button class="dev-btn ok" bindtap="devMaxExp">✨ 经验拉满（可进化）</button>
          <button class="dev-btn warn" bindtap="devMakeSick">🤒 设为虚弱生病</button>
          <button class="dev-btn warn" bindtap="devMakeHungry">🍖 设为极度饥饿</button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
