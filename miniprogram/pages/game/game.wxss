/* 游戏大厅与棋类页面样式 */
.game-page {
  padding: 24rpx 20rpx 60rpx;
  background-color: #FFEBED;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(191, 166, 154, 0.12);
  border: 2rpx solid rgba(255, 235, 237, 0.8);
  box-sizing: border-box;
}

/* ================= 游戏大厅列表样式（紧凑现代卡片） ================= */
.lobby-header {
  padding: 24rpx 24rpx 22rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8FA 100%);
  border: 2rpx solid #FFDCE5;
  margin-bottom: 18rpx;
}
.lobby-title-row {
  display: flex;
  align-items: center;
}
.lobby-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FFE082 0%, #FFB300 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 0, 0.3);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.lobby-icon {
  font-size: 44rpx;
  line-height: 1;
}
.lobby-header-text {
  display: flex;
  flex-direction: column;
}
.lobby-title-tag-row {
  display: flex;
  align-items: center;
}
.lobby-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5A4636;
  line-height: 1.2;
}
.lobby-top-badge {
  font-size: 18rpx;
  color: #E65100;
  background: #FFF3E0;
  border: 1rpx solid #FFE0B2;
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  font-weight: 600;
}
.lobby-sub {
  font-size: 20rpx;
  color: #B39B8A;
  margin-top: 6rpx;
}

.games-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.game-card {
  padding: 20rpx 20rpx;
  margin-bottom: 0;
  border-radius: 24rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.game-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(191, 166, 154, 0.15);
}
.game-card-main {
  display: flex;
  align-items: center;
}
.game-icon-box {
  width: 90rpx;
  height: 90rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.box-gobang {
  background: linear-gradient(135deg, #FFDEE9 0%, #B5FFFC 100%);
  box-shadow: 0 6rpx 16rpx rgba(181, 255, 252, 0.45);
}
.box-weiqi {
  background: linear-gradient(135deg, #FFE082 0%, #FFB300 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 179, 0, 0.35);
}
.box-xiangqi {
  background: linear-gradient(135deg, #FFCDD2 0%, #E57373 100%);
  box-shadow: 0 6rpx 16rpx rgba(229, 115, 115, 0.35);
}
.box-chess {
  background: linear-gradient(135deg, #CFD8DC 0%, #90A4AE 100%);
  box-shadow: 0 6rpx 16rpx rgba(144, 164, 174, 0.35);
}
.game-card-emoji {
  font-size: 50rpx;
  line-height: 1;
}

.game-card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.game-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.game-title-group {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.game-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #5A4636;
  white-space: nowrap;
}
.game-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  font-weight: 600;
  white-space: nowrap;
}
.badge-active {
  background: #FFF0F3;
  color: #E91E63;
  border: 1rpx solid #FFCDD2;
}
.badge-hot {
  background: #FFF3E0;
  color: #E65100;
  border: 1rpx solid #FFE0B2;
}
.badge-popular {
  background: #E8F5E9;
  color: #2E7D32;
  border: 1rpx solid #C8E6C9;
}
.badge-intel {
  background: #E3F2FD;
  color: #1565C0;
  border: 1rpx solid #BBDEFB;
}
.badge-strategy {
  background: #EDE7F6;
  color: #512DA8;
  border: 1rpx solid #D1C4E9;
}

.btn-play {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF0F3 0%, #FFE4E9 100%);
  color: #E91E63;
  border: 1.5rpx solid #FFCDD2;
  border-radius: 20rpx;
  padding: 4rpx 14rpx 4rpx 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(244, 143, 177, 0.15);
  flex-shrink: 0;
  transition: all 0.15s ease;
}
.btn-play:active {
  transform: scale(0.92);
  background: #FFCDD2;
}
.btn-play-text {
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}
.btn-play-arrow {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  margin-left: 4rpx;
  color: #F48FB1;
}

.game-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}
.game-status-tag {
  font-size: 20rpx;
  color: #9E8574;
  display: inline-flex;
  align-items: center;
}
.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #BDBDBD;
  margin-right: 8rpx;
}
.tag-my-turn {
  color: #2E7D32;
  font-weight: 700;
}
.tag-my-turn .status-dot {
  background: #4CAF50;
  box-shadow: 0 0 6rpx #4CAF50;
  animation: pulseDot 1.2s infinite;
}
@keyframes pulseDot {
  0% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0.5; }
}

/* ================= 游戏对战界面通用样式 ================= */
.top-nav-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
}
.back-btn {
  display: flex;
  align-items: center;
  color: #7A604D;
  padding: 6rpx 12rpx 6rpx 0;
}
.back-arrow {
  font-size: 40rpx;
  line-height: 1;
  margin-right: 4rpx;
  color: #F48FB1;
  font-weight: bold;
}
.back-text {
  font-size: 24rpx;
  font-weight: 600;
}
.current-game-title {
  display: flex;
  align-items: center;
}
.cg-emoji {
  font-size: 32rpx;
  margin-right: 8rpx;
}
.cg-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #5A4636;
}
.refresh-pill {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF0F3;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #FFDCE5;
}
.rp-icon {
  font-size: 26rpx;
}

/* 玩家卡片 */
.player-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
}
.player-side {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 12rpx;
  border-radius: 20rpx;
  transition: background 0.2s ease;
}
.player-side.right-side {
  flex-direction: row-reverse;
}
.player-side.turn-active {
  background: #FFF0F3;
  box-shadow: 0 0 12rpx rgba(244, 143, 177, 0.4);
}

.player-avatar-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 头像上方网络情况微型标签 */
.net-badge {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
  margin-bottom: 6rpx;
  font-size: 16rpx;
  line-height: 1.2;
  font-weight: 700;
  transition: all 0.3s ease;
}
.net-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}
.net-good {
  background: #E8F5E9;
  color: #2E7D32;
  border: 1rpx solid #C8E6C9;
}
.net-good .net-dot {
  background: #4CAF50;
  box-shadow: 0 0 6rpx #4CAF50;
}
.net-warn {
  background: #FFF8E1;
  color: #F57F17;
  border: 1rpx solid #FFE082;
}
.net-warn .net-dot {
  background: #FFB300;
  box-shadow: 0 0 6rpx #FFB300;
}
.net-bad {
  background: #FFEBEE;
  color: #C62828;
  border: 1rpx solid #FFCDD2;
}
.net-bad .net-dot {
  background: #E53935;
}
.net-solo {
  background: #F5F5F5;
  color: #9E9E9E;
  border: 1rpx solid #E0E0E0;
}
.net-solo .net-dot {
  background: #BDBDBD;
}

.player-avatar-wrap {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #F5EAE1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.player-avatar-emoji {
  font-size: 38rpx;
}
.player-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.stone-badge {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 16rpx;
  white-space: nowrap;
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  font-weight: 700;
}
.black-badge {
  background: #212121;
  color: #FFFFFF;
}
.white-badge {
  background: #FFFFFF;
  color: #333333;
  border: 1rpx solid #BDBDBD;
}
.red-badge {
  background: #D32F2F;
  color: #FFFFFF;
}
.p1-badge {
  background: #E91E63;
  color: #FFFFFF;
}
.p2-badge {
  background: #0288D1;
  color: #FFFFFF;
}

.player-info {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}
.player-info.right-info {
  margin-left: 0;
  margin-right: 16rpx;
  align-items: flex-end;
}
.player-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #5A4636;
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.player-sub {
  font-size: 20rpx;
  color: #A89282;
  margin-top: 4rpx;
}
.vs-divider {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 16rpx;
}
.live-sync-pill {
  display: inline-flex;
  align-items: center;
  background: rgba(76, 175, 80, 0.12);
  border: 1rpx solid rgba(76, 175, 80, 0.3);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  margin-bottom: 4rpx;
}
.live-pulse-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #4CAF50;
  margin-right: 6rpx;
  animation: pulseDot 1.2s infinite;
}
.live-text {
  font-size: 16rpx;
  color: #2E7D32;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.vs-text {
  font-size: 28rpx;
  font-weight: 900;
  color: #F48FB1;
  letter-spacing: 2rpx;
}
.turn-indicator {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
}
.turn-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4CAF50;
  margin-right: 6rpx;
  animation: pulse 1.2s infinite;
}
@keyframes pulse {
  0% { opacity: 0.4; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
  100% { opacity: 0.4; transform: scale(0.8); }
}
.turn-text {
  font-size: 18rpx;
  color: #4CAF50;
  font-weight: 600;
  white-space: nowrap;
}
.game-over-tag {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #E91E63;
  white-space: nowrap;
}

/* 提示条 */
.status-banner {
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.banner-left {
  display: flex;
  align-items: center;
  flex: 1;
}
.my-turn-bg {
  background: #E8F5E9;
  border: 1rpx solid #C8E6C9;
}
.wait-turn-bg {
  background: #FFF8E1;
  border: 1rpx solid #FFE082;
}
.banner-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}
.banner-text {
  font-size: 24rpx;
  color: #5A4636;
  font-weight: 600;
}
.mode-switch-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(122, 96, 77, 0.1);
  color: #7A604D;
  font-weight: 700;
  transition: all 0.2s ease;
}
.badge-free-active {
  background: #E1BEE7;
  color: #6A1B9A;
  box-shadow: 0 2rpx 8rpx rgba(106, 27, 154, 0.2);
}

/* 围棋路数与自由落子选色条 */
.weiqi-size-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 8rpx 16rpx;
}
.size-label {
  font-size: 22rpx;
  color: #7A604D;
  font-weight: 700;
  margin-right: 12rpx;
}
.size-pill-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.size-pill {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #7A604D;
  background: #FFFFFF;
  border: 1rpx solid rgba(122, 96, 77, 0.2);
  transition: all 0.2s ease;
}
.size-pill-active {
  background: #795548;
  color: #FFFFFF;
  border-color: #795548;
  box-shadow: 0 2rpx 6rpx rgba(121, 85, 72, 0.3);
}
.free-color-pill {
  display: flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(122, 96, 77, 0.2);
  font-size: 20rpx;
  color: #5A4636;
  font-weight: 600;
}
.free-color-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.free-dot-black {
  background: #111111;
}
.free-dot-white {
  background: #FFFFFF;
  border: 1rpx solid #9E9E9E;
}

/* 棋盘木纹背景容器（五子棋 & 围棋） */
.board-container {
  padding: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: radial-gradient(circle, #F7E4B8 0%, #E6CA8C 100%);
  border: 4rpx solid #B89255;
  box-shadow: inset 0 0 20rpx rgba(120, 80, 20, 0.25), 0 8rpx 24rpx rgba(191, 166, 154, 0.25);
  border-radius: 28rpx;
}
.board-wood {
  position: relative;
  width: 650rpx;
  height: 650rpx;
  box-sizing: border-box;
}

.grid-lines {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}
.grid-h-line {
  position: absolute;
  left: 0; right: 0;
  height: 2rpx;
  background-color: #795548;
  transform: translateY(-50%);
}
.grid-v-line {
  position: absolute;
  top: 0; bottom: 0;
  width: 2rpx;
  background-color: #795548;
  transform: translateX(-50%);
}
.star-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #5D4037;
  transform: translate(-50%, -50%);
}
.board-intersections {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}
.intersection-point {
  position: absolute;
  width: 44rpx;
  height: 44rpx;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.piece {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  box-sizing: border-box;
}
/* 9路棋盘：格子宽敞，棋子稍大 */
.board-size-9 .piece {
  width: 52rpx;
  height: 52rpx;
}
/* 13路棋盘 */
.board-size-13 .piece {
  width: 42rpx;
  height: 42rpx;
}
/* 19路棋盘：线条密集，棋子精巧 */
.board-size-19 .piece {
  width: 28rpx;
  height: 28rpx;
}
.board-size-19 .star-dot {
  width: 6rpx;
  height: 6rpx;
}
.piece-black {
  background: radial-gradient(circle at 35% 35%, #4B4B4B 0%, #1A1A1A 60%, #000000 100%);
  box-shadow: 2rpx 4rpx 6rpx rgba(0, 0, 0, 0.55);
}
.piece-white {
  background: radial-gradient(circle at 35% 35%, #FFFFFF 0%, #ECEFF1 65%, #CFD8DC 100%);
  box-shadow: 2rpx 4rpx 6rpx rgba(0, 0, 0, 0.35);
  border: 1rpx solid #B0BEC5;
}
.piece-last {
  animation: pieceDrop 0.2s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}
@keyframes pieceDrop {
  0% { transform: scale(1.3); }
  100% { transform: scale(1); }
}
.last-move-marker {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #F44336;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 6rpx #F44336;
}

/* 准星十字与半透明候选落点 */
.aim-cursor-wrap {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 48rpx;
  height: 48rpx;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
}
.aim-crosshair-h {
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  height: 2rpx;
  background: #E91E63;
  box-shadow: 0 0 4rpx #E91E63;
}
.aim-crosshair-v {
  position: absolute;
  top: -8rpx;
  bottom: -8rpx;
  width: 2rpx;
  background: #E91E63;
  box-shadow: 0 0 4rpx #E91E63;
}
.aim-ghost-piece {
  opacity: 0.65;
  animation: ghostPulse 1s infinite alternate;
}
@keyframes ghostPulse {
  0% { transform: scale(0.9); opacity: 0.5; }
  100% { transform: scale(1.1); opacity: 0.85; }
}

/* 准星微调操作手柄 */
.cursor-pad {
  margin-top: 16rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.pad-nav-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pad-btn {
  width: 64rpx;
  height: 64rpx;
  background: #F5F0EB;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #7A604D;
  font-weight: bold;
  border: 1rpx solid rgba(122, 96, 77, 0.2);
}
.pad-btn:active {
  background: #E6DDD5;
}
.pad-action-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pad-confirm-btn, .pad-cancel-btn {
  margin: 0;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 28rpx;
  line-height: 1.4;
  border: none;
}
.pad-confirm-btn {
  background: #4CAF50;
  color: #FFFFFF;
}
.pad-confirm-btn:active {
  background: #388E3C;
}
.pad-cancel-btn {
  background: #ECEFF1;
  color: #607D8B;
}

/* ================= 中国象棋专属样式 ================= */
.xiangqi-container {
  padding: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: radial-gradient(circle, #FBF4E6 0%, #EFE1C3 100%);
  border: 4rpx solid #B89255;
  box-shadow: inset 0 0 20rpx rgba(120, 80, 20, 0.2), 0 8rpx 24rpx rgba(191, 166, 154, 0.25);
  border-radius: 28rpx;
}
.xiangqi-board {
  position: relative;
  width: 650rpx;
  height: 730rpx;
  box-sizing: border-box;
  margin: 10rpx 0;
}
/* 横线 */
.xq-grid-h-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background-color: #8D6E63;
  transform: translateY(-50%);
}
/* 竖线（半截） */
.xq-grid-v-line {
  position: absolute;
  width: 2rpx;
  background-color: #8D6E63;
  transform: translateX(-50%);
}
.xq-v-top {
  top: 0;
  height: calc(4 * 100% / 9);
}
.xq-v-bottom {
  top: calc(5 * 100% / 9);
  height: calc(4 * 100% / 9);
}
/* 左右贯通边线 */
.xq-border-v-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background-color: #8D6E63;
  transform: translateX(-50%);
}
/* 九宫格斜线 */
.xq-palace-line {
  position: absolute;
  background-color: #8D6E63;
}
.palace-slash-1 {
  left: calc(3 * 100% / 8);
  top: 0;
  width: calc(2 * 100% / 8 * 1.414);
  height: 2rpx;
  transform-origin: 0 0;
  transform: rotate(45deg);
}
.palace-backslash-1 {
  left: calc(5 * 100% / 8);
  top: 0;
  width: calc(2 * 100% / 8 * 1.414);
  height: 2rpx;
  transform-origin: 0 0;
  transform: rotate(135deg);
}
.palace-slash-2 {
  left: calc(3 * 100% / 8);
  top: calc(7 * 100% / 9);
  width: calc(2 * 100% / 8 * 1.414);
  height: 2rpx;
  transform-origin: 0 0;
  transform: rotate(45deg);
}
.palace-backslash-2 {
  left: calc(5 * 100% / 8);
  top: calc(7 * 100% / 9);
  width: calc(2 * 100% / 8 * 1.414);
  height: 2rpx;
  transform-origin: 0 0;
  transform: rotate(135deg);
}
/* 楚河汉界 */
.xq-river {
  position: absolute;
  top: calc(4 * 100% / 9);
  height: calc(100% / 9);
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  pointer-events: none;
}
.river-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #A1887F;
  letter-spacing: 16rpx;
  padding-left: 16rpx;
}

/* 交叉点与棋子 */
.xq-intersections {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}
.xq-point {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  transform: translate(-50%, -50%);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 5;
}
.xq-piece {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #FFFDF9 0%, #F5E8D3 70%, #E6D0B3 100%);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.28), inset 0 2rpx 4rpx #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #B89255;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.xq-piece-char {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}
.xq-piece-red {
  border-color: #D32F2F;
}
.xq-piece-red .xq-piece-char {
  color: #D32F2F;
}
.xq-piece-black {
  border-color: #212121;
}
.xq-piece-black .xq-piece-char {
  color: #212121;
}
.xq-piece-selected {
  transform: scale(1.15) translateY(-6rpx);
  box-shadow: 0 8rpx 18rpx rgba(233, 30, 99, 0.45), 0 0 16rpx #E91E63;
  border-color: #E91E63 !important;
}
.xq-piece-last {
  box-shadow: 0 0 14rpx #FF9800, 0 4rpx 8rpx rgba(0, 0, 0, 0.28);
}
.xq-last-from-box {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx dashed #FFA726;
  border-radius: 50%;
  pointer-events: none;
}

/* 合法落点标记 */
.valid-marker {
  position: absolute;
  pointer-events: none;
}
.valid-move-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(76, 175, 80, 0.75);
  box-shadow: 0 0 8rpx #4CAF50;
  animation: pulseDot 1.2s infinite ease-in-out alternate;
}
.valid-capture-ring {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  border: 4rpx solid #E53935;
  box-shadow: 0 0 10rpx #E53935;
  animation: pulseRing 1.2s infinite ease-in-out alternate;
}
@keyframes pulseDot {
  0% { transform: scale(0.8); opacity: 0.6; }
  100% { transform: scale(1.2); opacity: 1; }
}
@keyframes pulseRing {
  0% { transform: scale(0.95); opacity: 0.7; }
  100% { transform: scale(1.1); opacity: 1; }
}

/* ================= 国际象棋专属样式 ================= */
.chess-container {
  padding: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #EFEBE9;
  border: 4rpx solid #8D6E63;
  box-shadow: inset 0 0 16rpx rgba(93, 64, 55, 0.2), 0 8rpx 24rpx rgba(191, 166, 154, 0.25);
  border-radius: 28rpx;
}
.chess-board {
  width: 650rpx;
  height: 650rpx;
  display: flex;
  flex-direction: column;
  border: 4rpx solid #5D4037;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}
.chess-row {
  flex: 1;
  display: flex;
}
.chess-cell {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s ease;
}
.cell-light {
  background-color: #F0D9B5;
}
.cell-dark {
  background-color: #B58863;
}
.cell-selected {
  background-color: rgba(233, 30, 99, 0.35) !important;
}
.cell-last {
  background-color: rgba(255, 193, 7, 0.4) !important;
}
.chess-piece {
  font-size: 52rpx;
  line-height: 1;
  user-select: none;
}
.piece-white-chess {
  color: #FFFFFF;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.6), 0 0 2rpx #000000;
}
.piece-black-chess {
  color: #263238;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.35);
}
.chess-last-from-marker {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx dashed #FFA000;
  border-radius: 50%;
  pointer-events: none;
}
.chess-move-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(76, 175, 80, 0.8);
  box-shadow: 0 0 8rpx #4CAF50;
  animation: pulseDot 1.2s infinite ease-in-out alternate;
}
.chess-capture-ring {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 4rpx solid #E53935;
  box-shadow: 0 0 10rpx #E53935;
  animation: pulseRing 1.2s infinite ease-in-out alternate;
}

/* 操作按钮区 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.btn-sub, .btn-main {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 36rpx;
  padding: 16rpx 0;
  margin: 0;
  line-height: 1.5;
  border: none;
  box-sizing: border-box;
}
.btn-sub {
  background: #FFFFFF;
  color: #7A604D;
  border: 2rpx solid rgba(244, 143, 177, 0.4);
}
.btn-sub:active {
  background: #FFF5F7;
}
.btn-undo {
  color: #1976D2;
  border-color: rgba(25, 118, 210, 0.35);
}
.btn-undo:active {
  background: #E3F2FD;
}
.btn-danger {
  color: #E53935;
  border-color: rgba(229, 57, 53, 0.3);
}
.btn-danger:active {
  background: #FFEBEE;
}
.btn-main {
  background: linear-gradient(135deg, #FF80AB 0%, #F48FB1 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.4);
}
.btn-main:active {
  transform: scale(0.97);
}
