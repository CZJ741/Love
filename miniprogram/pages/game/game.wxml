<view class="page game-page">
  <!-- ================= 模式一：游戏大厅选定游戏列表 ================= -->
  <view wx:if="{{currentView === 'lobby'}}" class="lobby-view">
    <!-- 大厅顶部横幅 -->
    <view class="lobby-header card">
      <view class="lobby-title-row">
        <view class="lobby-icon-wrap">
          <text class="lobby-icon">🎮</text>
        </view>
        <view class="lobby-header-text">
          <view class="lobby-title-tag-row">
            <text class="lobby-title">双人游戏大厅</text>
            <text class="badge-tag">实时对弈</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 游戏卡片列表（四大经典对战） -->
    <view class="game-list">
      <!-- 1. 五子棋卡片 -->
      <view class="game-card card" data-type="gobang" bindtap="selectGame">
        <view class="game-card-main">
          <view class="game-icon-box box-gobang">
            <text class="game-card-emoji">⚪⚫</text>
          </view>
          <view class="game-card-content">
            <view class="game-card-header">
              <view class="game-title-group">
                <text class="game-name">五子棋</text>
                <text class="game-badge badge-popular">经典必玩</text>
              </view>
              <view class="btn-play">
                <text class="btn-play-text">开始</text>
                <text class="btn-play-arrow">›</text>
              </view>
            </view>
            <view class="game-footer">
              <view class="game-status-tag {{lobbyStatus.gobang.isMyTurn ? 'tag-my-turn' : ''}}">
                <text class="status-dot"></text>
                <text>{{lobbyStatus.gobang.statusText || '等待开始'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 2. 围棋卡片 -->
      <view class="game-card card" data-type="weiqi" bindtap="selectGame">
        <view class="game-card-main">
          <view class="game-icon-box box-weiqi">
            <text class="game-card-emoji">☯️</text>
          </view>
          <view class="game-card-content">
            <view class="game-card-header">
              <view class="game-title-group">
                <text class="game-name">围棋</text>
                <text class="game-badge badge-intel">13路快棋</text>
              </view>
              <view class="btn-play">
                <text class="btn-play-text">开始</text>
                <text class="btn-play-arrow">›</text>
              </view>
            </view>
            <view class="game-footer">
              <view class="game-status-tag {{lobbyStatus.weiqi.isMyTurn ? 'tag-my-turn' : ''}}">
                <text class="status-dot"></text>
                <text>{{lobbyStatus.weiqi.statusText || '等待开始'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 3. 中国象棋卡片 -->
      <view class="game-card card" data-type="xiangqi" bindtap="selectGame">
        <view class="game-card-main">
          <view class="game-icon-box box-xiangqi">
            <text class="game-card-emoji">🏮</text>
          </view>
          <view class="game-card-content">
            <view class="game-card-header">
              <view class="game-title-group">
                <text class="game-name">中国象棋</text>
                <text class="game-badge badge-hot">楚河汉界</text>
              </view>
              <view class="btn-play">
                <text class="btn-play-text">开始</text>
                <text class="btn-play-arrow">›</text>
              </view>
            </view>
            <view class="game-footer">
              <view class="game-status-tag {{lobbyStatus.xiangqi.isMyTurn ? 'tag-my-turn' : ''}}">
                <text class="status-dot"></text>
                <text>{{lobbyStatus.xiangqi.statusText || '等待开始'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 4. 国际象棋卡片 -->
      <view class="game-card card" data-type="chess" bindtap="selectGame">
        <view class="game-card-main">
          <view class="game-icon-box box-chess">
            <text class="game-card-emoji">♚</text>
          </view>
          <view class="game-card-content">
            <view class="game-card-header">
              <view class="game-title-group">
                <text class="game-name">国际象棋</text>
                <text class="game-badge badge-strategy">西洋棋博弈</text>
              </view>
              <view class="btn-play">
                <text class="btn-play-text">开始</text>
                <text class="btn-play-arrow">›</text>
              </view>
            </view>
            <view class="game-footer">
              <view class="game-status-tag {{lobbyStatus.chess.isMyTurn ? 'tag-my-turn' : ''}}">
                <text class="status-dot"></text>
                <text>{{lobbyStatus.chess.statusText || '等待开始'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ================= 模式二：选定游戏后的对战界面 ================= -->
  <view wx:else class="play-view">
    <!-- 顶部导航栏 -->
    <view class="card top-nav-card">
      <view class="back-btn" bindtap="backToLobby">
        <text class="back-arrow">‹</text>
        <text class="back-text">返回大厅</text>
      </view>
      <view class="current-game-title">
        <text class="cg-emoji">{{gameMeta.emoji}}</text>
        <text class="cg-text">{{gameMeta.title}}</text>
      </view>
      <view class="nav-placeholder"></view>
    </view>

    <!-- 双方对弈玩家状态 -->
    <view class="card player-card">
      <view class="player-side {{isP1Turn ? 'turn-active' : ''}}">
        <!-- 玩家1头像与网络状态 -->
        <view class="player-avatar-column">
          <view class="net-badge net-{{player1NetStatus.level}}">
            <text class="net-dot"></text>
            <text class="net-label">{{player1NetStatus.text}}</text>
          </view>
          <view class="player-avatar-wrap">
            <text wx:if="{{!blackUser.avatar || blackUser.avatar.length <= 2}}" class="player-avatar-emoji">{{blackUser.avatar || '🔴'}}</text>
            <image wx:else class="player-avatar-img" src="{{blackUser.avatar}}" mode="aspectFill" />
            <view class="stone-badge {{currentGameType === 'xiangqi' ? 'red-badge' : (currentGameType === 'chess' ? 'white-badge' : 'black-badge')}}">
              {{currentGameType === 'xiangqi' ? '执红' : (currentGameType === 'chess' ? '执白' : '执黑')}}
            </view>
          </view>
        </view>
        <view class="player-info">
          <view class="player-name">{{blackUser.nickname || '玩家一'}} {{isP1 ? '(我)' : ''}}</view>
          <view wx:if="{{currentGameType === 'weiqi'}}" class="player-sub">提子: {{game.blackCaptures || 0}}</view>
          <view wx:else class="player-sub">先行行动</view>
        </view>
      </view>

      <view class="vs-divider">
        <view class="live-sync-pill">
          <text class="live-pulse-dot"></text>
          <text class="live-text">实时同步</text>
        </view>
        <text class="vs-text">VS</text>
        <view wx:if="{{game.status === 'playing'}}" class="turn-indicator">
          <text class="turn-dot"></text>
          <text class="turn-text">{{isMyTurn ? '轮到你' : '等待TA'}}</text>
        </view>
        <view wx:else class="game-over-tag">
          <text wx:if="{{game.status === 'draw'}}">双方和棋</text>
          <text wx:elif="{{isWon}}">🎉 你获胜！</text>
          <text wx:else>TA获胜啦~</text>
        </view>
      </view>

      <view class="player-side {{isP2Turn ? 'turn-active' : ''}} right-side">
        <!-- 玩家2头像与网络状态 -->
        <view class="player-avatar-column">
          <view class="net-badge net-{{player2NetStatus.level}}">
            <text class="net-dot"></text>
            <text class="net-label">{{player2NetStatus.text}}</text>
          </view>
          <view class="player-avatar-wrap">
            <text wx:if="{{!whiteUser.avatar || whiteUser.avatar.length <= 2}}" class="player-avatar-emoji">{{whiteUser.avatar || '🔵'}}</text>
            <image wx:else class="player-avatar-img" src="{{whiteUser.avatar}}" mode="aspectFill" />
            <view class="stone-badge {{currentGameType === 'xiangqi' ? 'black-badge' : (currentGameType === 'chess' ? 'black-badge' : 'white-badge')}}">
              {{currentGameType === 'xiangqi' ? '执黑' : (currentGameType === 'chess' ? '执黑' : '执白')}}
            </view>
          </view>
        </view>
        <view class="player-info right-info">
          <view class="player-name">{{whiteUser.nickname || (isSolo ? '单人演练' : '伴侣')}} {{(!isP1 && !isSolo) ? '(我)' : ''}}</view>
          <view wx:if="{{currentGameType === 'weiqi'}}" class="player-sub">提子: {{game.whiteCaptures || 0}}</view>
          <view wx:else class="player-sub">后手行动</view>
        </view>
      </view>
    </view>

    <!-- 提示横幅与辅助模式条 -->
    <view class="status-banner {{isMyTurn ? 'my-turn-bg' : 'wait-turn-bg'}}">
      <view class="banner-left">
        <text class="banner-icon">{{isMyTurn ? '✨' : '⏳'}}</text>
        <text class="banner-text">{{turnNoticeText}}</text>
      </view>
      <view class="mode-switch-badge {{isFreeMode ? 'badge-free-active' : ''}}" bindtap="onToggleFreeMode">
        <text>{{isFreeMode ? '自由摆棋' : '对战模式'}}</text>
      </view>
    </view>

    <!-- 围棋路数切换栏 -->
    <view wx:if="{{currentGameType === 'weiqi'}}" class="weiqi-size-bar">
      <view class="size-label">路数:</view>
      <view class="size-pill-group">
        <view
          wx:for="{{weiqiSizes}}"
          wx:key="*this"
          class="size-pill {{boardSize === item ? 'size-pill-active' : ''}}"
          data-size="{{item}}"
          bindtap="onSelectWeiqiSize"
        >
          <text>{{item}}路</text>
        </view>
      </view>
      <view wx:if="{{isFreeMode}}" class="free-color-pill" bindtap="onToggleFreePieceColor">
        <text class="free-color-dot {{freePieceColor === 'black' ? 'free-dot-black' : 'free-dot-white'}}"></text>
        <text>落{{freePieceColor === 'black' ? '黑子' : '白子'}}</text>
      </view>
    </view>

    <!-- ====== 子游戏 1 & 2：五子棋 / 围棋 棋盘 ====== -->
    <block wx:if="{{currentGameType === 'gobang' || currentGameType === 'weiqi'}}">
      <view class="card board-container">
        <view class="board-wood board-size-{{boardSize}}">
          <view class="grid-lines">
            <view
              wx:for="{{boardSize}}"
              wx:key="*this"
              class="grid-h-line"
              style="top: calc({{item}} * 100% / {{boardSize - 1}});"
            ></view>
            <view
              wx:for="{{boardSize}}"
              wx:key="*this"
              class="grid-v-line"
              style="left: calc({{item}} * 100% / {{boardSize - 1}});"
            ></view>
            <view
              wx:for="{{starPoints}}"
              wx:key="index"
              class="star-dot"
              style="left: calc({{item.c}} * 100% / {{boardSize - 1}}); top: calc({{item.r}} * 100% / {{boardSize - 1}});"
            ></view>
          </view>

          <view class="board-intersections">
            <block wx:for="{{board}}" wx:for-item="row" wx:for-index="r" wx:key="r">
              <view
                wx:for="{{row}}"
                wx:for-item="cell"
                wx:for-index="c"
                wx:key="c"
                class="intersection-point"
                style="left: calc({{c}} * 100% / {{boardSize - 1}}); top: calc({{r}} * 100% / {{boardSize - 1}});"
                data-r="{{r}}"
                data-c="{{c}}"
                bindtap="onCellTap"
              >
                <!-- 已落棋子 -->
                <view
                  wx:if="{{cell !== 0}}"
                  class="piece {{cell === 1 ? 'piece-black' : 'piece-white'}} {{game.lastMove && game.lastMove.r === r && game.lastMove.c === c ? 'piece-last' : ''}}"
                >
                  <view wx:if="{{game.lastMove && game.lastMove.r === r && game.lastMove.c === c}}" class="last-move-marker"></view>
                </view>

                <!-- 选点十字准星与半透明棋子 -->
                <view wx:if="{{cursorPos && cursorPos.r === r && cursorPos.c === c && cell === 0}}" class="aim-cursor-wrap">
                  <view class="aim-crosshair-h"></view>
                  <view class="aim-crosshair-v"></view>
                  <view class="aim-ghost-piece {{isFreeMode ? (freePieceColor === 'black' ? 'piece-black ghost-piece' : 'piece-white ghost-piece') : ((myRole === 'white' || game.currentTurn === 'white') ? 'piece-white ghost-piece' : 'piece-black ghost-piece')}}"></view>
                </view>
              </view>
            </block>
          </view>
        </view>
      </view>

      <!-- 落子高精微调手柄 (仅当准星存在且轮到行动时浮现) -->
      <view wx:if="{{cursorPos && isMyTurn}}" class="cursor-pad card">
        <view class="pad-nav-group">
          <view class="pad-btn" data-dr="0" data-dc="-1" bindtap="onMoveCursor">◀</view>
          <view class="pad-btn" data-dr="-1" data-dc="0" bindtap="onMoveCursor">▲</view>
          <view class="pad-btn" data-dr="1" data-dc="0" bindtap="onMoveCursor">▼</view>
          <view class="pad-btn" data-dr="0" data-dc="1" bindtap="onMoveCursor">▶</view>
        </view>
        <view class="pad-action-group">
          <button class="pad-confirm-btn" bindtap="confirmDropPiece">✔ 落子</button>
          <button class="pad-cancel-btn" bindtap="onCancelCursor">✕ 取消</button>
        </view>
      </view>
    </block>

    <!-- ====== 子游戏 3：中国象棋 棋盘 ====== -->
    <block wx:elif="{{currentGameType === 'xiangqi'}}">
      <view class="card xiangqi-container">
        <view class="xiangqi-board">
          <!-- 棋盘横线（10条） -->
          <view
            wx:for="{{xqRows}}"
            wx:key="*this"
            class="xq-grid-h-line"
            style="top: calc({{item}} * 100% / 9);"
          ></view>

          <!-- 棋盘竖线（上截半场 0~4 行，9条） -->
          <view
            wx:for="{{xqCols}}"
            wx:key="*this"
            class="xq-grid-v-line xq-v-top"
            style="left: calc({{item}} * 100% / 8);"
          ></view>

          <!-- 棋盘竖线（下截半场 5~9 行，9条） -->
          <view
            wx:for="{{xqCols}}"
            wx:key="*this"
            class="xq-grid-v-line xq-v-bottom"
            style="left: calc({{item}} * 100% / 8);"
          ></view>

          <!-- 棋盘左右两条完整贯通边线 -->
          <view class="xq-border-v-line" style="left: 0;"></view>
          <view class="xq-border-v-line" style="left: 100%;"></view>

          <!-- 九宫格斜线（黑方上方 0~2 行, 3~5 列） -->
          <view class="xq-palace-line palace-slash-1"></view>
          <view class="xq-palace-line palace-backslash-1"></view>

          <!-- 九宫格斜线（红方下方 7~9 行, 3~5 列） -->
          <view class="xq-palace-line palace-slash-2"></view>
          <view class="xq-palace-line palace-backslash-2"></view>

          <!-- 楚河汉界 -->
          <view class="xq-river">
            <text class="river-text">楚 河</text>
            <text class="river-text">漢 界</text>
          </view>

          <!-- 交叉点与棋子层 -->
          <view class="xq-intersections">
            <block wx:for="{{displayBoard}}" wx:for-item="row" wx:for-index="r" wx:key="r">
              <view
                wx:for="{{row}}"
                wx:for-item="cell"
                wx:for-index="c"
                wx:key="c"
                class="xq-point"
                style="left: calc({{c}} * 100% / 8); top: calc({{r}} * 100% / 9);"
                data-r="{{r}}"
                data-c="{{c}}"
                bindtap="onPieceOrCellTap"
              >
                <!-- 棋子本身 -->
                <view
                  wx:if="{{cell}}"
                  class="xq-piece {{cell.isRed ? 'xq-piece-red' : 'xq-piece-black'}} {{selectedPos && selectedPos.r === r && selectedPos.c === c ? 'xq-piece-selected' : ''}} {{game.lastMove && game.lastMove.toR === r && game.lastMove.toC === c ? 'xq-piece-last' : ''}}"
                >
                  <text class="xq-piece-char">{{cell.char}}</text>
                </view>

                <!-- 上一步起点标记 -->
                <view
                  wx:if="{{game.lastMove && game.lastMove.fromR === r && game.lastMove.fromC === c}}"
                  class="xq-last-from-box"
                ></view>

                <!-- 合法走棋高亮提示点 -->
                <block wx:for="{{validMoves}}" wx:for-item="move" wx:key="index">
                  <view
                    wx:if="{{move.r === r && move.c === c}}"
                    class="valid-marker {{move.isCapture ? 'valid-capture-ring' : 'valid-move-dot'}}"
                  ></view>
                </block>
              </view>
            </block>
          </view>
        </view>
      </view>
    </block>

    <!-- ====== 子游戏 4：国际象棋 棋盘 ====== -->
    <block wx:elif="{{currentGameType === 'chess'}}">
      <view class="card chess-container">
        <view class="chess-board">
          <block wx:for="{{displayBoard}}" wx:for-item="row" wx:for-index="r" wx:key="r">
            <view class="chess-row">
              <view
                wx:for="{{row}}"
                wx:for-item="cell"
                wx:for-index="c"
                wx:key="c"
                class="chess-cell {{(r + c) % 2 === 0 ? 'cell-light' : 'cell-dark'}} {{selectedPos && selectedPos.r === r && selectedPos.c === c ? 'cell-selected' : ''}} {{game.lastMove && game.lastMove.toR === r && game.lastMove.toC === c ? 'cell-last' : ''}}"
                data-r="{{r}}"
                data-c="{{c}}"
                bindtap="onPieceOrCellTap"
              >
                <!-- 棋子 -->
                <text
                  wx:if="{{cell}}"
                  class="chess-piece {{cell.isWhite ? 'piece-white-chess' : 'piece-black-chess'}}"
                >{{cell.char}}</text>

                <!-- 上一步起点标记 -->
                <view
                  wx:if="{{game.lastMove && game.lastMove.fromR === r && game.lastMove.fromC === c}}"
                  class="chess-last-from-marker"
                ></view>

                <!-- 可走提示标记 -->
                <block wx:for="{{validMoves}}" wx:for-item="move" wx:key="index">
                  <view
                    wx:if="{{move.r === r && move.c === c}}"
                    class="valid-marker {{move.isCapture ? 'chess-capture-ring' : 'chess-move-dot'}}"
                  ></view>
                </block>
              </view>
            </view>
          </block>
        </view>
      </view>
    </block>

    <!-- 操作按钮栏 -->
    <view class="action-bar">
      <button wx:if="{{game.history && game.history.length > 0}}" class="btn-sub btn-undo" bindtap="onUndo">↺ 悔棋</button>
      <button wx:if="{{currentGameType === 'weiqi' && isMyTurn}}" class="btn-sub" bindtap="onPass">🏳️ 停一手</button>
      <button wx:if="{{game.status === 'playing'}}" class="btn-sub btn-danger" bindtap="onResign">🏳️ 认输</button>
      <button class="btn-main" bindtap="onResetGame">✨ 新开一局</button>
    </view>
  </view>
</view>
