}

.fmm-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}
.fmm-reset-btn {
  flex: 1;
  font-size: 26rpx;
}
.fmm-done-btn {
  flex: 1;
  font-size: 26rpx;
}

/* ================= 在一起时间卡片与 Live2D 桌宠小狗 ================= */
.together-card.with-pet {
  position: relative;
  overflow: visible; /* 保持原边距与结构完全不受影响 */
}

/* 浮动桌宠层：浮现在卡片之上，紧贴卡片下边缘，不遮挡卡片文字，不挤占内部空间 */
.together-pet-float {
  position: absolute;
  bottom: -46rpx; /* 紧贴下边缘，萌宠小爪搭在卡片下边界上 */
  right: 24rpx;   /* 靠右放置，完美避开卡片正中央的「在一起时间」天数与文字 */
  width: 150rpx;
  height: 150rpx;
  z-index: 10;
  pointer-events: auto;
}

/* 宠物养成互动弹窗 */
.pet-manage-modal {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx 28rpx 32rpx;
  width: 660rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.18);
  animation: modalPop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.pmm-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.pmm-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5A4636;
}
.pmm-close {
  font-size: 32rpx;
