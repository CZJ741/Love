/* ── 家 ── */

/* 页面容器 */
.page.home {
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 浮动文字：积分变动时从顶部滑入、渐变消失 */
.balance-toast {
  position: fixed;
  top: 30rpx;
  left: 50%;
  transform: translateX(-50%) translateY(-80rpx);
  z-index: 300;
  background: linear-gradient(135deg, #F48FB1, #FFCC80);
  color: #FFF;
  font-size: 36rpx;
  font-weight: 800;
  font-family: 'DIN Alternate', 'Bahnschrift', monospace;
  padding: 18rpx 44rpx;
  border-radius: 50rpx;
  box-shadow: 0 16rpx 40rpx rgba(244, 143, 177, 0.40);
  opacity: 0;
  pointer-events: none;
  transition: all 0.30s ease;
}
.balance-toast.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

/* 冷暴力预警 */
.cold-banner {
  display: flex; align-items: center;
  background: #FFEBED; border-radius: 24rpx;
  padding: 20rpx 26rpx; margin-bottom: 24rpx;
}
.cold-cloud { font-size: 50rpx; margin-right: 20rpx; filter: grayscale(1); }
.cold-title { font-size: 28rpx; font-weight: 600; color: #7A6A5E; }
.cold-sub { font-size: 24rpx; color: #A89A8E; margin-top: 2rpx; }

/* ── 双人拼图头像卡 ── */
.puzzle-card { padding: 26rpx 28rpx 16rpx; }
.hello-row { display: flex; align-items: center; justify-content: space-between; }
.hello { font-size: 34rpx; font-weight: 700; color: #5A4636; }
.hello-main {  }
.hello-sub { font-size: 22rpx; font-weight: 400; color: #B39B8A; margin-top: 4rpx; }

/* 头部右侧胶囊按钮组合 */
.hello-chips {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.room-chip {
  display: flex; align-items: center;
  background: #FFEBED; border-radius: 999rpx;
  padding: 6rpx 18rpx; font-size: 22rpx;
  box-sizing: border-box;
}
.room-chip:active { background: #FFCC80; }
.room-hash { color: #F48FB1; font-weight: 700; margin-right: 4rpx; }
.room-chip .num { font-size: 22rpx; color: #F48FB1; font-weight: 600; letter-spacing: 1rpx; }

/* 签到胶囊：大小与小窝胶囊完全一致 */
.room-chip.sign-chip {
  background: linear-gradient(135deg, #FFF0F3, #FFEAE0);
  border: 1rpx solid #FFD1DA;
}
.room-chip.sign-chip:active {
  background: #FFCC80;
  transform: scale(0.96);
}

/* 邀请按钮（button 重置） */
.room-chip.invite-chip {
  border: none;
  line-height: 1.4;
  padding: 6rpx 18rpx;
  margin: 0;
}
.room-chip.invite-chip::after { border: none; }

/* 拼图头像：两个圆交错重叠 */
.puzzle-avatars {
  display: flex; justify-content: center; align-items: center;
  margin: 24rpx 0 38rpx;
}
.puzzle-ava-wrap {
  position: relative;
}
.puzzle-ava-wrap:first-child { z-index: 2; margin-right: -29rpx; }
.puzzle-ava-wrap:last-child { z-index: 1; }
.praise-hint {
  position: absolute; bottom: -16rpx; left: 50%; transform: translateX(-50%);
  font-size: 20rpx; color: #F48FB1; background: #FFEBED;
  padding: 4rpx 16rpx; border-radius: 999rpx; white-space: nowrap;
  opacity: 0.8;
}

/* 在线状态：呼吸小圆点 */
.online-dot {
  position: absolute;
  right: -2rpx;
  bottom: 8rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 4rpx solid #FFF;
  box-sizing: border-box;
  z-index: 3;
}
.online-dot.online {
  background: #52D273;
  animation: onlineBreath 1.8s ease-in-out infinite;
}
.online-dot.offline {
  background: #C7C7CC;
}
@keyframes onlineBreath {
  0%, 100% { box-shadow: 0 0 0 0 rgba(82, 210, 115, 0.55); }
  50% { box-shadow: 0 0 0 12rpx rgba(82, 210, 115, 0); }
}

/* 上次在线时间（灰色小字） */
.last-seen {
  position: absolute;
  top: calc(100% + 24rpx);
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #B39B8A;
  white-space: nowrap;
  line-height: 1;
}
.puzzle-ava {
  width: 144rpx; height: 144rpx; border-radius: 50%;
  border: 4rpx solid #FFF;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.puzzle-ava.emoji {
  display: flex; align-items: center; justify-content: center;
  font-size: 86rpx; background: #FFEBED; line-height: 144rpx;
}

/* 积分余额 */
.puzzle-balances {
  display: flex; justify-content: space-around;
  margin-bottom: 8rpx;
}
.puzzle-bal {
  text-align: center;
  flex: 1;
  padding: 8rpx 0;
  border-radius: 20rpx;
  transition: box-shadow 0.6s ease;
}
.puzzle-bal.glow {
  animation: balanceGlow 0.8s ease;
}
@keyframes balanceGlow {
  0%   { box-shadow: 0 0 0 0 rgba(254, 229, 128, 0.6); }
  50%  { box-shadow: 0 0 32rpx 8rpx rgba(254, 229, 128, 0.45); }
  100% { box-shadow: 0 0 0 0 rgba(254, 229, 128, 0); }
}
.puzzle-bal-label {
  font-size: 24rpx; color: #B39B8A; margin-bottom: 6rpx;
}
.puzzle-bal-num {
  font-size: 44rpx; font-weight: 800; color: #F48FB1;
  font-family: 'DIN Alternate', 'Bahnschrift', monospace;
  letter-spacing: 2rpx;
}

/* 陪伴时长卡片（适当紧凑上移） */
.together-card {
  margin-top: -6rpx;
  margin-bottom: 20rpx;
}

/* 积分变动记录卡片 */
.tx-card {
  margin-bottom: 20rpx;
}

/* 约会盲盒卡片 */
.datebox-entry {
  margin-bottom: 20rpx;
}

/* 拼图挑战卡片 */
.puzzle-entry {
  margin-bottom: 20rpx;
}

/* 食物转盘卡片 */
.food-wheel-entry {
  margin-bottom: 20rpx;
}

/* 快捷加分 */
.chip.big { font-size: 32rpx; padding: 16rpx 34rpx; font-weight: 700; }
.reason-wrap {
  display: flex; flex-wrap: wrap;
  margin-bottom: 12rpx;
}

/* ── 积分变动记录（紧凑）── */
.tx-card { padding: 20rpx 24rpx; }
.tx-card-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 8rpx;
}
.tx-card-title {
  font-size: 26rpx; font-weight: 600; color: #8A6A58;
}
.tx-card-more {
  font-size: 22rpx; color: #C9B3A3;
}

.tx-list { /* no extra margin */ }
.tx-row {
  display: flex; align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F5EDE6;
}
.tx-row:last-child { border-bottom: none; }
.tx-row:active { background: #FFEBED; }

.tx-icon {
  font-size: 26rpx; flex-shrink: 0; margin-right: 10rpx;
}
.tx-reason {
  flex: 1; min-width: 0;
  font-size: 24rpx; color: #5A4636;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tx-to-user {
  font-size: 20rpx; color: #C9B3A3; flex-shrink: 0; margin-left: 6rpx;
  max-width: 100rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tx-val {
  font-size: 24rpx; font-weight: 700; flex-shrink: 0; margin-left: 10rpx;
}
.tx-time {
  font-size: 20rpx; color: #C9B3A3; flex-shrink: 0; margin-left: 8rpx;
}
.tx-empty {
  text-align: center; color: #D4C4B6; font-size: 22rpx; padding: 16rpx 0;
}

/* ── 快捷功能网格入口（一行三个） ── */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.feature-item {
  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 12rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(191, 166, 154, 0.12);
  border: 2rpx solid rgba(255, 235, 237, 0.8);
  transition: transform 0.15s ease, background 0.15s ease;
  box-sizing: border-box;
}
.feature-item:active {
  transform: scale(0.96);
  background: #FFF5F7;
}
.fi-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.fi-emoji {
  font-size: 42rpx;
  line-height: 1;
}

/* 4个不同主题渐变色 */
.fi-points {
  background: linear-gradient(135deg, #E1BEE7 0%, #BA68C8 100%);
  box-shadow: 0 4rpx 12rpx rgba(186, 104, 200, 0.35);
}
.fi-datebox {
  background: linear-gradient(135deg, #FFCDD2 0%, #F48FB1 100%);
  box-shadow: 0 4rpx 12rpx rgba(244, 143, 177, 0.35);
}
.fi-puzzle {
  background: linear-gradient(135deg, #FFDEE9 0%, #B5FFFC 100%);
  box-shadow: 0 4rpx 12rpx rgba(181, 255, 252, 0.4);
}
.fi-food {
  background: linear-gradient(135deg, #C8E6C9 0%, #81C784 100%);
  box-shadow: 0 4rpx 12rpx rgba(129, 199, 132, 0.35);
}
.fi-location {
  background: linear-gradient(135deg, #80DEEA 0%, #00ACC1 100%);
  box-shadow: 0 4rpx 12rpx rgba(0, 172, 193, 0.35);
}
.fi-pet {
  background: linear-gradient(135deg, #FFE082 0%, #FFB300 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 0, 0.35);
}

.fi-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #5A4636;
  line-height: 1.3;
  margin-bottom: 4rpx;
  white-space: nowrap;
}
.fi-desc {
  font-size: 20rpx;
  color: #B39B8A;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.fi-desc.highlight {
  color: #FF6B8B;
  font-weight: 600;
}
.fi-desc.done {
  color: #4CAF50;
  font-weight: 600;
}

.fi-dot {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF4081;
  box-shadow: 0 0 8rpx #FF4081;
}

/* ── 游戏大厅独占一行入口 ── */
.game-lobby-entry {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8FA 100%);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(244, 143, 177, 0.15);
  border: 2rpx solid rgba(255, 220, 230, 0.85);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  box-sizing: border-box;
}
.game-lobby-entry:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(244, 143, 177, 0.1);
}
.gle-left {
  display: flex;
  align-items: center;
}
.gle-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFE082 0%, #FFB300 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 179, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.gle-emoji {
  font-size: 46rpx;
  line-height: 1;
}
.gle-text {
  display: flex;
  flex-direction: column;
}
.gle-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}
.gle-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5A4636;
  line-height: 1.3;
}
.gle-tag {
  font-size: 20rpx;
  color: #E65100;
  background: #FFF3E0;
  border: 1rpx solid #FFE0B2;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  font-weight: 600;
}
.gle-desc {
  font-size: 22rpx;
  color: #A89282;
  line-height: 1.3;
}
.gle-right {
  display: flex;
  align-items: center;
}
.gle-arrow {
  font-size: 38rpx;
  color: #D4C4B6;
  font-weight: 300;
  line-height: 1;
}

/* 兼容保留历史样式（若有引用） */
.datebox-entry, .puzzle-entry, .food-wheel-entry {
  display: none;
}

/* 流水详情弹窗 */
.detail-grid { padding: 10rpx 0; }
.d-row {
  display: flex; justify-content: space-between; align-items: baseline;
  padding: 14rpx 0; border-bottom: 1rpx solid #F5EDE6;
}
.d-row:last-child { border-bottom: none; }
.d-label { font-size: 26rpx; color: #B39B8A; }
.d-val { font-size: 28rpx; color: #5A4636; text-align: right; flex: 1; margin-left: 20rpx; }

/* 房间切换弹窗 */
.room-info-block { text-align: center; padding: 10rpx 0; }
.room-info-label { font-size: 24rpx; color: #B39B8A; }
.room-info-num { font-size: 52rpx; font-weight: 800; color: #F48FB1; margin: 8rpx 0; letter-spacing: 4rpx; }
.room-info-tip { font-size: 22rpx; color: #C9B3A3; margin-bottom: 10rpx; }
.divider { height: 2rpx; background: #F5EDE6; margin: 20rpx 0 16rpx; }
.room-switch-input { margin-bottom: 4rpx; }

/* 房间列表 */
.room-list-scroll { max-height: 360rpx; margin: 8rpx 0; }
.room-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; margin: 6rpx 0;
  background: #FFEBED; border-radius: 12rpx; border: 2rpx solid transparent;
  transition: all 0.2s;
}
.room-item.selected { border-color: #F48FB1; background: #FFEBED; }
.room-item:active { background: #FFCC80; }
.ri-left { flex: 1; }
.ri-name { font-size: 28rpx; font-weight: 600; color: #5D4E3F; }
.ri-meta { font-size: 22rpx; color: #B39B8A; margin-top: 4rpx; }
.ri-arrow { font-size: 28rpx; color: #C9B3A3; }

/* 陪伴时长卡片 */
.together-card {
  position: relative; overflow: hidden;
  padding: 0; min-height: 200rpx;
  background: linear-gradient(135deg, #FFEBED 0%, #FFCC80 100%);
  border-radius: 24rpx;
  cursor: pointer;
}
.together-inner {
  padding: 32rpx 28rpx;
  position: relative; z-index: 1;
}
.together-line1 {
  font-size: 26rpx; color: rgba(0,0,0,0.45); margin-bottom: 12rpx;
}
.together-line2 {
  font-size: 64rpx; font-weight: 800; color: #5A4636;
  font-family: 'DIN Alternate', 'Bahnschrift', monospace;
  line-height: 1.1;
}
.together-pending {
  font-size: 56rpx;
  color: #B39B8A;
  font-weight: 700;
}
.together-unit {
  font-size: 32rpx; font-weight: 600; color: #8B7355; margin-left: 8rpx;
}
.together-line3 {
  font-size: 24rpx; color: rgba(0,0,0,0.35); margin-top: 16rpx;
}
.together-card.unlocked .together-line3 {
  color: #E91E63;
  font-weight: 600;
}
.together-bg-hint {
  position: absolute; bottom: 12rpx; right: 20rpx;
  font-size: 20rpx; color: rgba(0,0,0,0.2); z-index: 1;
}

/* 恋爱纪念日设定弹窗 */
.date-modal {
  position: relative;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  width: 580rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.18);
  animation: modalPop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.dm-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5A4636;
  text-align: center;
  margin-bottom: 32rpx;
}
.dm-picker-box {
  background: #FFF5F7;
  border: 2rpx solid #FFD1DC;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}
.dm-date-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #F48FB1;
  font-family: 'DIN Alternate', 'Bahnschrift', monospace;
}
.dm-arrow {
  font-size: 32rpx;
}
.dm-actions {
  display: flex;
  gap: 16rpx;
}
.dm-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
}
.btn-sub {
  background: #F5EDE6;
  color: #8A6A58;
}
.btn-main {
  background: linear-gradient(135deg, #FF80AB 0%, #F48FB1 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.4);
}

/* 背景选择弹窗 */
.bg-grid {
  display: flex; flex-wrap: wrap; margin: -8rpx;
}
.bg-cell {
  width: 140rpx; height: 100rpx; border-radius: 16rpx;
  margin: 8rpx; border: 3rpx solid transparent;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.bg-cell.selected { border-color: #F48FB1; }
.bg-check { font-size: 36rpx; color: #F48FB1; font-weight: 800; }

/* ── 快捷赞美面板 ── */
.praise-values {
  display: flex; justify-content: center; gap: 16rpx; margin: 16rpx 0 20rpx;
}
.praise-val {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; color: #F48FB1;
  background: #FFEBED; border: 3rpx solid transparent;
  transition: all 0.2s;
}
.praise-val.active {
  background: #F48FB1; color: #FFF; border-color: #F48FB1;
  box-shadow: 0 4rpx 16rpx rgba(244,143,177,0.35);
}

/* ── 食物转盘主弹窗 ── */
.food-wheel-modal {
  position: relative;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx 28rpx 32rpx;
  width: 650rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.18);
  animation: modalPop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes modalPop {
  0% { transform: scale(0.9); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.fwm-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.fwm-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #5A4636;
}
.fwm-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.fwm-btn-list {
  font-size: 24rpx;
  color: #F48FB1;
  background: #FFEBED;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.fwm-btn-list:active {
  background: #FFD1DA;
}
.fwm-close {
  font-size: 32rpx;
  color: #B39B8A;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5EFEB;
}

/* 转盘区域 */
.wheel-area {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  margin: 16rpx auto 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wheel-pointer {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  font-size: 44rpx;
  color: #FF5252;
  line-height: 1;
  filter: drop-shadow(0 4rpx 6rpx rgba(255, 82, 82, 0.45));
}
.wheel-disc {
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  border: 10rpx solid #FFCC80;
  box-shadow: 0 8rpx 30rpx rgba(255, 183, 77, 0.28), inset 0 0 16rpx rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}
.wheel-sector {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  transform-origin: 50% 50%;
  pointer-events: none;
}
.sector-content {
  position: absolute;
  top: 18rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  text-align: center;
}
.sector-emoji {
  font-size: 32rpx;
  line-height: 1.1;
}
.sector-name {
  font-size: 20rpx;
  font-weight: 700;
  color: #6D4C41;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 130rpx;
}

/* 转盘中间 GO 按钮 */
.wheel-center-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B8B, #FF8E53);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 139, 0.45);
  z-index: 15;
  border: 6rpx solid #FFFFFF;
  cursor: pointer;
}
.wheel-center-btn:active {
  transform: translate(-50%, -50%) scale(0.95);
}
.wheel-center-btn.disabled {
  opacity: 0.8;
  filter: grayscale(0.2);
}
.wcb-text {
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  line-height: 1.2;
}

/* 结果与提示展示 */
.spin-result-box {
  width: 100%;
  background: linear-gradient(135deg, #FFF5F7, #FFF9EB);
  border: 2rpx dashed #FF8E53;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  text-align: center;
}
.srb-tag {
  font-size: 22rpx;
  color: #8D6E63;
  font-weight: 600;
}
.srb-val {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 6rpx 0;
}
.srb-emoji {
  font-size: 40rpx;
}
.srb-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #D81B60;
}
.srb-again-tip {
  font-size: 20rpx;
  color: #BCAAA4;
}

.spin-hint-box {
  padding: 14rpx 20rpx;
  text-align: center;
}
.shb-text {
  font-size: 24rpx;
  color: #A1887F;
}

/* ── 食物列表管理弹窗 ── */
.food-manage-modal {
  position: relative;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 32rpx 28rpx;
  width: 660rpx;
  max-height: 80vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.18);
  animation: modalPop 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.fmm-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.fmm-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #5A4636;
}
.fmm-close {
  font-size: 32rpx;
  color: #B39B8A;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5EFEB;
}

.fmm-input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  background: #FAF7F5;
  padding: 10rpx 14rpx;
  border-radius: 20rpx;
}
.fmm-emoji-btn {
  font-size: 36rpx;
  width: 60rpx;
  height: 60rpx;
  background: #FFF;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.fmm-input {
  flex: 1;
  font-size: 26rpx;
  color: #5A4636;
  padding: 8rpx 10rpx;
}
.fmm-action-btn {
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 22rpx;
  border-radius: 16rpx;
  line-height: 1.4;
  margin: 0;
  border: none;
}
.fmm-action-btn.add {
  background: #F48FB1;
  color: #FFF;
}
.fmm-action-btn.edit-ok {
  background: #4CAF50;
  color: #FFF;
}
.fmm-action-btn.cancel {
  background: #E0E0E0;
  color: #616161;
}

.fmm-list-scroll {
  max-height: 440rpx;
  margin-bottom: 20rpx;
}
.fmm-empty {
  font-size: 24rpx;
  color: #B39B8A;
  text-align: center;
  padding: 60rpx 20rpx;
}
.fmm-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FAF7F5;
  margin-bottom: 12rpx;
  transition: all 0.2s;
}
.fmm-item.editing {
  background: #FFF9C4;
  border: 2rpx dashed #FBC02D;
}
.fmm-item-emoji {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.fmm-item-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #5A4636;
}
.fmm-item-ops {
  display: flex;
  align-items: center;
