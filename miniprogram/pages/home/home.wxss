  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5EFEB;
}

/* 状态三维进度展示 */
.pmm-status-card {
  background: #FFF8F9;
  border: 2rpx solid #FFDCE5;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.pmm-level-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.pmm-level {
  font-size: 26rpx;
  font-weight: 800;
  color: #D81B60;
}
.pmm-exp {
  font-size: 20rpx;
  color: #9E7D6B;
}
.pmm-stat-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.pmm-stat-item {
  display: flex;
  align-items: center;
}
.psi-name {
  width: 140rpx;
  font-size: 22rpx;
