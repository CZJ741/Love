/* 任务 */

.page.points {
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* ── 双人积分卡片 ── */
.dual-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}
.dual-user {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.dual-divider {
  width: 2rpx;
  height: 120rpx;
  background: #FFCC80;
  flex-shrink: 0;
  margin: 0 10rpx;
}
.dual-ava {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid #FFF;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.dual-ava.emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  background: #FFEBED;
  line-height: 100rpx;
}
.dual-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #5A4636;
}
.dual-bal {
  font-size: 26rpx;
  color: #B39B8A;
}
.dual-bal .num {
  font-size: 36rpx;
  font-weight: 800;
  color: #F48FB1;
  letter-spacing: 1rpx;
}

/* ── 加减分 ── */
.mode-switch {
  display: flex;
  background: #FFEBED;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.mode-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #B39B8A;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.25s;
}
.mode-item.active {
  background: #F48FB1;
  color: #FFF;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.35);
}

.tx-label-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 14rpx;
}
.tx-label-row .section-label {
  margin: 0; flex-shrink: 0; white-space: nowrap;
}

.input-box.sm {
  min-height: 72rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.amount-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #F48FB1;
  font-family: 'DIN Alternate', 'Bahnschrift', monospace;
}

.reason-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.submit-btn {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  margin-top: 28rpx;
}

/* 自定义理由多行输入 */
.custom-reason {
  width: 100%;
  min-height: 80rpx;
  max-height: 300rpx;
  line-height: 1.6;
  margin-top: 4rpx;
}
