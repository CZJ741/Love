/* 任务 */

.page.points {
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* ── 双人积分卡片 ── */
.dual-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}
.dual-user {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}

/* 角色标签 */
.role-badge {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF3E0;
  color: #B39B8A;
  border: 1rpx solid #FFE0B2;
  font-weight: 600;
  line-height: 1.4;
}
.role-badge.partner-badge {
  background: #FCE4EC;
  color: #E91E63;
  border-color: #F8BBD0;
}

.dual-divider {
  width: 2rpx;
  height: 120rpx;
  background: #FFCC80;
  flex-shrink: 0;
  margin: 0 10rpx;
}
.dual-ava {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 3rpx solid #FFF;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}
.dual-ava.emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  background: #FFEBED;
  line-height: 92rpx;
}

/* 对方高亮强化：尺寸更大、视觉焦点更突出 */
.dual-user.partner {
  flex: 1.15;
}
.dual-ava.partner-ava {
  width: 116rpx;
  height: 116rpx;
  border: 4rpx solid #FF80AB;
  box-shadow: 0 6rpx 20rpx rgba(244, 143, 177, 0.28);
}
.dual-ava.partner-ava.emoji {
  font-size: 68rpx;
  line-height: 116rpx;
  background: #FFF0F3;
}
.dual-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #7A6658;
}
.dual-name.partner-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3E2723;
}
.dual-bal {
  font-size: 24rpx;
  color: #B39B8A;
}
.dual-bal .num {
  font-size: 34rpx;
  font-weight: 800;
  color: #F48FB1;
  letter-spacing: 1rpx;
}
.dual-bal.partner-bal {
  font-size: 26rpx;
  color: #8D6E63;
}
.dual-bal .num.partner-num {
  font-size: 44rpx;
  font-weight: 900;
  color: #E91E63;
  letter-spacing: 1rpx;
  display: inline-block;
  transition: transform 0.25s ease;
}

/* 动效：加分头像欢快弹跳 & 分数激增跳动 */
.ava-bounce {
  animation: avaBounce 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes avaBounce {
  0% { transform: scale(1); }
  30% { transform: scale(1.22) translateY(-10rpx); }
  60% { transform: scale(0.95) translateY(2rpx); }
  100% { transform: scale(1) translateY(0); }
}

.score-pulse-up {
  animation: pulseScoreUp 0.8s ease-out;
}
@keyframes pulseScoreUp {
  0% { transform: scale(1); color: #E91E63; }
  35% { transform: scale(1.35); color: #FF4081; text-shadow: 0 0 12rpx rgba(255, 64, 129, 0.6); }
  100% { transform: scale(1); color: #E91E63; }
}

/* 动效：扣分卡片震撼轻抖 & 分数骤降暗淡下沉 */
.card-shake {
  animation: cardShake 0.5s ease-in-out;
}
@keyframes cardShake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-8rpx); }
  40% { transform: translateX(8rpx); }
  60% { transform: translateX(-5rpx); }
  80% { transform: translateX(5rpx); }
}

.score-pulse-down {
  animation: pulseScoreDown 0.8s ease-out;
}
@keyframes pulseScoreDown {
  0% { transform: scale(1); color: #E91E63; }
  35% { transform: scale(0.85); color: #7CB342; text-shadow: 0 0 10rpx rgba(124, 179, 66, 0.5); }
  100% { transform: scale(1); color: #E91E63; }
}

/* ── 加减分 ── */
.mode-switch {
  display: flex;
  background: #FFEBED;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.mode-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #B39B8A;
  font-size: 22rpx;
  font-weight: 600;
  transition: all 0.25s;
}
.mode-item.active {
  background: #F48FB1;
  color: #FFF;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.35);
}

.tx-label-row {
  display: flex; align-items: center; gap: 16rpx;
  margin-bottom: 14rpx;
}
.tx-label-row .section-label {
  margin: 0; flex-shrink: 0; white-space: nowrap;
}

.input-box.sm {
  min-height: 72rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.amount-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #F48FB1;
  font-family: 'DIN Alternate', 'Bahnschrift', monospace;
}

.reason-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 10rpx;
  margin-bottom: 12rpx;
}

.reason-wrap .chip {
  margin: 0;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  line-height: 1.3;
}

.submit-btn {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  margin-top: 28rpx;
}

/* 自定义理由多行输入 */
.custom-reason {
  width: 100%;
  min-height: 80rpx;
  max-height: 300rpx;
  line-height: 1.6;
  margin-top: 4rpx;
}
