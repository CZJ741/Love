/* 时间轴 */

/* ====== 页面底色 ====== */
.page.timeline {
  background: #FFEBED;
  min-height: 100vh;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* ====== 顶部导航 ====== */
.tl-nav {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  background: #FFEBED;
}
.tl-date-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.tl-today {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A3B2F;
  letter-spacing: 1rpx;
}
.tl-arrow {
  font-size: 20rpx;
  color: #B39B8A;
}
.tl-count {
  font-size: 24rpx;
  color: #B39B8A;
}

/* ====== 日历选择器 ====== */
.cal-card {
  margin: 0 28rpx 20rpx;
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.08);
}
.cal-head {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.cal-month {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B2F;
  margin: 0 32rpx;
}
.cal-nav-btn {
  font-size: 40rpx;
  color: #B39B8A;
  padding: 4rpx 16rpx;
  line-height: 1;
}
.cal-nav-btn:active { color: #4A3B2F; }
.cal-weekdays {
  display: flex;
  margin-bottom: 8rpx;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #B39B8A;
  padding: 8rpx 0;
}
.cal-grid {
  display: flex;
  flex-direction: column;
}
.cal-week {
  display: flex;
}
.cal-day {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
}
.cal-day-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #4A3B2F;
  transition: all 0.15s;
}
.cal-day-num.marked {
  background: #4A3B2F;
  color: #FFF;
  font-weight: 600;
}
.cal-day-num.today {
  border: 2rpx solid #81D5FA;
}
.cal-day-num.marked.today {
  background: #4A3B2F;
  color: #FFF;
  border: 2rpx solid #81D5FA;
}
.cal-day-num:active {
  opacity: 0.6;
}

/* ====== 往年今日卡片 ====== */
.memory-card {
  position: relative;
  margin: 0 28rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  min-height: 160rpx;
  transition: transform 0.15s ease;
}
.memory-card:active {
  transform: scale(0.985);
}

/* 有照片背景：暗色蒙层 + 白字 */
.memory-card.has-img {
  background: #333333;
}
.mc-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}
.mc-bg-img {
  width: 100%;
  height: 100%;
}
.mc-bg-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.45);
}

/* 无照片背景：信纸暖白卡片 + 高对比深色字 */
.memory-card.no-img {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF5F7 100%);
  border: 2rpx solid rgba(244, 143, 177, 0.25);
  box-shadow: 0 4rpx 16rpx rgba(191, 166, 154, 0.12);
}

.mc-content {
  position: relative;
  z-index: 1;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
}
.mc-head {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

/* 有图文字颜色 */
.memory-card.has-img .mc-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFF;
}
.memory-card.has-img .mc-ago {
  font-size: 26rpx;
  color: rgba(255,255,255,.8);
}
.memory-card.has-img .mc-text {
  font-size: 28rpx;
  color: rgba(255,255,255,.95);
  line-height: 1.5;
  text-align: left;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
  padding: 0 16rpx;
}

/* 无图高对比深色文字 */
.memory-card.no-img .mc-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #5A4636;
}
.memory-card.no-img .mc-ago {
  font-size: 24rpx;
  font-weight: 600;
  color: #F48FB1;
  background: #FFF0F3;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}
.memory-card.no-img .mc-text {
  font-size: 28rpx;
  color: #5D4A3E;
  font-weight: 500;
  line-height: 1.6;
  text-align: left;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
  padding: 0 16rpx;
}

/* ====== 时间轴容器 ====== */
.tl-container {
  padding: 0 28rpx 0 14rpx;
}

/* ====== 单条动态：左日期 + 右卡片 ====== */
.tl-item {
  display: flex;
  align-items: stretch;
  margin-bottom: 24rpx;
}

/* 左侧日期区 */
.tl-left {
  width: 90rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 16rpx;
  margin-right: 14rpx;
}
.tl-left-day {
  font-size: 46rpx;
  font-weight: 600;
  font-family: 'Times New Roman', serif;
  color: #3A2C20;
  line-height: 1;
  letter-spacing: -1rpx;
}
.tl-left-sub {
  font-size: 20rpx;
  color: #B39B8A;
  margin-top: 4rpx;
  text-align: center;
  line-height: 1.3;
}
.tl-left-ava {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-top: 14rpx;
}
.tl-left-ava.emoji {
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
  display: inline-block;
}

/* 右侧卡片 */
.tl-card {
  flex: 1;
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.06);
}

/* 正文 - 最多5行 */
.tl-card-text {
  font-size: 28rpx;
  color: #4A3B2F;
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
}

/* 图片 */
.tl-card-imgs {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -4rpx 12rpx;
}
.tl-card-img-wrap {
  position: relative;
  width: calc(33.33% - 8rpx);
  margin: 4rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #FFEBED;
}
.tl-card-img-wrap::after {
  content: '';
  display: block;
  padding-bottom: 100%;
}
.tl-card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}

/* 时间与卡片底部 */
.tl-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.tl-card-time {
  font-size: 22rpx;
  color: #B39B8A;
  display: block;
}
.tl-card-comment-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF0F2;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.c-badge-icon {
  font-size: 20rpx;
  line-height: 1;
}
.c-badge-count {
  font-size: 20rpx;
  color: #E57373;
  font-weight: 600;
}

/* 列表卡片上的评论预览 */
.tl-card-comments {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  background: #FFF5F6;
  border-radius: 12rpx;
  border-left: 4rpx solid #F48FB1;
}
.tl-card-c-item {
  font-size: 24rpx;
  line-height: 1.5;
  color: #4A3B2F;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tl-card-c-item:last-child {
  margin-bottom: 0;
}
.c-preview-author {
  font-weight: 600;
  color: #8B7355;
}
.c-preview-text {
  color: #5C4738;
}
.c-preview-more {
  display: block;
  font-size: 20rpx;
  color: #B39B8A;
  margin-top: 4rpx;
}

/* ====== 右下角悬浮+按钮 ====== */
.tl-fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(120rpx + constant(safe-area-inset-bottom));
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F48FB1;
  box-shadow: 0 6rpx 24rpx rgba(244, 143, 177, .35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.tl-fab-icon {
  font-size: 52rpx;
  color: #FFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -2rpx;
}

/* ====== 空状态 ====== */
.empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #B39B8A;
}
.e-emoji {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

/* ====== 详情弹窗 ====== */
.detail-modal {
  width: 680rpx;
  max-width: 90vw;
  max-height: 85vh;
}
.detail-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.detail-day {
  font-size: 44rpx;
  font-weight: 800;
  color: #3A2C20;
}
.detail-sub {
  font-size: 24rpx;
  color: #B39B8A;
  margin-left: 8rpx;
}
.detail-text {
  max-height: 50vh;
  overflow-y: auto;
  display: block;
  -webkit-line-clamp: unset;
  white-space: pre-wrap;
  word-break: break-all;
}
.detail-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.detail-btns .btn {
  flex: 1;
  margin-top: 0;
}
.m-img.full {
  width: 100%;
  height: auto;
  margin: 6rpx 0;
  border-radius: 12rpx;
}
.m-text {
  font-size: 28rpx;
  color: #4A3B2F;
  line-height: 1.8;
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}
.m-imgs {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx 16rpx;
}

/* ====== 详情弹窗：评论互动区 ====== */
.detail-comments-section {
  margin-top: 24rpx;
  border-top: 2rpx dashed #F8BBD0;
  padding-top: 20rpx;
}
.detail-c-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.c-title-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #4A3B2F;
}
.c-title-count {
  font-size: 22rpx;
  color: #E57373;
}
.detail-c-list {
  max-height: 28vh;
  overflow-y: auto;
  margin-bottom: 16rpx;
  padding-right: 4rpx;
}
.detail-c-empty {
  text-align: center;
  padding: 24rpx 0;
}
.c-empty-text {
  font-size: 24rpx;
  color: #B39B8A;
}
.detail-c-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #FFF0F2;
}
.detail-c-item:last-child {
  border-bottom: none;
}
.detail-c-ava {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 14rpx;
}
.detail-c-ava.emoji {
  font-size: 36rpx;
  line-height: 48rpx;
  text-align: center;
  display: inline-block;
}
.detail-c-body {
  flex: 1;
  min-width: 0;
}
.detail-c-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.detail-c-author {
  font-size: 24rpx;
  font-weight: 600;
  color: #4A3B2F;
}
.detail-c-time {
  font-size: 20rpx;
  color: #B39B8A;
}
.detail-c-text {
  font-size: 26rpx;
  color: #5C4738;
  line-height: 1.5;
  word-break: break-all;
}
.detail-c-del {
  padding: 4rpx 10rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.c-del-icon {
  font-size: 22rpx;
  color: #BCAAA4;
}

/* 详情弹窗评论输入栏 */
.detail-c-input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
}
.detail-c-input {
  flex: 1;
  height: 64rpx;
  background: #FFF5F6;
  border: 1.5rpx solid #F8BBD0;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #4A3B2F;
}
.c-input-ph {
  color: #BCAAA4;
  font-size: 24rpx;
}
.detail-c-send-btn {
  width: 120rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  padding: 0 !important;
  font-size: 24rpx !important;
  font-weight: 600;
  border-radius: 32rpx !important;
  background: linear-gradient(135deg, #F48FB1, #FFCC80);
  color: #FFF;
  margin: 0 !important;
  flex-shrink: 0;
}
.detail-c-send-btn[disabled] {
  opacity: 0.6;
}

/* ====== 发帖弹窗 ====== */
.post-modal {
  width: 680rpx;
  max-height: 85vh;
}
.post-area {
  width: 100%;
  min-height: 140rpx;
  background: #FFEBED;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #4A3B2F;
}

.post-imgs {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx -6rpx;
}
.pi-item {
  position: relative;
  width: calc(25% - 12rpx);
  height: 140rpx;
  margin: 6rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.pi-img {
  width: 100%;
  height: 100%;
}
.pi-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,.45);
  color: #FFF;
  border-radius: 0 12rpx 0 12rpx;
  font-size: 22rpx;
  text-align: center;
  line-height: 36rpx;
}
.pi-add {
  width: calc(25% - 12rpx);
  height: 140rpx;
  margin: 6rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #81D5FA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #81D5FA;
  background: #FFEBED;
}

.post-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  width: 340rpx;
}
.picker-date {
  flex: 1;
  margin-right: 12rpx;
}
.picker-time {
  flex: 1;
}
.picker-val {
  background: #FFEBED;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  color: #5A4636;
  text-align: center;
}

/* ====== 通用弹窗 ====== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,.35);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  background: #FFF;
  border-radius: 24rpx;
  padding: 32rpx;
  overflow-y: auto;
  max-width: 90vw;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3B2F;
  margin-bottom: 20rpx;
}

.btn {
  border: none;
  border-radius: 20rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
.btn::after {
  border: none;
}
.submit-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #F48FB1, #FFCC80);
  color: #FFF;
}
.secondary {
  background: #FFEBED;
  color: #8B7355;
}