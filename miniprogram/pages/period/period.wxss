/* 生理期 / 健康关怀页面样式 */
page {
  background-color: #FFEBED;
  color: #5A4636;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

.period-page {
  padding: 24rpx 28rpx 60rpx;
}

/* 顶部视角切换条 */
.role-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.rs-label {
  font-size: 24rpx;
  color: #8D6E63;
  font-weight: 500;
}

.rs-btn {
  font-size: 22rpx;
  color: #E91E63;
  background: #FFF0F3;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #F8BBD0;
}

/* 男生视角：照顾横幅 */
.care-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(244, 143, 177, 0.25);
}

.care-banner.during {
  background: linear-gradient(135deg, #FFCDD2 0%, #F48FB1 100%);
  color: #880E4F;
}

.care-banner.approaching {
  background: linear-gradient(135deg, #FFE0B2 0%, #FFB74D 100%);
  color: #E65100;
}

.care-banner.normal {
  background: linear-gradient(135deg, #E8F5E9 0%, #A5D6A7 100%);
  color: #1B5E20;
}

.care-status-icon {
  font-size: 56rpx;
  line-height: 1;
}

.care-status-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.care-main-title {
  font-size: 32rpx;
  font-weight: 800;
}

.care-sub-desc {
  font-size: 22rpx;
  opacity: 0.9;
  line-height: 1.4;
}

/* 暖男贴心指南 */
.guide-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(186, 104, 200, 0.08);
}

.guide-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #5A4636;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #F8F2F4;
  padding-bottom: 14rpx;
}

.gt-icon {
  font-size: 30rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.gi-emoji {
  font-size: 36rpx;
  margin-top: 4rpx;
}

.gi-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.gi-t {
  font-size: 26rpx;
  font-weight: bold;
  color: #5A4636;
}

.gi-d {
  font-size: 22rpx;
  color: #8D6E63;
  line-height: 1.35;
}

/* 一键送关怀卡片 */
.actions-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(186, 104, 200, 0.08);
}

.actions-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #5A4636;
  margin-bottom: 20rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.action-btn-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFF0F3;
  border: 1rpx solid #F8BBD0;
  border-radius: 20rpx;
  padding: 20rpx 8rpx;
  gap: 10rpx;
  transition: transform 0.15s;
}

.action-btn-item:active {
  transform: scale(0.94);
}

.abi-emoji {
  font-size: 44rpx;
}

.abi-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #E91E63;
  white-space: nowrap;
}

.last-care-hint {
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  color: #B39B8A;
}

/* 女生端大仪表卡片 */
.cycle-dashboard-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(244, 143, 177, 0.2);
  border: 2rpx solid #FCE4EC;
}

.cycle-dashboard-card.during {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF5F7 100%);
  border-color: #F48FB1;
}

.cdc-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.cdc-badge {
  font-size: 22rpx;
  font-weight: bold;
  background: #FCE4EC;
  color: #E91E63;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.cdc-center-text {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.cdc-large-num {
  font-size: 72rpx;
  font-weight: 900;
  color: #E91E63;
  font-family: Arial, sans-serif;
  line-height: 1;
}

.cdc-unit {
  font-size: 26rpx;
  font-weight: bold;
  color: #5A4636;
}

.cdc-pred-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8D6E63;
}

.cdc-pred-dot {
  color: #D7CCC8;
}

.cdc-quick-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FF6B8B 0%, #F48FB1 100%);
  color: #FFFFFF;
  padding: 16rpx 40rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.4);
}

.cqb-icon {
  font-size: 28rpx;
}

/* 历史卡片 */
.history-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(186, 104, 200, 0.08);
}

.hc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #F8F2F4;
}

.hc-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #5A4636;
}

.hc-setting-btn {
  font-size: 22rpx;
  color: #F48FB1;
}

.empty-history {
  text-align: center;
  font-size: 22rpx;
  color: #B39B8A;
  padding: 40rpx 0;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #FAF5F6;
}

.hi-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hi-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #F48FB1;
}

.hi-date {
  font-size: 26rpx;
  color: #5A4636;
  font-family: Arial, sans-serif;
}

.hi-tag {
  font-size: 20rpx;
  background: #F5EEF0;
  color: #8D6E63;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.hi-tag.warning {
  background: #FFF3E0;
  color: #EF6C00;
}

.hi-tag.danger {
  background: #FFEBEE;
  color: #C62828;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.25s ease;
}

.modal-mask.show {
  visibility: visible;
  opacity: 1;
}

.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5A4636;
}

.modal-close {
  font-size: 36rpx;
  color: #B39B8A;
  padding: 8rpx;
}

.form-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8D6E63;
  margin-bottom: 14rpx;
}

.date-picker-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FDF7F8;
  border: 1rpx solid #F5EEF0;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.dpr-icon {
  font-size: 28rpx;
}

.dpr-val {
  font-size: 26rpx;
  color: #5A4636;
}

.chip-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.cr-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #FDF7F8;
  border: 1rpx solid #F5EEF0;
  font-size: 22rpx;
  color: #8D6E63;
}

.cr-chip.active {
  background: #FFF0F3;
  border-color: #F48FB1;
  color: #E91E63;
  font-weight: bold;
}

.num-input {
  width: 100%;
  background: #FDF7F8;
  border: 1rpx solid #F5EEF0;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #5A4636;
  margin-bottom: 24rpx;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B8B 0%, #F48FB1 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 28rpx;
  width: 100%;
  height: 84rpx;
  line-height: 1;
  padding: 0;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.4);
  border: none;
}

.submit-btn::after {
  border: none;
}
