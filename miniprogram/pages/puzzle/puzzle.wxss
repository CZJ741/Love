/* pages/puzzle/puzzle.wxss */
.puzzle-page {
  padding: 24rpx;
  background: #FFF0F2;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 60rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(244, 143, 177, 0.12);
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 连续天数头部卡片 */
.streak-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFF5F7 0%, #FFE8ED 100%);
  border: 2rpx solid rgba(244, 143, 177, 0.2);
}

.streak-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.streak-fire {
  font-size: 48rpx;
}

.streak-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A34;
}

.streak-count {
  font-size: 36rpx;
  color: #E91E63;
  margin: 0 4rpx;
}

.streak-sub {
  font-size: 22rpx;
  color: #9E857C;
  margin-top: 4rpx;
}

.poster-unlock-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: linear-gradient(135deg, #FF6B8B 0%, #FF8E53 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 139, 0.4);
}

/* 九宫格累计进度 */
.progress-bar-card {
  padding: 24rpx 20rpx 20rpx;
}

.grid-progress {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.grid-cell {
  width: calc((100% - 48rpx) / 3);
  height: 96rpx;
  border-radius: 12rpx;
  background: #F5EAEB;
  color: #B09B98;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.grid-cell.filled {
  background: linear-gradient(135deg, #F48FB1 0%, #EC407A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(236, 64, 122, 0.3);
}

.grid-progress-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9E857C;
}

.tip-strong {
  color: #E91E63;
  font-weight: 700;
}

/* 今日主题卡片 */
.theme-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8FA 100%);
  border-left: 8rpx solid #F48FB1;
}

.theme-tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.theme-tag {
  font-size: 24rpx;
  color: #EC407A;
  font-weight: 700;
}

.theme-date {
  font-size: 22rpx;
  color: #BDB3AF;
}

.theme-content {
  font-size: 36rpx;
  font-weight: 800;
  color: #3D2D29;
  line-height: 1.4;
  margin: 12rpx 0;
}

.theme-desc {
  font-size: 24rpx;
  color: #8C7872;
}

/* 双人对比视窗卡片 */
.duel-card {
  padding: 24rpx;
}

.duel-viewport {
  display: flex;
  position: relative;
  height: 600rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #F9F0F2;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.photo-half {
  flex: 1;
  height: 100%;
  position: relative;
  background: #FAEFF2;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 12rpx 12rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.6) 100%);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.photo-author {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.reupload-tip {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 空白占位 */
.empty-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  box-sizing: border-box;
  text-align: center;
}

.empty-placeholder.waiting {
  background: #F4E8EC;
}

.cam-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.cam-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #614D46;
  margin-bottom: 8rpx;
}

.cam-sub {
  font-size: 20rpx;
  color: #A38F89;
  line-height: 1.3;
}

/* 高斯模糊锁定 */
.blur-locked-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(244, 143, 177, 0.25) 0%, rgba(206, 147, 216, 0.35) 100%);
  backdrop-filter: blur(16px);
  padding: 24rpx;
  box-sizing: border-box;
  text-align: center;
}

.lock-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.lock-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #4E342E;
  margin-bottom: 6rpx;
}

.lock-sub {
  font-size: 20rpx;
  color: #795548;
}

/* 中间分割线与爱心胶带 */
.split-tape {
  width: 8rpx;
  height: 100%;
  background: #FFFFFF;
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  z-index: 10;
  box-shadow: 0 0 10rpx rgba(0, 0, 0, 0.1);
}

.tape-heart {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 底部文案 */
.duel-quote {
  text-align: center;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: #FFF9FA;
  border-radius: 16rpx;
}

.quote-symbol {
  font-size: 28rpx;
  color: #F48FB1;
  font-weight: bold;
}

.quote-text {
  font-size: 26rpx;
  color: #5D4037;
  letter-spacing: 1rpx;
  margin: 0 6rpx;
  font-family: serif, -apple-system;
}

/* 底部操作区 */
.action-wrap {
  margin-top: 32rpx;
}

.btn-action {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  border: none;
  padding: 0 20rpx;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-action[disabled] {
  opacity: 0.6;
}

.btn-text {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
  line-height: 1;
}

.btn-hover {
  opacity: 0.85;
}

.btn-action::after {
  border: none;
}

.primary-btn {
  background: linear-gradient(135deg, #F48FB1 0%, #EC407A 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(236, 64, 122, 0.35);
}

.save-btn {
  background: linear-gradient(135deg, #AB47BC 0%, #7E57C2 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(171, 71, 188, 0.35);
}

.waiting-btn {
  background: linear-gradient(135deg, #FFA726 0%, #FB8C00 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(251, 140, 0, 0.35);
}

/* 离屏/隐藏合成 Canvas */
.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1050px;
}

/* 九宫格大拼图弹窗 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.poster-modal {
  width: 100%;
  max-width: 680rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.poster-header {
  text-align: center;
  margin-bottom: 20rpx;
}

.pm-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #3E2723;
}

.pm-sub {
  font-size: 22rpx;
  color: #8D6E63;
  margin-top: 4rpx;
}

.poster-canvas-box {
  width: 100%;
  height: 800rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background: #F5EFEB;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.poster-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.canvas-loading {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loading-spin {
  font-size: 54rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.9); }
  50% { transform: scale(1.15); }
  100% { transform: scale(0.9); }
}

.loading-text {
  font-size: 24rpx;
  color: #6D4C41;
}

.poster-actions {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cancel-btn {
  background: #F5EAEB;
  color: #795548;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}
