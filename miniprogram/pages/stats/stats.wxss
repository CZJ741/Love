/* 我 */

.page.stats {
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.cold-banner-stats {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #D81B60;
  background: #FFEBED;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.seg { display: flex; background: #FFEBED; border-radius: 999rpx; padding: 8rpx; margin-bottom: 24rpx; }
.seg-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 999rpx; font-size: 28rpx; color: #B39B8A; }
.seg-item.active { background: #F48FB1; color: #FFF; font-weight: 600; }

.tx-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 2rpx dashed #FFCC80; }
.tx-item:last-child { border-bottom: none; }
.tx-emoji { font-size: 40rpx; margin-right: 18rpx; }
.tx-body { flex: 1; }
.tx-reason { font-size: 28rpx; color: #5A4636; }
.tx-time { font-size: 22rpx; color: #C9B3A3; margin-top: 2rpx; }
.tx-amount { font-size: 30rpx; font-weight: 700; }

.heat-grid { display: flex; flex-wrap: wrap; margin: -4rpx; max-width: 100%; }
.heat-cell { width: 36rpx; height: 36rpx; border-radius: 8rpx; margin: 4rpx; flex-shrink: 0; }
.heat-cell.l0 { background: #FFEBED; } .heat-cell.l1 { background: #FFCC80; }
.heat-cell.l2 { background: #FEE580; } .heat-cell.l3 { background: #C5E1A6; }
.heat-cell.l4 { background: #81D5FA; }

.heat-legend { display: flex; align-items: center; font-size: 22rpx; color: #B39B8A; margin-top: 20rpx; }
.legend-cell { width: 24rpx; height: 24rpx; border-radius: 6rpx; margin: 0 4rpx 0 8rpx; }
.legend-cell.l0 { background: #FFEBED; } .legend-cell.l1 { background: #FFCC80; }
.legend-cell.l2 { background: #FEE580; } .legend-cell.l3 { background: #C5E1A6; }
.legend-cell.l4 { background: #81D5FA; }
.heat-note { margin-left: auto; }

/* 个人设置 */
.settings-card { margin-top: 8rpx; }
.settings-row {
  display: flex; align-items: center; margin-bottom: 20rpx; flex-wrap: wrap;
}
.s-label { width: 80rpx; font-size: 26rpx; color: #5D4E3F; font-weight: 600; }
.s-input { flex: 1; min-width: 200rpx; min-height: 76rpx; padding: 16rpx 22rpx; font-size: 28rpx; }

.avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FFEBED;
  border: 3rpx dashed #B39DDB;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 16rpx 0 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-sizing: border-box;
}
.avatar-wrap:active {
  opacity: 0.8;
  transform: scale(0.96);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-emoji { font-size: 44rpx; color: #F48FB1; }

/* 头像选择弹窗 */
.avatar-modal {
  padding: 36rpx 30rpx;
}

.choose-wx-avatar-btn {
  width: 100%;
  height: 84rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.avatar-modal-divider {
  text-align: center;
  font-size: 24rpx;
  color: #B39B8A;
  margin-bottom: 20rpx;
  position: relative;
}
.avatar-modal-divider::before,
.avatar-modal-divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 25%;
  height: 2rpx;
  background: #FFCC80;
}
.avatar-modal-divider::before { left: 40rpx; }
.avatar-modal-divider::after { right: 40rpx; }

.avatar-grid {
  display: flex; flex-wrap: wrap; margin: -6rpx;
}
.avatar-option {
  width: calc(12.5% - 12rpx);
  height: 80rpx;
  margin: 6rpx;
  border-radius: 16rpx;
  background: #FFEBED;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}
.avatar-option.active {
  border-color: #F48FB1; background: #FFEBED;
}

/* 隐私指引入口 */
.privacy-entrance {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 32rpx;
  padding: 12rpx 0;
}
.privacy-icon {
  font-size: 24rpx;
}
.privacy-text {
  font-size: 24rpx;
  color: #B39B8A;
  text-decoration: underline;
}
.privacy-text:active {
  color: #F48FB1;
}

/* 隐私说明应用内弹窗 */
.privacy-modal {
  padding: 40rpx 36rpx;
  max-height: 80vh;
}

.privacy-content {
  margin-bottom: 30rpx;
}

.p-sec {
  margin-bottom: 24rpx;
}
.p-sec:last-child {
  margin-bottom: 0;
}

.p-sec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #5A4636;
  margin-bottom: 10rpx;
  position: relative;
  padding-left: 16rpx;
}
.p-sec-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 6rpx;
  background: #F48FB1;
  border-radius: 4rpx;
}

.p-sec-desc {
  font-size: 25rpx;
  color: #7A6A5E;
  line-height: 1.6;
}

.p-sec-item {
  display: flex;
  font-size: 25rpx;
  color: #7A6A5E;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
.p-sec-item:last-child {
  margin-bottom: 0;
}

.p-dot {
  color: #F48FB1;
  font-weight: 700;
  margin-right: 8rpx;
}
