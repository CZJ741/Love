/* 我 */

.page.stats {
  padding-bottom: calc(100rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.cold-banner-stats {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #D81B60;
  background: #FFEBED;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.seg { display: flex; background: #FFEBED; border-radius: 999rpx; padding: 8rpx; margin-bottom: 24rpx; }
.seg-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 999rpx; font-size: 28rpx; color: #B39B8A; }
.seg-item.active { background: #F48FB1; color: #FFF; font-weight: 600; }

.tx-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 2rpx dashed #FFCC80; }
.tx-item:last-child { border-bottom: none; }
.tx-emoji { font-size: 40rpx; margin-right: 18rpx; }
.tx-body { flex: 1; }
.tx-reason { font-size: 28rpx; color: #5A4636; }
.tx-time { font-size: 22rpx; color: #C9B3A3; margin-top: 2rpx; }
.tx-amount { font-size: 30rpx; font-weight: 700; }

.heat-grid { display: flex; flex-wrap: wrap; margin: -4rpx; max-width: 100%; }
.heat-cell { width: 36rpx; height: 36rpx; border-radius: 8rpx; margin: 4rpx; flex-shrink: 0; }
.heat-cell.l0 { background: #FFEBED; } .heat-cell.l1 { background: #FFCC80; }
.heat-cell.l2 { background: #FEE580; } .heat-cell.l3 { background: #C5E1A6; }
.heat-cell.l4 { background: #81D5FA; }

.heat-legend { display: flex; align-items: center; font-size: 22rpx; color: #B39B8A; margin-top: 20rpx; }
.legend-cell { width: 24rpx; height: 24rpx; border-radius: 6rpx; margin: 0 4rpx 0 8rpx; }
.legend-cell.l0 { background: #FFEBED; } .legend-cell.l1 { background: #FFCC80; }
.legend-cell.l2 { background: #FEE580; } .legend-cell.l3 { background: #C5E1A6; }
.legend-cell.l4 { background: #81D5FA; }
.heat-note { margin-left: auto; }

/* 个人设置 */
.settings-card { margin-top: 8rpx; }
.settings-row {
  display: flex; align-items: center; margin-bottom: 20rpx; flex-wrap: wrap;
}
.s-label { width: 80rpx; font-size: 26rpx; color: #5D4E3F; font-weight: 600; }
.s-input { flex: 1; min-width: 200rpx; min-height: 76rpx; padding: 16rpx 22rpx; font-size: 28rpx; }
.s-tip { font-size: 22rpx; color: #B39B8A; margin-left: 12rpx; }

.avatar-pick {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: #FFEBED; border: 3rpx dashed #B39DDB;
  display: flex; align-items: center; justify-content: center;
  padding: 0; margin: 0 12rpx; overflow: hidden; flex-shrink: 0;
  box-sizing: border-box; line-height: 1;
}
.avatar-emoji { font-size: 36rpx; color: #F48FB1; }

/* 头像选择弹窗 */
.avatar-grid {
  display: flex; flex-wrap: wrap; margin: -6rpx;
}
.avatar-option {
  width: calc(12.5% - 12rpx);
  height: 80rpx;
  margin: 6rpx;
  border-radius: 16rpx;
  background: #FFEBED;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  border: 3rpx solid transparent;
  box-sizing: border-box;
}
.avatar-option.active {
  border-color: #F48FB1; background: #FFEBED;
}
