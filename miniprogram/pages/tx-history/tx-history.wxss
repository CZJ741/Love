.page {
  padding: 24rpx;
}

/* 日期筛选 */
.tx-filter {
  display: flex; align-items: center; gap: 10rpx;
  margin-bottom: 16rpx; padding: 16rpx;
  background: #FFF; border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(244, 143, 177, 0.06);
}
.tx-filter-item {
  display: flex; align-items: center; gap: 6rpx;
  padding: 8rpx 16rpx;
  background: #FFEBED; border: 1rpx solid #FFCC80; border-radius: 10rpx;
}
.tx-filter-label {
  font-size: 22rpx; color: #B39B8A;
}
.tx-filter-val {
  font-size: 24rpx; color: #5A4636; max-width: 140rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tx-filter-sep {
  font-size: 22rpx; color: #D4C4B6;
}
.tx-filter-actions {
  display: flex; gap: 8rpx; margin-left: auto;
}
.tx-filter-btn {
  font-size: 24rpx; color: #FFF; background: #F48FB1;
  padding: 8rpx 20rpx; border-radius: 999rpx; font-weight: 600;
}
.tx-filter-btn:active { opacity: 0.7; }
.tx-filter-reset {
  font-size: 22rpx; color: #C9B3A3;
  padding: 8rpx 16rpx; border-radius: 999rpx;
}
.tx-filter-reset:active { background: #F5EDE6; }

/* 积分变动列表 */
.tx-list { margin-top: 4rpx; }
.tx-row {
  display: flex; align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5EDE6;
}
.tx-row:last-child { border-bottom: none; }
.tx-row:active { background: #FFEBED; }

.tx-icon {
  font-size: 26rpx; flex-shrink: 0; margin-right: 10rpx;
}
.tx-reason {
  flex: 1; min-width: 0;
  font-size: 24rpx; color: #5A4636;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tx-to-user {
  font-size: 20rpx; color: #C9B3A3; flex-shrink: 0; margin-left: 6rpx;
  max-width: 100rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.tx-val {
  font-size: 24rpx; font-weight: 700; flex-shrink: 0; margin-left: 10rpx;
}
.tx-time {
  font-size: 20rpx; color: #C9B3A3; flex-shrink: 0; margin-left: 8rpx;
}
.tx-empty {
  text-align: center; color: #D4C4B6; font-size: 24rpx; padding: 60rpx 0;
}
