/* 恋爱清单 / 专属心愿清单 页面样式 */
page {
  background-color: #FFEBED;
  color: #5A4636;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

.lovelist-page {
  padding: 24rpx 28rpx 60rpx;
}

/* 离屏 Canvas (隐藏在视口之外用于生成海报) */
.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1050px;
}

/* 顶部操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.page-caption {
  font-size: 32rpx;
  font-weight: bold;
  color: #5A4636;
  letter-spacing: 1rpx;
}

.action-right {
  display: flex;
  align-items: center;
}

.add-custom-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFFFFF;
  color: #E91E63;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(233, 30, 99, 0.12);
}

.add-icon {
  font-size: 28rpx;
  line-height: 1;
}

/* 列表容器 */
.items-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.empty-emoji {
  font-size: 64rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #B39B8A;
}

/* 单个清单小事卡片 */
.item-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(186, 104, 200, 0.08);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.item-card.is-done {
  border-color: #F8BBD0;
  background: #FFFDFE;
}

.item-main-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.delete-icon-btn {
  padding: 8rpx;
  font-size: 26rpx;
  color: #B39B8A;
  opacity: 0.6;
  transition: opacity 0.2s;
  flex-shrink: 0;
}

.delete-icon-btn:active {
  opacity: 1;
  color: #FF5252;
}

.check-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 3rpx solid #E0D3D6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: transparent;
  transition: all 0.2s;
  flex-shrink: 0;
}

.check-box.checked {
  background: linear-gradient(135deg, #FF6B8B 0%, #F48FB1 100%);
  border-color: #F48FB1;
  color: #FFFFFF;
}

.item-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #5A4636;
  line-height: 1.4;
}

.item-title.title-done {
  color: #8D6E63;
  text-decoration: line-through;
  opacity: 0.85;
}

/* 打卡凭证与心得区域 */
.item-proof-box {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #F5EEF0;
}

.proof-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.proof-date {
  font-size: 20rpx;
  color: #B39B8A;
}

.poster-link-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #E91E63;
  background: #FFF0F3;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
}

.pl-icon {
  font-size: 20rpx;
}

.proof-remark {
  font-size: 24rpx;
  color: #8D6E63;
  font-style: italic;
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.proof-images {
  display: flex;
  gap: 12rpx;
}

.proof-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
}

/* Modal 通用样式 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.25s ease;
}

.modal-mask.show {
  visibility: visible;
  opacity: 1;
}

.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(60rpx + constant(safe-area-inset-bottom));
  padding: 32rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5A4636;
}

.modal-close {
  font-size: 36rpx;
  color: #B39B8A;
  padding: 8rpx;
}

.check-item-preview {
  display: flex;
  align-items: center;
  background: #FFF0F3;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
}

.cip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #5A4636;
}

.form-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8D6E63;
  margin-bottom: 14rpx;
}

/* 上传框 */
.uploader-wrap {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.upload-preview-box {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.del-img-btn {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.upload-btn-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #F48FB1;
  background: #FFFDFE;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.ub-icon {
  font-size: 36rpx;
}

.ub-text {
  font-size: 20rpx;
  color: #F48FB1;
}

.remark-textarea {
  width: 100%;
  height: 140rpx;
  background: #FDF7F8;
  border: 1rpx solid #F5EEF0;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #5A4636;
  margin-bottom: 32rpx;
}

.custom-title-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FDF7F8;
  border: 1rpx solid #F5EEF0;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #5A4636;
  margin-bottom: 36rpx;
}

.input-placeholder {
  color: #B39B8A;
  font-size: 28rpx;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B8B 0%, #F48FB1 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 28rpx;
  width: 100%;
  height: 84rpx;
  line-height: 1;
  padding: 0;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.4);
  border: none;
}

.submit-btn::after {
  border: none;
}

/* 海报预览卡片 */
.poster-preview-card {
  width: 640rpx;
  margin: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.poster-img {
  width: 100%;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.25);
}

.save-album-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B8B 0%, #F48FB1 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 36rpx;
  width: 100%;
  height: 76rpx;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.4);
  border: none;
}

.save-album-btn::after {
  border: none;
}

.poster-close-link {
  font-size: 26rpx;
  color: #FFFFFF;
  padding: 10rpx 20rpx;
}
