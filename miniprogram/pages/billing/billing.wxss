/* 情侣记账 / AA神器 样式 */
page {
  background-color: #FFEBED;
  color: #5A4636;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

.billing-page {
  padding: 24rpx 28rpx 60rpx;
}

/* 顶部「谁欠谁」对账差额卡片 */
.debt-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(244, 143, 177, 0.18);
  transition: all 0.3s ease;
}

/* 状态配色 */
.debt-card.even {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border: 2rpx solid #A5D6A7;
}

.debt-card.partner_owes_me {
  background: linear-gradient(135deg, #FFF9C4 0%, #FFE082 100%);
  border: 2rpx solid #FFD54F;
}

.debt-card.i_owe_partner {
  background: linear-gradient(135deg, #FFEBEE 0%, #FFCDD2 100%);
  border: 2rpx solid #EF9A9A;
}

.debt-card-left {
  display: flex;
  flex-direction: column;
}

.debt-status-badge {
  font-size: 22rpx;
  font-weight: 600;
  color: #795548;
  margin-bottom: 8rpx;
}

.debt-main-text {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.debt-highlight {
  font-size: 38rpx;
  font-weight: bold;
  color: #2E7D32;
}

.debt-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #5D4037;
}

.debt-amount {
  font-size: 44rpx;
  font-weight: 800;
  color: #D81B60;
  font-family: Arial, Helvetica, sans-serif;
}

.settle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  color: #D81B60;
  font-size: 24rpx;
  font-weight: bold;
  padding: 0 12rpx;
  width: auto !important;
  min-height: 0;
  height: 58rpx;
  line-height: 1;
  border-radius: 29rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: none;
  box-sizing: border-box;
  white-space: nowrap;
}

.settle-btn::after {
  border: none;
}

/* 月度收支 KPI 卡片 */
.kpi-panel {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(186, 104, 200, 0.08);
}

.kpi-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #F5EEF0;
  padding-bottom: 18rpx;
  margin-bottom: 20rpx;
}

.month-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF0F3;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.month-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #F48FB1;
}

.picker-arrow {
  font-size: 18rpx;
  color: #F48FB1;
}

.kpi-total-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #5A4636;
}

.kpi-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.kpi-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.kpi-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #5A4636;
  margin-bottom: 6rpx;
}

.kpi-name {
  font-size: 22rpx;
  color: #B39B8A;
}

.kpi-divider {
  width: 2rpx;
  height: 48rpx;
  background: #F0E6E8;
}

/* 记一笔快捷按钮 */
.quick-add-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FF6B8B 0%, #F48FB1 100%);
  color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(244, 143, 177, 0.4);
}

.qab-icon {
  font-size: 32rpx;
}

/* 账单明细列表 */
.bills-section {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(186, 104, 200, 0.08);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #5A4636;
  margin-bottom: 20rpx;
}

.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 12rpx;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #B39B8A;
}

.bill-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bill-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F8F2F4;
}

.bill-card:last-child {
  border-bottom: none;
}

.bill-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.bill-category-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

/* 分类图标背景 */
.cat-dining { background: #FFF3E0; }
.cat-dating { background: #FCE4EC; }
.cat-movie { background: #EDE7F6; }
.cat-gift { background: #FFEBEE; }
.cat-daily { background: #E8F5E9; }
.cat-other { background: #E0F7FA; }

.bill-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bill-title-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.bill-cat-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #5A4636;
}

.bill-remark {
  font-size: 22rpx;
  color: #8D6E63;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bill-date {
  font-size: 22rpx;
  color: #B39B8A;
}

.bill-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.tag-payer {
  background: #F3E5F5;
  color: #8E24AA;
}

.tag-rule {
  background: #E0F2F1;
  color: #00796B;
}

.tag-settled {
  background: #E8F5E9;
  color: #2E7D32;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.settled-dot {
  font-size: 14rpx;
  color: #4CAF50;
}

.tag-pending {
  background: #FFF3E0;
  color: #EF6C00;
}

/* 已结清的账单卡片略微柔和 */
.bill-card.is-settled {
  opacity: 0.92;
}

.bill-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  margin-left: 16rpx;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #5A4636;
}

.bill-del-btn {
  font-size: 20rpx;
  color: #EF5350;
  padding: 4rpx 10rpx;
}

/* 记账弹窗 Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 999;
  visibility: hidden;
  opacity: 0;
  transition: all 0.25s ease;
}

.modal-mask.show {
  visibility: visible;
  opacity: 1;
}

.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5A4636;
}

.modal-close {
  font-size: 36rpx;
  color: #B39B8A;
  padding: 8rpx;
}

/* 大字金额输入 */
.input-amount-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  border-bottom: 2rpx solid #F5EEF0;
  padding-bottom: 16rpx;
  margin-bottom: 28rpx;
}

.currency-symbol {
  font-size: 48rpx;
  font-weight: bold;
  color: #F48FB1;
  margin-right: 12rpx;
}

.input-amount {
  font-size: 64rpx;
  font-weight: bold;
  color: #5A4636;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
}

.form-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8D6E63;
  margin-bottom: 14rpx;
}

/* 6格分类 Chip */
.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.cat-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #FDF7F8;
  border: 2rpx solid #F5EEF0;
  border-radius: 20rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #5A4636;
  transition: all 0.2s;
}

.cat-chip.active {
  background: #FFF0F3;
  border-color: #F48FB1;
  color: #E91E63;
  font-weight: bold;
}

.chip-emoji {
  font-size: 30rpx;
}

/* 分段选择器 */
.segment-wrap {
  display: flex;
  background: #F5F0F2;
  border-radius: 20rpx;
  padding: 6rpx;
  gap: 6rpx;
  margin-bottom: 24rpx;
}

.segment-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  padding: 14rpx 0;
  border-radius: 16rpx;
  color: #8D6E63;
  transition: all 0.2s;
}

.segment-btn.active {
  background: #FFFFFF;
  color: #E91E63;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 日期与备注行 */
.form-inline-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 32rpx;
}

.date-picker-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FDF7F8;
  border: 1rpx solid #F5EEF0;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
}

.dp-icon {
  font-size: 24rpx;
}

.dp-val {
  font-size: 24rpx;
  color: #5A4636;
}

.remark-input {
  flex: 1;
  background: #FDF7F8;
  border: 1rpx solid #F5EEF0;
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  color: #5A4636;
}

/* 提交按钮 */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B8B 0%, #F48FB1 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 28rpx;
  width: 100%;
  height: 84rpx;
  line-height: 1;
  padding: 0;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.4);
  border: none;
}

.submit-btn::after {
  border: none;
}
