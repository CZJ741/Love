/* app.wxss —— 全局主题：七色马卡龙，甜蜜浪漫 */
page {
  background: #FFEBED;
  color: #5A4636;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Helvetica Neue', sans-serif;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
}

.page {
  width: 100%;
  padding: 24rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(244, 143, 177, 0.08);
  box-sizing: border-box;
  overflow: hidden;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #5A4636;
  margin-bottom: 18rpx;
}
.card-title .emoji { margin-right: 10rpx; }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F48FB1, #FFCC80);
  color: #FFF;
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
  box-shadow: 0 6rpx 16rpx rgba(244, 143, 177, 0.35);
  transition: transform 0.12s ease, box-shadow 0.12s ease, opacity 0.12s ease;
}
.btn::after { border: none; }

/* 按钮点击反馈：微微缩小 + 阴影加深 */
.btn:active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 6rpx rgba(244, 143, 177, 0.25);
  opacity: 0.85;
}

.btn.secondary { background: #FFF; color: #F48FB1; border: 2rpx solid #B39DDB; box-shadow: none; }
.btn.secondary:active { background: #FFEBED; border-color: #F48FB1; }

.btn.ghost { background: #FFEBED; color: #F48FB1; box-shadow: none; }
.btn.ghost:active { background: #FFCC80; }

.btn.mini { padding: 12rpx 28rpx; font-size: 26rpx; display: inline-flex; }
.btn:disabled { opacity: .5; box-shadow: none; transform: none; }
.btn.submit-btn { margin-top: 34rpx; width: 100%; box-sizing: border-box; }

.btn.danger-btn { background: #FFF; color: #E74C3C; border: 2rpx solid #F5B7B1; box-shadow: none; }
.btn.danger-btn:active { background: #FDEDEC; border-color: #E74C3C; }

/* 数字等宽，滚动更清晰 */
.num {
  font-family: 'DIN Alternate', 'Bahnschrift', 'Helvetica Neue', monospace;
  font-variant-numeric: tabular-nums;
}

.pos { color: #F48FB1; }
.neg { color: #7CB342; }

/* 输入框 —— 高度充足，保证文字清晰完整显示 */
.input-box {
  background: #FFEBED;
  border: 2rpx solid #FFCC80;
  border-radius: 20rpx;
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #5A4636;
  width: 100%;
  box-sizing: border-box;
}

/* 标签 chip */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #FFEBED;
  border: 2rpx solid #FFCC80;
  color: #8A6A58;
  font-size: 26rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip.active {
  background: #F48FB1;
  border-color: #F48FB1;
  color: #FFF;
  font-weight: 600;
}
.chip:active {
  transform: scale(0.93);
  opacity: 0.75;
}

.empty {
  text-align: center;
  color: #C9B3A3;
  font-size: 26rpx;
  padding: 40rpx 0;
}
.empty .e-emoji { font-size: 60rpx; display: block; margin-bottom: 12rpx; }

/* 弹层 */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(90, 70, 54, 0.45);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 640rpx;
  max-width: 90vw;
  max-height: 78vh;
  overflow-y: auto;
  background: #FFF;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(90, 70, 54, 0.25);
  box-sizing: border-box;
}
.modal-title { font-size: 32rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; color: #5A4636; }

.section-label { font-size: 26rpx; color: #B39B8A; margin: 20rpx 0 10rpx; }

.tip-line { font-size: 22rpx; color: #C9B3A3; margin-top: 10rpx; }

/* ====== 安全区域适配 ====== */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
